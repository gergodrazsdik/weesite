# Inputs for infra/bootstrap. Copy to bootstrap.auto.tfvars (gitignored)
# and fill in your own values; never commit the copy.

# Azure subscription to deploy into (az account show --query id -o tsv).
subscription_id = "00000000-0000-0000-0000-000000000000"

# Region for the state storage, Key Vault and identities; must be listed in
# policy/data/policy.yaml.
location = "westeurope"

# Region for the test and prod resource groups and everything in them (optional,
# defaults to location). Each environment runs a Container Apps environment, and
# a subscription may have only a few per region: check Portal, Quotas, Container
# Apps for room for two.
# environment_location = "westeurope"

# 3-6 lowercase letters or digits that make the storage account and Key
# Vault names globally unique. Pick once: changing it replaces both.
name_suffix = "abc123"

# Only for a second install in a subscription or a tenant that already has
# one: names its resource groups rg-weesite-<instance>-<env>, its identities
# and the rest, so nothing clashes (some names are tenant-wide). Leave it empty otherwise. Pick once: changing it
# re-creates everything. Use a different name_suffix too.
# instance = "second"

# Your fork: https://github.com/<github_owner>/<github_repository>
github_owner      = "example-owner"
github_repository = "weesite"

# GitHub logins that approve prod deployments.
prod_reviewers = ["example-owner"]

# Monthly budget per environment resource group, and who gets the alerts.
budget_amount         = 30
budget_contact_emails = ["owner@example.com"]

# The site's own domain for prod (optional). infra/app creates its Azure DNS
# zone; point the domain's name servers at it (docs/deploy.md).
# prod_domain = "example.com"

# Extra GitHub environment variables for your own workflows (optional);
# Weesite's workflows don't read any.
# environment_variables = {
#   test = { MY_VARIABLE = "value" }
#   prod = { MY_VARIABLE = "value" }
# }
