{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "api.nuget.org",
        "*.nuget.org",
        "crl3.digicert.com",
        "ocsp.digicert.com",
        "dot.net",
        "builds.dotnet.microsoft.com",
        "ci.dot.net",
        "registry.opentofu.org",
        "get.opentofu.org",
        "mcr.microsoft.com",
        "*.data.mcr.microsoft.com"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.auto.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.auto.tfvars)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.*)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/secrets/**)"
    ]
  }
}
