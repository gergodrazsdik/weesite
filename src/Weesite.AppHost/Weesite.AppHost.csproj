<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local development only (`aspire run`): deployment is OpenTofu and GitHub Actions.
  Azurite, the web app and the re-index job.
  Aspire 17: a C# AppHost is a plain Microsoft.NET.Sdk project with these packages (the
  Aspire.AppHost.Sdk is obsolete, ASPIRE012). It registers the web project by path
  (AddDotnetProject), so it has no ProjectReference to it, and `aspire run` builds the web app
  before starting it. Its build needs the Aspire CLI bundle (DCP and the dashboard, ASPIRE013):
  from a compatible `aspire` on PATH, otherwise from the Aspire.Cli package of the same version
  as Aspire.Hosting.AppHost, which the build restores from nuget.org and runs with `dnx`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>

</Project>
