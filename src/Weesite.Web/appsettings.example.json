// Every setting the Weesite web app reads, with its default and what it does. A reference: this file
// isn't loaded and isn't in the container image. Don't copy it whole into appsettings.json; set only
// what you change.
//
// Where a setting comes from (later ones win):
//   1. appsettings.json, then appsettings.{Environment}.json (Development locally).
//   2. Environment variables: ":" becomes "__", as in Search__EmbedLimit=300. In Azure,
//      infra/app sets them on the Container App: its own ones, plus each environment's extra
//      settings from the repository variable APP_SETTINGS_TEST or APP_SETTINGS_PROD.
//   3. The environment's Key Vault, for secrets: a secret named with "--" for ":", as in
//      Authentication--Google--ClientSecret. Read at startup, so restart the app after a change.
//   Locally, user secrets (dotnet user-secrets) for the web project sit between 1 and 2.
// docs/deploy.md ("App settings") has the details and examples.
{
  "Logging": {
    "LogLevel": {
      // ASP.NET Core's log levels. The Azure SDK logs each storage request at Information,
      // about 15 lines each, so it stays at Warning, and Azure.Core at Error (F-0047).
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning",
      "Azure.Core": "Error"
    }
  },

  // Where the app's data lives. In Azure, infra/app sets these to the storage account's endpoints
  // (the managed identity signs in); Aspire sets them to Azurite. Not set: content comes from
  // Content:Path instead (tests).
  "ConnectionStrings": {
    "blobs": "https://<account>.blob.core.windows.net/",
    "tables": "https://<account>.table.core.windows.net/",
    "queues": "https://<account>.queue.core.windows.net/"
  },

  "Content": {
    // A directory with content/, settings/ and media/ to serve instead of Blob Storage, as the
    // tests do with seed/. Editors, audit log and page views are then kept in memory.
    "Path": "",
    // How often each replica checks the version marker and reloads changed content, in seconds.
    // 0 turns reloading off.
    "ReloadSeconds": 30
  },

  "Seed": {
    // A directory (such as seed/) whose content, settings and media are copied into Blob Storage
    // at startup where they're missing. Test sets it to the sample site in the image; prod doesn't.
    "Path": ""
  },

  "Site": {
    // The canonical origin for absolute links (canonical tags, Open Graph, feeds, sitemap), such
    // as https://example.com; requests for www.example.com redirect to it. Empty: the address each
    // request came in on. infra/app sets it in an environment with its own domain (prod).
    "BaseUrl": "",
    // true sends X-Robots-Tag: noindex and a robots.txt that blocks crawlers. infra/app sets it on
    // test.
    "NoIndex": false,
    // Admins who can always sign in, comma- or semicolon-separated email addresses. Keep it out of
    // the repository: `just site-admins <env>` stores it in the environment's Key Vault
    // (Site--Admins).
    "Admins": ""
  },

  // Sign-in for the editor (ADR 0004). A provider without both values stays off. The client IDs
  // and secrets live in the environment's Key Vault (infra/app writes Microsoft's,
  // `just google-signin <env>` Google's); locally, in user secrets.
  "Authentication": {
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": "",
      // Work or school tenants (IDs, comma-separated) whose users' email addresses are trusted.
      // Personal Microsoft accounts always are.
      "TrustedTenants": ""
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "KeyVault": {
    // The environment's Key Vault, loaded into these settings at startup (infra/app sets it).
    "Uri": ""
  },

  "DataProtection": {
    // The Key Vault key that wraps the Data Protection keys (sign-in cookies, form tokens). Empty:
    // they're stored unwrapped. infra/app sets it.
    "KeyId": ""
  },

  "Search": {
    // The embedding model (ADR 0008): bge-small-en-v1.5 (empty, the default; English) or
    // multilingual-e5-small (about a hundred languages; larger, needs more memory). Switching
    // re-embeds everything. The image has both.
    "EmbeddingModel": "",
    // The model's directory. Empty: Models/<EmbeddingModel> next to the app, where the image has
    // it. Without a model, search uses keywords only.
    "ModelPath": "",
    // How close in meaning (0 to 1) a section must be to count as a hit. Each model has its own
    // default: 0.6 for bge-small-en-v1.5 (shown), 0.8 for multilingual-e5-small.
    "MinSimilarity": 0.6,
    // How far above the median similarity of all posts and pages, for that query, a hit must be:
    // bge rates unrelated text 0.5 to 0.66, but what a query is about stands out. Lower it if
    // search by meaning misses posts; raise it if it finds unrelated ones. 0 turns it off. Each
    // model has its own default: 0.115 for bge (shown), 0.07 for e5, which rates any two texts
    // 0.75 to 0.9.
    "MinLead": 0.115,
    // The most sections a web replica embeds per index build; more, as after a model change, are
    // left to the re-index job, which a replica then asks for.
    "EmbedLimit": 200
  },

  // Requests per minute per client address. Over the limit: 429 with Retry-After. 0 turns a limit
  // off.
  "RateLimits": {
    "SearchPerMinute": 30,
    "McpPerMinute": 60,
    // The editor MCP endpoint, for requests with a bearer token (apps an editor allowed).
    "McpEditorPerMinute": 300,
    "SignInPerMinute": 10,
    // The authorization server for the editor MCP endpoint: registration, tokens, consent.
    "OAuthPerMinute": 30
  },

  "Analytics": {
    // false stops counting page views (the analytics page then shows what was counted before).
    "Enabled": true
  },

  "Telemetry": {
    // The share of requests and their traces sent to Application Insights (0 to 1).
    "SamplingRatio": 0.25
  },

  // Application Insights. infra/app sets it from the environment's Key Vault; empty: no export.
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",

  // An OpenTelemetry collector to send logs, traces and metrics to (Aspire's dashboard sets it).
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",

  "AllowedHosts": "*"
}
