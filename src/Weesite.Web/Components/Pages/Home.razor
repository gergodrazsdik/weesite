@page "/"
@inject ContentCatalogProvider Content
@inject IStringLocalizer<PublicResource> T

<PageTitle>@Title</PageTitle>
<PageMeta Title="@Title" Item="HomePage" IsHome="true" ImagePreloads="BannerPreloads" />

@* The home page (ADR 0006): the banner and the site's name, then a page, the latest posts or both. *@
@if (Banner != "none")
{
    <div class="banner-wrap">
        @if (Banner is { } image)
        {
            <img class="banner" src="@image" alt="" fetchpriority="high" />
        }
        else
        {
            <div class="banner banner-default"></div>
        }
        <span class="@(Photo is null ? "avatar" : "avatar photo")"><img src="@(Photo ?? SiteLogo.Mark(Site, "/" + Assets["icons/logo.svg"]))" alt="" width="92" height="92" /></span>
    </div>
}
<section class="hero @(Banner == "none" ? "no-banner" : null)" aria-labelledby="site-title">
    <div>
        <h1 id="site-title">@Site.Name</h1>
        @if (Site.Tagline is { } tagline)
        {
            <p class="tagline">@tagline</p>
        }
    </div>
    <div class="links">
        @foreach (var link in Links)
        {
            <a class="btn mono" href="@link.Address" rel="me noopener" target="_blank">@link.Label <span aria-hidden="true">↗</span><span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a>
        }
        <a class="btn mono" href="/feed.xml" type="application/atom+xml" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>@T["Feed"]<span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a>
    </div>
</section>

@if (HomePage is { } item)
{
    <article class="content home-page" aria-labelledby="home-page-title" lang="@SiteCulture.LangOf(item, Content.Current.Site)">
        <h2 id="home-page-title">@item.Title</h2>
        @((MarkupString)item.Html)
    </article>
}

@if (ShowPosts)
{
    <div class="columns">
        <section class="main" aria-labelledby="latest-posts">
            <div class="list-head">
                <h2 id="latest-posts" class="label">@T["LatestPosts"]</h2>
                <span class="count">@T["PostCount", Content.Current.Posts.Count]</span>
            </div>
            <PostRows Posts="Latest" />
            <div class="list-foot">
                <a href="/blog">@T["AllPostsByYear"] <span aria-hidden="true">→</span></a>
                <span>@string.Join(" · ", Years)</span>
            </div>
        </section>
        <aside aria-label="@T["Sidebar"]">
            <TagSidebar Heading="@T["Tags"]" Limit="10" />
            <SubscribeBox Text="@T["SubscribeSite"]" />
        </aside>
    </div>
}

@code {
    private SiteSettings Site => Content.Current.Site;

    // "Home title · Site" as every other page's title (F-0121); without one, the home page's page,
    // or the site's name alone.
    private string Title => (Site.HomeTitle ?? HomePage?.Title) is { } title ? $"{title} · {Site.Name}" : Site.Name;

    // home.show: latest-posts (default), page, or page-and-posts.
    private ContentItem? HomePage =>
        Site.Home.Show is "page" or "page-and-posts" && Site.Home.Page is { } slug ? Content.Current.FindPage(slug) : null;

    private bool ShowPosts => HomePage is null || Site.Home.Show == "page-and-posts";

    private IReadOnlyList<ContentItem> Latest => [.. Content.Current.Posts.Take(10)];

    private IEnumerable<string> Years =>
        Content.Current.Posts.Select(p => p.Date?.Year).OfType<int>().Distinct().Select(y => y.ToString(System.Globalization.CultureInfo.InvariantCulture));

    // banner: empty for the built-in drawing, "none", or a media image.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The built-in drawing is the page's largest paint: PageMeta starts loading it with the HTML
    // rather than once site.css is parsed (T-0056). The same addresses as site.css: the visitor's
    // theme when they picked one, both by the system's colour scheme otherwise, narrow and wide.
    private IEnumerable<(string Href, string Media)> BannerPreloads => Banner is not null ? [] :
        (Weesite.Web.Theming.ThemePreference.Read(HttpContext) switch
        {
            "light" => new[] { ("light", "") },
            "dark" => new[] { ("dark", "") },
            _ => new[] { ("light", " and (prefers-color-scheme: light)"), ("dark", " and (prefers-color-scheme: dark)") },
        }).SelectMany(theme => new[]
        {
            ($"/images/banner-{theme.Item1}-narrow.webp", "(max-width: 40rem)" + theme.Item2),
            ($"/images/banner-{theme.Item1}.webp", "(min-width: 40.0625rem)" + theme.Item2),
        });

    private string? Banner => Site.Banner is { Length: > 0 } b && (b == "none" || b.StartsWith("/media/", StringComparison.Ordinal)) ? b : null;

    // The home page photo (T-0117), as its smallest resized copy when there is one: the frame is
    // 92 px. Null without a photo, or when the image is gone from Media.
    private string? Photo => Site.HomePhoto is { } path && path.StartsWith("/media/", StringComparison.Ordinal)
        && Content.Current.Media.Find(path["/media/".Length..]) is { } info
            ? info.Variants.Count > 0 ? "/media/" + info.Variants[0].Name : path
            : null;

    private IReadOnlyList<SiteLink> Links =>
        (Site.Links.Count > 0 ? Site.Links : Site.Authors.FirstOrDefault()?.Links ?? []).Where(l => l.Address is not null).ToList();
}
