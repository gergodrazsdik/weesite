@page "/blog/tags/{Name}"
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

@if (Posts is { } posts)
{
    <PageTitle>@T["TaggedPosts", Name] · @Content.Current.Site.Name</PageTitle>
    <PageMeta Title="@T["TaggedPosts", Name]" />

    <h1>@T["TaggedPosts", Name]</h1>
    <PostList Posts="posts" HeadingLevel="2" />
    <p><a href="/blog/tags">@T["AllTags"]</a></p>
}

@code {
    /// <summary>Gets or sets the tag.</summary>
    [Parameter]
    public string Name { get; set; } = "";

    private IReadOnlyList<ContentItem>? Posts { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Posts = Content.Current.Tags.GetValueOrDefault(Name);
        if (Posts is null)
        {
            Navigation.NotFound();
        }
    }
}
