@page "/blog/tags/{Name}"
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

@if (Posts is { } posts)
{
    <PageTitle>@T["TaggedPosts", Name] · @Content.Current.Site.Name</PageTitle>
    <PageMeta Title="@T["TaggedPosts", Name]" Tag="@Name" />

    <nav class="crumbs" aria-label="@T["Breadcrumbs"]"><a href="/blog">blog</a> / <a href="/blog/tags">tags</a> / <span aria-current="page">@Name</span></nav>
    <h1 class="page-title">@T["PostsTaggedPrefix"] <span class="@($"tag big {TagColours.ClassOf(Content.Current.Site, Name)}".TrimEnd())">#@Name</span></h1>
    <p class="lede">@Lede(posts.Count)</p>
    <div class="columns">
        <section class="main" aria-label="@T["PostsLabel"]">
            <PostRows Posts="posts" />
            <p class="list-foot">
                <span><a href="/blog/tags">@T["AllTags"]</a> · @T["SubscribeTo", Name] <a href="/blog/tags/@Name/feed.xml">Atom</a>, <a href="/blog/tags/@Name/feed.json">JSON Feed</a></span>
            </p>
        </section>
        <aside aria-label="@T["Sidebar"]">
            <SubscribeBox Text="@T["SubscribeTag", Name]" FeedBase="@($"/blog/tags/{Name}/feed")" />
            <TagSidebar Heading="@T["OtherTags"]" Limit="8" Except="@Name" />
        </aside>
    </div>
}

@code {
    /// <summary>Gets or sets the tag.</summary>
    [Parameter]
    public string Name { get; set; } = "";

    private IReadOnlyList<ContentItem>? Posts { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Posts = Content.Current.Tags.GetValueOrDefault(Name);
        if (Posts is null)
        {
            Navigation.NotFound();
        }
    }

    // "3 posts about web pages: …", or just the count.
    private string Lede(int count)
    {
        var posts = count == 1 ? T["PostCountOne"].Value : T["PostCount", count].Value;
        return Content.Current.Site.DescriptionOf(Name) is { } about ? T["PostsAbout", posts, about] : posts + ".";
    }
}
