@page "/blog/{Slug}"
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject Weesite.Search.SearchIndexProvider Search

@* A post (ADR 0006): the page body is PostArticle; this finds the post, its related posts, the
contents and the older and newer posts. *@
@if (Item is { } post)
{
    <PageTitle>@post.Title · @Content.Current.Site.Name</PageTitle>
    <PageMeta Title="@post.Title" Item="post" />

    <PostArticle Item="post" Contents="Contents" Related="Related" Older="Older" Newer="Newer" />
    <script type="module" src="/@Assets["copy-code.js"]"></script>
    @if (Contents.Count >= 2)
    {
        <script type="module" src="/@Assets["post-contents.js"]"></script>
    }
}

@code {
    /// <summary>Gets or sets the post's slug.</summary>
    [Parameter]
    public string Slug { get; set; } = "";

    private ContentItem? Item { get; set; }

    private IReadOnlyList<ContentItem> Related { get; set; } = [];

    private IReadOnlyList<(string Id, string Text)> Contents { get; set; } = [];

    private ContentItem? Older { get; set; }

    private ContentItem? Newer { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Item = Content.Current.FindPost(Slug);
        if (Item is null)
        {
            Navigation.NotFound();
            return;
        }

        Related = Search.Current.Related(Item);
        Contents = PostContents.Headings(Item.Html);

        // Posts are newest first: the next one is older, the previous one newer.
        var posts = Content.Current.Posts;
        var index = posts.ToList().FindIndex(p => ReferenceEquals(p, Item));
        Older = index >= 0 && index + 1 < posts.Count ? posts[index + 1] : null;
        Newer = index > 0 ? posts[index - 1] : null;
    }
}
