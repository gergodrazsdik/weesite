@page "/admin/messages"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@using Weesite.Web.Visitors
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject IMessageStore Store
@inject ContentCatalogProvider Content
@inject IStringLocalizer<AdminResource> T

<PageTitle>@T["MessagesTitle"]</PageTitle>

@* The contact form's messages (ADR 0011), newest first: admins only. Opening one marks it read.
Messages never reach an app through MCP. *@
<div class="admin-head">
    <AdminTitle Text="@T["MessagesTitle"]">@T["MessagesIntro", MessageCleanUp.RetentionMonths]</AdminTitle>
    <RefreshLink Href="@Paging.With("/admin/messages", CurrentPage)" />
</div>
@if (Content.Current.Site.ContactForm is not { IsOn: true })
{
    <p class="help">@T["MessagesFormOff"] <a href="/admin/settings">@T["SettingsTitle"]</a>.</p>
}

@if (Deleted == "1")
{
    <p class="notice" role="status">@T["MessageDeleted"]</p>
}
else if (Gone == "1")
{
    <p class="notice" role="alert">@T["MessageGone"]</p>
}
else if (DeletedRead is { } count)
{
    <p class="notice" role="status">@(count == "1" ? T["MessagesDeletedReadOne"] : T["MessagesDeletedRead", count])</p>
}

@if (Page.Total == 0)
{
    <p class="notice">@T["NoMessages"]</p>
}
else
{
    <div class="table-scroll messages" tabindex="0" role="region" aria-labelledby="messages-caption">
        <table class="data">
            <caption id="messages-caption" class="visually-hidden">@T["MessagesCaption", Page.Total, Unread]</caption>
            <thead>
                <tr>
                    <th scope="col">@T["When"]</th>
                    <th scope="col">@T["MessageFrom"]</th>
                    <th scope="col">@T["MessageText"]</th>
                    <th scope="col">@T["Status"]</th>
                    <th scope="col"><span class="visually-hidden">@T["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var message in Page.Messages)
                {
                    @* The whole row opens the message: the name's link covers it (admin.css), so
                    there's still one link per row for keyboards and screen readers (T-0157). *@
                    <tr class="@(message.Read ? "message-row" : "message-row unread")">
                        <td class="date"><time datetime="@message.Received.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@Content.Current.Site.FormatTime(seconds: true, at: message.Received)</time></td>
                        <td>
                            <a class="row-link" href="/admin/messages/view?id=@message.Id">@message.Name</a>
                            <span class="muted">@message.Email</span>
                        </td>
                        <td class="excerpt">@Excerpt(message.Text)</td>
                        <td>
                            @if (!message.Read)
                            {
                                <span class="pill new">@T["MessageNew"]</span>
                            }
                            @if (message.Unverified)
                            {
                                <span class="pill unverified" title="@T["MessageUnverifiedHelp"]">@T["MessageUnverified"]</span>
                            }
                        </td>
                        <td class="row-actions">
                            <form method="post" action="/admin/messages/delete" data-confirm="@T["MessageDeleteConfirm", message.Name]" data-confirm-button="@T["MessageDelete"]">
                                <AntiforgeryToken />
                                <input type="hidden" name="id" value="@message.Id" />
                                <button class="btn danger small" type="submit">@T["MessageDelete"]<span class="visually-hidden">@(" " + T["MessageDeleteWhose", message.Name])</span></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <AdminPager Total="Page.Total" PageSize="PageSize" Current="CurrentPage" Href="@(page => Paging.With("/admin/messages", page))" />
    <form class="form-actions" method="post" action="/admin/messages/delete-read" data-confirm="@T["MessagesDeleteReadConfirm"]" data-confirm-button="@T["MessagesDeleteRead"]">
        <AntiforgeryToken />
        <input type="hidden" name="scope" value="read" />
        <button class="btn danger" type="submit">@T["MessagesDeleteRead"]</button>
    </form>
}

@code {
    private const int PageSize = 50;

    /// <summary>Gets or sets the page, from 1.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageParameter { get; set; }

    /// <summary>Gets or sets whether a message was just deleted.</summary>
    [SupplyParameterFromQuery(Name = "deleted")]
    public string? Deleted { get; set; }

    /// <summary>Gets or sets whether a message to delete was gone already.</summary>
    [SupplyParameterFromQuery(Name = "gone")]
    public string? Gone { get; set; }

    /// <summary>Gets or sets how many read messages were just deleted.</summary>
    [SupplyParameterFromQuery(Name = "deletedRead")]
    public string? DeletedRead { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private MessagePage Page { get; set; } = new([], 0, 0);

    private int CurrentPage { get; set; } = 1;

    private int Unread { get; set; }

    /// <summary>The message on one line, cut at 120 characters, never inside a character (F-0216).</summary>
    /// <param name="text">The message.</param>
    /// <returns>The excerpt.</returns>
    internal static string Excerpt(string text)
    {
        var line = string.Join(' ', text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        if (line.Length <= 120)
        {
            return line;
        }

        var cut = char.IsLowSurrogate(line[119]) ? 118 : 119;
        return line[..cut].TrimEnd() + "…";
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // Only the page shown is read whole (F-0225): the page asked for, then the last one if
        // that's past the end.
        var cancel = HttpContext?.RequestAborted ?? CancellationToken.None;
        var asked = Paging.Current(PageParameter, int.MaxValue / 2, PageSize);
        Page = await Store.ListAsync((asked - 1) * PageSize, PageSize, cancel);
        CurrentPage = Paging.Current(PageParameter, Page.Total, PageSize);
        if (CurrentPage != asked)
        {
            Page = await Store.ListAsync((CurrentPage - 1) * PageSize, PageSize, cancel);
        }

        Unread = Page.Unread;
    }
}
