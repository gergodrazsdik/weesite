@page "/admin/diff"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Content.Sources
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.EditorPolicy)]
@inject ContentEditor Editor
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResource> T

@* One version against another (T-0083), the current text unless another is chosen (F-0141):
removed lines, then added ones, in place; links step to the save before and the one after (F-0140). *@
<PageTitle>@T["DiffTitle"]</PageTitle>

@if (Lines is not null || TooLong)
{
    <div class="admin-head">
        <h1>@T["DiffTitle"]</h1>
        <a class="btn" href="/admin/edit?path=@Uri.EscapeDataString(ItemPath!)">@T["BackToEditor"]</a>
        <a class="btn primary" href="/admin/edit?path=@Uri.EscapeDataString(ItemPath!)&version=@Uri.EscapeDataString(Version!)">@T["RestoreThisVersion"]</a>
    </div>
    <p class="admin-intro">@T["DiffIntro", Title, FromLabel, ToLabel]</p>
    @* Any two versions (F-0141): a form that works without scripts. *@
    <form class="diff-pick" method="get" action="/admin/diff">
        <input type="hidden" name="path" value="@ItemPath" />
        @if (ChangesOnly)
        {
            <input type="hidden" name="changes" value="only" />
        }
        <div class="field">
            <label for="diff-from">@T["DiffFrom"]</label>
            <select id="diff-from" name="version">
                @foreach (var revision in Revisions.Where(r => !r.IsCurrent))
                {
                    <option value="@revision.VersionId" selected="@(revision.VersionId == Version)">@Stamp(revision.SavedAt)</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="diff-to">@T["DiffTo"]</label>
            <select id="diff-to" name="to">
                @foreach (var revision in Revisions)
                {
                    <option value="@(revision.IsCurrent ? "" : revision.VersionId)" selected="@(revision.IsCurrent ? To is null : revision.VersionId == To)">@(revision.IsCurrent ? T["DiffCurrentOption", Stamp(revision.SavedAt)] : Stamp(revision.SavedAt))</option>
                }
            </select>
        </div>
        <button type="submit" class="btn">@T["DiffCompare"]</button>
    </form>
    @if (Earlier is not null || Later is not null)
    {
        <nav class="pager diff-steps" aria-label="@T["DiffSteps"]">
            @if (Earlier is { } earlier)
            {
                <a href="@earlier" rel="prev"><span aria-hidden="true">← </span>@T["DiffEarlierChange"]</a>
            }
            @if (Later is { } later)
            {
                <a class="newer" href="@later" rel="next">@T["DiffLaterChange"]<span aria-hidden="true"> →</span></a>
            }
        </nav>
    }
    @if (TooLong)
    {
        <p class="notice">@T["DiffTooLong", LineDiff.MaxLines]</p>
    }
    else if (Lines!.All(l => l.Kind == DiffKind.Same))
    {
        <p class="notice">@T["DiffSame"]</p>
    }
    else
    {
        @* All lines, or only the changed ones with a few around each (F-0126): links, so it works
        without scripts and the choice is in the address. *@
        <nav class="tabs diff-show" aria-label="@T["DiffShow"]">
            <a href="@ShowLink(false)" aria-current="@(ChangesOnly ? null : "page")">@T["DiffAllLines"]</a>
            <a href="@ShowLink(true)" aria-current="@(ChangesOnly ? "page" : null)">@T["DiffChangesOnly", Context]</a>
        </nav>
        <p class="diff-key"><span class="removed">@T["DiffRemovedKey", FromLabel]</span> <span class="added">@T["DiffAddedKey", ToLabel]</span></p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="@T["DiffTitle"]">
            <ol class="diff" role="list">
                @foreach (var line in Shown)
                {
                    if (line is null)
                    {
                        <li class="gap"><span aria-hidden="true" class="sign"> </span><span>@T["DiffGap"]</span></li>
                        continue;
                    }

                    <li class="@line.Kind.ToString().ToLowerInvariant()">
                        <span class="visually-hidden">@(line.Kind switch { DiffKind.Removed => T["DiffRemoved"], DiffKind.Added => T["DiffAdded"], _ => "" })</span>
                        <span aria-hidden="true" class="sign">@(line.Kind switch { DiffKind.Removed => "−", DiffKind.Added => "+", _ => " " })</span>
                        <code>@line.Text</code>
                    </li>
                }
            </ol>
        </div>
    }
}

@code {
    /// <summary>Gets or sets the item's path.</summary>
    [SupplyParameterFromQuery(Name = "path")]
    public string? ItemPath { get; set; }

    /// <summary>Gets or sets the earlier version.</summary>
    [SupplyParameterFromQuery(Name = "version")]
    public string? Version { get; set; }

    /// <summary>Gets or sets the version to compare it with; empty for the current text (F-0141).</summary>
    [SupplyParameterFromQuery(Name = "to")]
    public string? To { get; set; }

    /// <summary>Gets or sets whether only the changed lines and those around them show (F-0126).</summary>
    [SupplyParameterFromQuery(Name = "changes")]
    public string? Changes { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The unchanged lines shown around each change.
    private const int Context = 4;

    private bool ChangesOnly => Changes == "only";

    private IEnumerable<DiffLine?> Shown => ChangesOnly ? LineDiff.Around(Lines!, Context) : Lines!;

    private string ShowLink(bool changesOnly) => Link(Version!, To, changesOnly);

    private string Link(string from, string? to, bool changesOnly) =>
        $"/admin/diff?path={Uri.EscapeDataString(ItemPath!)}&version={Uri.EscapeDataString(from)}{(to is null ? "" : "&to=" + Uri.EscapeDataString(to))}{(changesOnly ? "&changes=only" : "")}";

    private IReadOnlyList<Revision> Revisions { get; set; } = [];

    private string FromLabel { get; set; } = "";

    private string ToLabel { get; set; } = "";

    // What the save before the first version changed, and what the save after the second changed
    // (F-0140); the current text is "to" without a version.
    private string? Earlier { get; set; }

    private string? Later { get; set; }

    private static string Stamp(DateTimeOffset at) => ContentDates.UtcSeconds(at);

    private IReadOnlyList<DiffLine>? Lines { get; set; }

    private bool TooLong { get; set; }

    private string Title { get; set; } = "";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var cancel = HttpContext?.RequestAborted ?? CancellationToken.None;
        if (ItemPath is null || Version is null || await Editor.OpenAsync(ItemPath, cancel) is not { } current)
        {
            Navigation.NotFound();
            return;
        }

        if (!EditorRights.CanEdit(HttpContext!.User, current.Draft.Kind, current.Draft.AuthorId, isNew: false))
        {
            Navigation.NavigateTo("/admin/forbidden");
            return;
        }

        To = string.IsNullOrEmpty(To) ? null : To;
        Revisions = await Editor.RevisionsAsync(ItemPath, cancel);
        if (Revisions.FirstOrDefault(r => r.IsCurrent) is { } now && now.VersionId == To)
        {
            To = null;
        }

        if (await Editor.OpenRevisionAsync(ItemPath, Version, cancel) is not { } earlier
            || (To is not null ? await Editor.OpenRevisionAsync(ItemPath, To, cancel) : current.Draft) is not { } later)
        {
            Navigation.NotFound();
            return;
        }

        Title = current.Draft.Title;
        Lines = LineDiff.Compare(earlier.ToMarkdown(), later.ToMarkdown());
        TooLong = Lines is null;

        // Newest first: the one after an entry in the list is the save before it.
        var from = Revisions.ToList().FindIndex(r => r.VersionId == Version);
        var to = To is null ? Revisions.ToList().FindIndex(r => r.IsCurrent) : Revisions.ToList().FindIndex(r => r.VersionId == To);
        FromLabel = from >= 0 ? Stamp(Revisions[from].SavedAt) : Version;
        ToLabel = To is null ? T["DiffCurrentText"] : to >= 0 ? Stamp(Revisions[to].SavedAt) : To;
        if (from >= 0 && from + 1 < Revisions.Count)
        {
            Earlier = Link(Revisions[from + 1].VersionId, Revisions[from].IsCurrent ? null : Revisions[from].VersionId, ChangesOnly);
        }

        if (to > 0)
        {
            Later = Link(Revisions[to].VersionId, Revisions[to - 1].IsCurrent ? null : Revisions[to - 1].VersionId, ChangesOnly);
        }
    }
}
