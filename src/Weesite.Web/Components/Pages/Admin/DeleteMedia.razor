@page "/admin/media/delete"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Content.Media
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject MediaLibrary Library
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

@* Deleting a media file for good (T-0110), admins only: a warning when posts or pages still use it
(T-0112), then the file's name typed as confirmation. Posts to /admin/media/delete (Deletion.cs). *@
<PageTitle>@T["DeleteMediaTitle", Name ?? ""]</PageTitle>

@if (Found)
{
    <div class="admin-head">
        <h1>@T["DeleteMediaTitle", Name!]</h1>
    </div>
    <section class="section form danger-zone" aria-labelledby="delete-heading">
        <h2 id="delete-heading">@T["DangerZoneHeading"]</h2>
        @if (Error == "confirm")
        {
            <p class="notice" role="alert">@T["DeleteNotConfirmed"]</p>
        }
        else if (Error == "changed")
        {
            <p class="notice" role="alert">@T["DeleteMediaGone"]</p>
        }
        @if (Uses.Count > 0)
        {
            <div class="notice warning" role="alert">
                <p>@T["MediaStillUsed", Uses.Count]</p>
                <ul>
                    @foreach (var use in Uses)
                    {
                        <li><a href="/admin/edit?path=@Uri.EscapeDataString(use.SourcePath)">@use.Title</a></li>
                    }
                </ul>
            </div>
        }
        <p>@T["DeleteMediaWhat"]</p>
        <p class="help">@T["DeleteRecovery"]</p>
        <form method="post" action="/admin/media/delete">
            <AntiforgeryToken />
            <input type="hidden" name="name" value="@Name" />
            <div class="field">
                <label for="delete-confirm">@T["DeleteMediaConfirmLabel", Name!]</label>
                <input id="delete-confirm" name="confirm" type="text" autocomplete="off" spellcheck="false" required aria-describedby="delete-confirm-help" />
                <p id="delete-confirm-help" class="help">@T["ResetConfirmHelp"]</p>
            </div>
            <div class="form-actions">
                <a class="btn" href="/admin/media">@T["Cancel"]</a>
                <button class="btn danger" type="submit">@T["DeletePermanently"]</button>
            </div>
        </form>
    </section>
}

@code {
    /// <summary>Gets or sets the file's name.</summary>
    [SupplyParameterFromQuery(Name = "name")]
    public string? Name { get; set; }

    /// <summary>Gets or sets why the last attempt didn't delete: <c>confirm</c> or <c>changed</c>.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool Found { get; set; }

    private IReadOnlyList<ContentItem> Uses { get; set; } = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var files = await Library.ListAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        if (Name is null || !files.Any(f => f.Name == Name))
        {
            Navigation.NotFound();
            return;
        }

        Found = true;
        Uses = Content.Current.ActiveUsesOf(Name);
    }
}
