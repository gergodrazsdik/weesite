@page "/admin/profile"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.EditorPolicy)]
@inject AuthorProfiles Profiles
@inject Weesite.Web.Agents.OAuth.OAuthTokens Tokens
@inject NavigationManager Navigation
@inject IAuditLog Audit
@inject TimeProvider Time
@inject IStringLocalizer<AdminResource> T

@* The signed-in editor's byline (ADR 0005): shown on their posts, in feeds and in JSON-LD. *@
<PageTitle>@T["ProfileTitle"]</PageTitle>

<div class="admin-head">
    <h1>@T["ProfileTitle"]</h1>
</div>
<p class="admin-intro">@T["ProfileIntro"]</p>

@if (Message is { } message)
{
    <FormNotice Message="@message" IsError="IsError" FieldId="@Form?.ErrorField?.Id" />
}

@if (Form is not null)
{
    <EditForm Model="Form" FormName="profile" OnSubmit="SaveAsync" method="post" class="form" Context="editContext">
        @{ FieldError.Mark(editContext, Form, IsError ? Form.ErrorField : null, Message); }
        <div class="field">
            <label for="name">@T["ProfileName"]</label>
            <InputText id="name" @bind-Value="Form.Name" required maxlength="80" autocomplete="name" />
        </div>
        <div class="field">
            <label for="bio">@T["ProfileBio"]</label>
            <InputTextArea id="bio" @bind-Value="Form.Bio" rows="3" maxlength="300" aria-describedby="bio-help" />
            <p id="bio-help" class="help">@T["ProfileBioHelp"]</p>
        </div>
        <fieldset class="section">
            <legend>@T["ProfileLinks"]</legend>
            <p class="help">@T["ProfileLinksHelp"]</p>
            <LinkRows Rows="Form.Links" Invalid="@(IsError ? Form.ErrorField : null)" />
        </fieldset>
        <div class="form-actions">
            <button class="btn primary" type="submit">@T["Save"]</button>
            <span class="muted">@T["ProfileShownAs", Form.Name]</span>
        </div>
    </EditForm>

    <div class="form">
        <ConnectedApps Grants="Apps" Status="@AppsStatus" />
    </div>
}

@code {
    /// <summary>Gets or sets whether the last action saved.</summary>
    // "Saved." after the redirect, in TempData rather than the address: a reload doesn't show it again
    // (T-0122).
    [SupplyParameterFromTempData(Name = "saved")]
    public string? Saved { get; set; }

    /// <summary>Gets or sets the outcome of revoking a connected app.</summary>
    [SupplyParameterFromQuery(Name = "apps")]
    public string? AppsStatus { get; set; }

    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "profile")]
    public ProfileForm? Form { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Message { get; set; }

    // The apps this editor allowed (ADR 0007).
    private IReadOnlyList<ConnectedApps.App> Apps { get; set; } = [];

    private bool IsError { get; set; }

    // Whether the form came from the store rather than a post.
    private bool Loaded { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext!;
        Apps = await Tokens.ListGrantsAsync(context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "", context.RequestAborted);
        if (!HttpMethods.IsPost(context.Request.Method) || Form is null)
        {
            if (EditorRights.AuthorId(context.User) is not { } authorId)
            {
                Navigation.NavigateTo("/admin/forbidden");
                return;
            }

            Form = ProfileForm.From(await Profiles.FindAsync(authorId, context.RequestAborted), EditorClaims.ProvidedName(context.User));
            Message = Saved == "1" ? T["SavedMessage"].Value : null;
            Saved = null; // Shown once: TempData keeps what the property holds when the request ends.
            Loaded = true;
        }
    }

    // The form's submit handler. Saving here rather than in OnInitializedAsync means the form has
    // rendered before the redirect, so the redirect stands (F-0046).
    private async Task SaveAsync()
    {
        if (Loaded || Form is null)
        {
            return;
        }

        var context = HttpContext!;
        if (EditorRights.AuthorId(context.User) is not { } authorId)
        {
            Navigation.NavigateTo("/admin/forbidden");
            return;
        }

        Form.Pad();
        if (Form.ToAuthor(authorId, out var error) is not { } profile)
        {
            (Message, IsError) = (error, true);
            return;
        }

        if (!await Profiles.SaveAsync(profile, context.RequestAborted))
        {
            (Message, IsError) = (T["ConflictMessage"], true);
            return;
        }

        // Audited like every other settings change (F-0077).
        var actor = EditorClaims.Email(context.User);
        await Audit.WriteAsync(new AuditEntry(Time.GetUtcNow(), actor, "profile-saved", "authors.json (" + authorId + ")"), context.RequestAborted);
        Saved = "1";
        Navigation.NavigateTo("/admin/profile");
    }
}
