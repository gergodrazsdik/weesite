@page "/admin/tags"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject SiteSettingsEditor Editor
@inject ContentCatalogProvider Content
@inject IAuditLog Audit
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResource> T

@* Tag colours and descriptions (ADR 0006): admins only. *@
<PageTitle>@T["TagsAdminTitle"]</PageTitle>

<div class="admin-head">
    <h1>@T["TagsAdminTitle"]</h1>
</div>
<p class="admin-intro">@T["TagsAdminIntro"]</p>

@if (Message is { } message)
{
    <FormNotice Message="@message" IsError="IsError" FieldId="@Form?.ErrorField?.Id" />
}

@if (Form is not null)
{
    <EditForm Model="Form" FormName="tags" OnSubmit="SaveAsync" method="post" class="form wide">
        <input type="hidden" name="Form.ETag" value="@Form.ETag" />
        <div class="table-scroll">
            <table class="data tags-table">
                <caption class="visually-hidden">@T["TagsHeading"]</caption>
                <thead>
                    <tr><th scope="col">@T["TagColumn"]</th><th scope="col">@T["ColourColumn"]</th><th scope="col">@T["DescriptionColumn"]</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Form.Tags.Count; i++)
                    {
                        var row = i;
                        var tag = Form.Tags[row].Tag ?? "";
                        <tr>
                            <th scope="row">
                                <input type="hidden" name="@($"Form.Tags[{row}].Tag")" value="@tag" />
                                <span class="@($"tag {Form.Tags[row].Colour}".TrimEnd())" data-preview="@row">#@tag</span>
                                <span class="count">@Count(tag)</span>
                            </th>
                            <td>
                                @* The select and each option show their colour (where the browser draws options). *@
                                <select id="tag-colour-@row" aria-invalid="@Invalid($"tag-colour-{row}")" class="@($"colour-select {Form.Tags[row].Colour}".TrimEnd())" name="@($"Form.Tags[{row}].Colour")" aria-label="@T["ColourOf", tag]" data-colour-for="@row">
                                    <option value="" selected="@(string.IsNullOrEmpty(Form.Tags[row].Colour))">@T["NoColour"]</option>
                                    @foreach (var colour in TagDetails.Colours)
                                    {
                                        <option class="@colour" value="@colour" selected="@(colour == Form.Tags[row].Colour)">@T["Colour_" + colour]</option>
                                    }
                                </select>
                            </td>
                            <td><input id="tag-description-@row" aria-invalid="@Invalid($"tag-description-{row}")" name="@($"Form.Tags[{row}].Description")" value="@(Form.Tags[row].Description ?? "")" maxlength="160" aria-label="@T["DescriptionOf", tag]" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="form-actions">
            <button class="btn primary" type="submit">@T["Save"]</button>
        </div>
    </EditForm>
    @* Save before going to another page: a page's changes go with its own Save. *@
    <AdminPager Total="TagCount" PageSize="PageSize" Current="CurrentPage" Href="@(page => Paging.With("/admin/tags", page))" />
    <script type="module" src="/@Assets["admin/tag-colours.js"]"></script>
}

@code {
    /// <summary>Gets or sets whether the last action saved.</summary>
    // "Saved." after the redirect, in TempData rather than the address: a reload doesn't show it again
    // (T-0122).
    [SupplyParameterFromTempData(Name = "saved")]
    public string? Saved { get; set; }

    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "tags")]
    public TagsForm? Form { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Message { get; set; }

    private bool IsError { get; set; }

    private string? Invalid(string id) => IsError ? FieldError.Invalid(Form?.ErrorField, id) : null;

    private const int PageSize = 30;

    /// <summary>Gets or sets the page of tags, from 1 (T-0131).</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageParameter { get; set; }

    private int CurrentPage { get; set; } = 1;

    private int TagCount { get; set; }

    // Whether the form came from the store rather than a post.
    private bool Loaded { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext!;
        var cancel = context.RequestAborted;
        TagCount = Content.Current.Tags.Count;
        CurrentPage = Paging.Current(PageParameter, TagCount, PageSize);
        if (!HttpMethods.IsPost(context.Request.Method) || Form is null)
        {
            // One page of the tags in the form (T-0131): rows numbered from 0, as the form binds
            // them; a save keeps the other tags' details as stored (TagsForm.ToChange).
            Form = TagsForm.From(await Editor.OpenAsync(cancel), Content.Current.Tags.Keys);
            Form.Tags = [.. Paging.Page(Form.Tags, CurrentPage, PageSize)];
            Message = Saved == "1" ? T["SavedMessage"].Value : null;
            Saved = null; // Shown once: TempData keeps what the property holds when the request ends.
            Loaded = true;
        }
    }

    // The form's submit handler. Saving here rather than in OnInitializedAsync means the form has
    // rendered before the redirect, so the redirect stands (F-0046).
    private async Task SaveAsync()
    {
        if (Loaded || Form is null)
        {
            return;
        }

        var context = HttpContext!;
        var cancel = context.RequestAborted;
        var opened = await Editor.OpenAsync(cancel);
        var change = Form.ToChange(opened.Settings, out var error);
        if (change is null)
        {
            (Message, IsError) = (error, true);
            return;
        }

        if (!await Editor.SaveAsync(Form.ETag, change, cancel))
        {
            (Message, IsError) = (T["SettingsConflict"].Value, true);
            return;
        }

        var actor = EditorClaims.Email(context.User);
        await Audit.WriteAsync(new AuditEntry(Time.GetUtcNow(), actor, "tags-changed", "site.json"), cancel);
        Saved = "1";
        Navigation.NavigateTo(Paging.With("/admin/tags", CurrentPage));
    }

    private string Count(string tag) =>
        Content.Current.Tags.TryGetValue(tag, out var posts) ? (posts.Count == 1 ? T["PostCountOne"] : T["PostCount", posts.Count]) : "";
}
