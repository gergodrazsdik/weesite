@page "/admin/media"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Content.Media
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.EditorPolicy)]
@inject MediaLibrary Library
@inject ContentCatalogProvider Content
@inject IStringLocalizer<AdminResource> T

@* Media (ADR 0006): an upload area, then the files as cards with the Markdown to copy. *@
<PageTitle>@T["MediaTitle"]</PageTitle>

<div class="admin-head">
    <h1>@T["MediaTitle"]</h1>
    <span class="count">@T["FileCount", All.Count]</span>
    <RefreshLink Href="@ShowLink(ShowKey)" />
</div>
<p class="admin-intro">@T["MediaIntro"]</p>

@if (Error is { } error)
{
    <p class="notice" role="alert">@error</p>
}
else if (Deleted is { Length: > 0 } deleted)
{
    <p class="notice" role="status">@T["DeletedMedia", deleted]</p>
}
else if (Archived is { Length: > 0 } archived)
{
    <p class="notice" role="status">@T["ArchivedMedia", archived]</p>
}
else if (Unarchived is { Length: > 0 } unarchived)
{
    <p class="notice" role="status">@T["UnarchivedMedia", unarchived]</p>
}
else if (Uploaded is { } name)
{
    <div class="notice" role="status">
        <p>@T["UploadedMessage"]</p>
        <label for="snippet">@T["SnippetLabel"]</label>
        <input id="snippet" class="snippet" readonly value="@MediaLinks.Snippet(new MediaItem(name, ImageProcessor.IsProcessable(name)), Alt)" />
    </div>
}

<form class="upload" method="post" action="/admin/media" enctype="multipart/form-data" aria-labelledby="upload-heading">
    <h2 id="upload-heading" class="visually-hidden">@T["UploadHeading"]</h2>
    <AntiforgeryToken />
    <label class="drop" for="file">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"></path></svg>
        <span><strong>@T["FileLabel"]:</strong> @T["DropOrChoose"]</span>
        <span id="file-help" class="rules">@T["FileRules"]</span>
        <span class="chosen"></span>
        <input id="file" class="visually-hidden" type="file" name="file" required accept="@string.Join(",", MediaLibrary.AllowedExtensions.Order(StringComparer.Ordinal))" aria-describedby="file-help" />
    </label>
    <div class="fields">
        <div class="field">
            <label for="alt">@T["AltLabel"]</label>
            <input id="alt" type="text" name="alt" maxlength="300" aria-describedby="alt-help" />
            <p id="alt-help" class="help">@T["AltHelp"]</p>
        </div>
        <p class="help">@T["ImagesProcessed"]</p>
        <div><button class="btn primary" type="submit">@T["UploadButton"]</button></div>
    </div>
</form>

<section aria-labelledby="files-heading">
    <div class="list-head">
        <h2 id="files-heading" class="label">@T["FilesHeading"]</h2>
        <form class="search-box" role="search" method="get" aria-label="@T["FilterFiles"]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
            <label for="media-filter" class="visually-hidden">@T["FilterFiles"]</label>
            <input id="media-filter" type="search" name="q" value="@Q" placeholder="@T["FilterByName"]" />
            @if (ShowKey is { } show)
            {
                <input type="hidden" name="show" value="@show" />
            }
            <button type="submit" class="visually-hidden">@T["Filter"]</button>
        </form>
    </div>
    @* The files in use or not, those no post or page uses (T-0112), for clearing out, and the
    archived ones (T-0111), which All leaves out. *@
    <nav class="tabs media-tabs" aria-label="@T["MediaShow"]">
        <a href="@ShowLink(null)" aria-current="@(ShowKey is null ? "page" : null)">@T["AllFiles"] <span>@All.Count(f => !f.IsArchived)</span></a>
        <a href="@ShowLink("unused")" aria-current="@(ShowKey == "unused" ? "page" : null)">@T["UnusedFiles"] <span>@All.Count(IsUnused)</span></a>
        <a href="@ShowLink("archived")" aria-current="@(ShowKey == "archived" ? "page" : null)">@T["TabArchived"] <span>@All.Count(f => f.IsArchived)</span></a>
    </nav>
    @if (Items.Count == 0)
    {
        <p class="empty">@(All.Count == 0 ? T["NothingYet"] : T["NoneMatch"])</p>
    }
    else
    {
        <ul class="media-grid" role="list">
            @foreach (var item in Items)
            {
                var snippetId = "snippet-" + item.Name;
                <li>
                    <div class="@(item.Thumbnail is null ? "thumb icon" : "thumb")">
                        @if (item.Thumbnail is { } thumbnail)
                        {
                            <img src="@thumbnail" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span aria-hidden="true">@Extension(item.Name)</span>
                        }
                    </div>
                    <div class="info">
                        <a class="name" href="@item.Path" target="_blank" rel="noopener">@item.Name<span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a>
                        <span class="dim">@(item.Width is { } w && item.Height is { } h ? $"{w} × {h}" : item.IsImage ? T["ImageKind", Extension(item.Name)] : T["DownloadKind", Extension(item.Name)])</span>
                        @if (item.IsArchived)
                        {
                            <span class="pill archived">@T["StatusArchived"]</span>
                        }
                        @{ var uses = Content.Current.ActiveUsesOf(item.Name); }
                        @if (uses.Count == 0)
                        {
                            <span class="dim uses">@T["NotUsed"]</span>
                        }
                        else
                        {
                            <details class="uses">
                                <summary>@T["UsedIn", uses.Count]</summary>
                                <ul role="list">
                                    @foreach (var use in uses)
                                    {
                                        <li><a href="/admin/edit?path=@Uri.EscapeDataString(use.SourcePath)">@use.Title</a></li>
                                    }
                                </ul>
                            </details>
                        }
                        <div class="copy">
                            <code id="@snippetId">@item.Markdown</code>
                            <button type="button" data-copy="@snippetId" aria-label="@T["CopyMarkdownOf", item.Name]" hidden>@T["Copy"]</button>
                        </div>
                        @if (IsAdmin)
                        {
                            <div class="file-actions">
                                @if (item.IsArchived)
                                {
                                    <form method="post" action="/admin/media/archive">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="name" value="@item.Name" />
                                        <input type="hidden" name="archived" value="false" />
                                        <button class="link" type="submit" aria-label="@T["UnarchiveFile", item.Name]">@T["UnarchiveButton"]</button>
                                    </form>
                                }
                                else
                                {
                                    <a href="/admin/media/archive?name=@Uri.EscapeDataString(item.Name)" aria-label="@T["ArchiveFile", item.Name]">@T["ArchiveLink"]</a>
                                }
                                <a class="delete" href="/admin/media/delete?name=@Uri.EscapeDataString(item.Name)" aria-label="@T["DeleteFile", item.Name]">@T["DeleteLink"]</a>
                            </div>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>
<script type="module" src="/@Assets["admin/media-page.js"]"></script>

@code {
    /// <summary>Gets or sets the name of the file just uploaded.</summary>
    [SupplyParameterFromQuery(Name = "uploaded")]
    public string? Uploaded { get; set; }

    /// <summary>Gets or sets the description given with it.</summary>
    [SupplyParameterFromQuery(Name = "alt")]
    public string? Alt { get; set; }

    /// <summary>Gets or sets why the last upload was refused.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>Gets or sets the name of the file just archived (T-0111).</summary>
    [SupplyParameterFromQuery(Name = "archived")]
    public string? Archived { get; set; }

    /// <summary>Gets or sets the name of the file just brought back from the archive (T-0111).</summary>
    [SupplyParameterFromQuery(Name = "unarchived")]
    public string? Unarchived { get; set; }

    /// <summary>Gets or sets the name of the file just deleted (T-0110).</summary>
    [SupplyParameterFromQuery(Name = "deleted")]
    public string? Deleted { get; set; }

    // Only admins delete files: anyone's posts may use them.
    private bool IsAdmin => HttpContext?.User.IsInRole(nameof(EditorRole.Admin)) == true;

    /// <summary>Gets or sets which files to show: <c>unused</c>, <c>archived</c>, or all the others.</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public string? Show { get; set; }

    /// <summary>Gets or sets the filter text.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IReadOnlyList<MediaLink> All { get; set; } = [];

    private IReadOnlyList<MediaLink> Items { get; set; } = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        All = [.. (await Library.ListAsync(HttpContext?.RequestAborted ?? CancellationToken.None)).Select(i => MediaLinks.Describe(i, Content.Current.Media, null))];
        Items = [.. All.Where(i => (string.IsNullOrWhiteSpace(Q) || i.Name.Contains(Q.Trim(), StringComparison.OrdinalIgnoreCase))
            && ShowKey switch { "unused" => IsUnused(i), "archived" => i.IsArchived, _ => !i.IsArchived })];
    }

    private string? ShowKey => Show is "unused" or "archived" ? Show : null;

    // Not archived, and no post or page uses it, archived ones aside.
    private bool IsUnused(MediaLink file) => !file.IsArchived && Content.Current.ActiveUsesOf(file.Name).Count == 0;

    private string ShowLink(string? show)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(Q))
        {
            query.Add("q=" + Uri.EscapeDataString(Q.Trim()));
        }

        if (show is not null)
        {
            query.Add("show=" + show);
        }

        return query.Count == 0 ? "/admin/media" : "/admin/media?" + string.Join('&', query);
    }

    private static string Extension(string name) => System.IO.Path.GetExtension(name).TrimStart('.').ToUpperInvariant();
}
