@page "/admin/analytics"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject IStringLocalizer<AdminResource> T
@inject ContentCatalogProvider Content

@* The analytics dashboard (brief, Analytics; T-0052): page views of the last 7, 30 or 90 days.
The page shows at once, with a skeleton where the report goes; analytics.js loads the report
(AnalyticsReportView, at /admin/analytics/report) into it, and again every 30 s, with a pause
(F-0202). The report is server-rendered: the range is a link, the chart is columns with a tooltip
each and the same numbers as a table, the lists are tables; the script adds the table in a dialog
and the lists as tabs (T-0145). Without JavaScript, the report's own address shows it. *@
<PageTitle>@T["AnalyticsTitle"]</PageTitle>

<div class="admin-head">
    <AdminTitle Text="@T["AnalyticsTitle"]">@T["AnalyticsIntro"]</AdminTitle>
    @* The time of the last update in the site's time zone and clock, as every admin time (U-05);
    paused, the line says so (U-52). *@
    <p class="analytics-refresh" hidden data-updated="@T["AnalyticsUpdated", "{0}"]" data-paused="@T["AnalyticsPaused", "{0}"]" data-pause="@T["AnalyticsPause"]" data-resume="@T["AnalyticsResume"]" data-refresh-failed="@T["AnalyticsRefreshFailed"]" data-zone="@Weesite.Content.SiteTime.IanaId(Content.Current.Site.Zone)" data-clock="@(Content.Current.Site.TwelveHour ? "12h" : "24h")">
        <span class="analytics-updated"></span>
        <button class="btn" type="button">@T["AnalyticsPause"]</button>
        @* Says when updates stop coming, such as after the sign-in expired (F-0223). *@
        <span class="analytics-status" role="status"></span>
    </p>
    <a class="btn" href="/admin/analytics/posts?days=@Days">@T["PostReportLink"]</a>
</div>

<nav class="tabs" aria-label="@T["AnalyticsRange"]">
    @foreach (var days in Ranges)
    {
        <a href="/admin/analytics?days=@days" aria-current="@(days == Days ? "page" : null)">@T["LastDays", days]</a>
    }
</nav>

<section class="analytics loading" aria-busy="true" aria-labelledby="analytics-loading" data-report="/admin/analytics/report?days=@Days" data-failed="@T["AnalyticsLoadFailed"]">
    <h2 id="analytics-loading" class="visually-hidden">@T["AnalyticsLoading"]</h2>
    <dl class="stat-tiles" aria-hidden="true">
        @for (var i = 0; i < 4; i++)
        {
            <div><dt class="skeleton"></dt><dd class="skeleton"></dd></div>
        }
    </dl>
    <div class="skeleton skeleton-chart" aria-hidden="true"></div>
    <div class="skeleton skeleton-list" aria-hidden="true"></div>
    <noscript><p><a href="/admin/analytics/report?days=@Days">@T["AnalyticsWithoutScript"]</a></p></noscript>
</section>
<script type="module" src="/@Assets["admin/analytics.js"]"></script>

@code {
    private static IReadOnlyList<int> Ranges => Weesite.Web.Analytics.AnalyticsData.Ranges;

    /// <summary>Gets or sets the number of days to show: 7, 30 (the default) or 90.</summary>
    // A string, parsed here: a typed int? turns ?days=abc into an error page (F-0080).
    [SupplyParameterFromQuery(Name = "days")]
    public string? DaysParameter { get; set; }

    private int Days => Weesite.Web.Analytics.AnalyticsData.ParseDays(DaysParameter);
}
