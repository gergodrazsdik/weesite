@page "/admin/reset"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject ContentCatalogProvider Content
@inject ConfiguredAdmins Admins
@inject IStringLocalizer<AdminResource> T

@* The reset (T-0167): its own page, reached from the settings' danger zone. Ticked at first what
the seed or a backup puts back; the rest only when ticked. Posts to SiteReset's endpoint, which
signs the admin out only if they deleted themselves. Only admins from the deployment's configuration
may clear the audit log: for the rest that part is disabled, with the reason, and the endpoint
refuses it too. *@
<PageTitle>@T["ResetTitle"]</PageTitle>

<div class="admin-head">
    <AdminTitle Text="@T["ResetTitle"]">@T["ResetIntro"]</AdminTitle>
    <a class="btn" href="/admin/settings#danger-zone">@T["BackToSettings"]</a>
</div>

@if (Done == "1" && Error is null)
{
    <p class="notice success" role="status">@T["ResetDone", string.Join(", ", ResetParts.All.Where(Deleted.Contains).Select(p => T[$"ResetPart{p}"].Value))]</p>
}
else if (Error == "confirm")
{
    <p class="notice error" role="alert">@T["ResetNotConfirmed"]</p>
}
else if (Error == "nothing")
{
    <p class="notice error" role="alert">@T["ResetNothingChosen"]</p>
}
else if (Error == "audit-log")
{
    <p class="notice error" role="alert">@T["ResetAuditLogRefused"]</p>
}
else if (Error == "failed")
{
    @* F-0221: stopped partway; what went before it stays gone, the ticks stay for another try. *@
    <p class="notice error" role="alert">@(FailedPart is { } stop ? T["ResetFailedAt", T[$"ResetPart{stop}"].Value] : T["ResetFailed"])@if (DeletedBefore.Count > 0)
        {
            @(" ")@T["ResetFailedDeleted", string.Join(", ", ResetParts.All.Where(DeletedBefore.Contains).Select(p => T[$"ResetPart{p}"].Value))]
        }</p>
}

<form class="form reset-form" method="post" action="/admin/reset">
    <AntiforgeryToken />
    @foreach (var (heading, help, parts) in Groups)
    {
        <fieldset class="section">
            <legend>@T[heading]</legend>
            <p class="help">@T[help]</p>
            @foreach (var part in parts)
            {
                var key = ResetParts.Key(part);
                var locked = part == ResetPart.AuditLog && !MayClearAuditLog;
                <div class="reset-part">
                    <label class="check"><input type="checkbox" id="part-@key" name="part" value="@key" checked="@(Chosen.Contains(part) && !locked)" disabled="@locked" aria-describedby="part-@key-help" /> @T[$"ResetPart{part}"]</label>
                    <p id="part-@key-help" class="help">@T[$"ResetPart{part}Help"]@if (locked)
                        {
                            @(" ")@T["ResetPartAuditLogConfiguredOnly"]
                        }</p>
                </div>
            }
        </fieldset>
    }

    <section class="section danger-zone" aria-labelledby="reset-confirm-heading">
        <h2 id="reset-confirm-heading">@T["DangerZoneHeading"]</h2>
        <p class="help">@T["ResetBefore"] <a href="/admin/backup">@T["BackupTitle"]</a>. @T["ResetRecovery"]</p>
        <p class="help">@T["ResetSignsOut"]</p>
        <div class="field typed-confirm">
            <label for="reset-confirm">@T["ResetConfirmLabel", Content.Current.Site.Name]</label>
            <input id="reset-confirm" name="confirm" type="text" autocomplete="off" spellcheck="false" required aria-describedby="reset-confirm-help" />
            <p id="reset-confirm-help" class="help">@T["ResetConfirmHelp"]</p>
        </div>
        <div class="form-actions">
            <a class="btn" href="/admin/settings#danger-zone">@T["Cancel"]</a>
            <button class="btn danger" type="submit">@T["ResetButton"]</button>
        </div>
    </section>
</form>

@code {
    private static readonly (string Heading, string Help, ResetPart[] Parts)[] Groups =
    [
        ("ResetGroupSite", "ResetGroupSiteHelp", [ResetPart.Content, ResetPart.Media, ResetPart.Settings, ResetPart.SearchIndex]),
        ("ResetGroupVisitors", "ResetGroupVisitorsHelp", [ResetPart.Comments, ResetPart.Reactions, ResetPart.Messages]),
        ("ResetGroupRecords", "ResetGroupRecordsHelp", [ResetPart.Analytics, ResetPart.Editors, ResetPart.ConnectedApps, ResetPart.AuditLog, ResetPart.SpamCounters, ResetPart.Imports]),
    ];

    /// <summary>Gets or sets the parts ticked before, when the form comes back with an error.</summary>
    [SupplyParameterFromQuery(Name = "part")]
    public string[]? Part { get; set; }

    /// <summary>Gets or sets whether a reset just ran; <see cref="Part"/> then says what it deleted.</summary>
    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    /// <summary>Gets or sets why the last try did nothing, <c>confirm</c>, <c>nothing</c> or <c>audit-log</c>, or <c>failed</c> when it stopped partway.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    /// <summary>Gets or sets the part a failed reset stopped at; none when it stopped after them all.</summary>
    [SupplyParameterFromQuery(Name = "failed")]
    public string? Failed { get; set; }

    /// <summary>Gets or sets the parts a failed reset deleted before it stopped.</summary>
    [SupplyParameterFromQuery(Name = "deleted")]
    public string[]? DeletedParts { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // Only admins from the deployment's configuration clear the audit log (the endpoint checks it too).
    private bool MayClearAuditLog => SiteReset.CanClearAuditLog(Admins, HttpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value);

    private IReadOnlySet<ResetPart> Deleted => ResetParts.Parse(Part);

    private IReadOnlySet<ResetPart> DeletedBefore => ResetParts.Parse(DeletedParts);

    private ResetPart? FailedPart => ResetParts.Parse([Failed]) is { Count: 1 } stop ? stop.Single() : null;

    private IReadOnlySet<ResetPart> Chosen => Error is not null ? ResetParts.Parse(Part) : ResetParts.Defaults;
}
