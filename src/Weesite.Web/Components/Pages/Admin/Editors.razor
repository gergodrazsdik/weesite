@page "/admin/editors"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject ConfiguredAdmins Admins
@inject IEditorStore Store
@inject Weesite.Web.Agents.OAuth.OAuthTokens Tokens
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["EditorsTitle"]</PageTitle>

@* Who can sign in (ADR 0006 layout, T-0093): admins from configuration, editors added here with
their role, and a form to add one. Each change is its own small form post. *@
<div class="admin-head">
    <h1>@T["EditorsTitle"]</h1>
</div>
<p class="admin-intro">@T["EditorsIntro"]</p>

@if (Message is { } message)
{
    <p class="notice" role="status">@message</p>
}

<div class="form wide editors">
    <section class="section" aria-labelledby="configured-admins">
        <h2 id="configured-admins">@T["ConfiguredAdmins"]</h2>
        <p class="help">@T["ConfiguredAdminsText"]</p>
        @if (Admins.Addresses.Count == 0)
        {
            <p class="muted">@T["NoConfiguredAdmins"]</p>
        }
        else
        {
            <ul class="address-list" role="list">
                @foreach (var admin in Admins.Addresses)
                {
                    <li>@admin</li>
                }
            </ul>
        }
    </section>

    @* Not a named region itself: its table is one, with the same name (axe landmark-unique). *@
    <section class="section">
        <h2 id="editors-list">@T["EditorsList"]</h2>
        @if (List.Count == 0)
        {
            <p class="muted">@T["NoEditors"]</p>
        }
        else
        {
            <div class="table-scroll" tabindex="0" role="region" aria-labelledby="editors-list">
                <table class="data">
                    <thead>
                        <tr>
                            <th scope="col">@T["Email"]</th>
                            <th scope="col">@T["Role"]</th>
                            <th scope="col">@T["AddedBy"]</th>
                            <th scope="col"><span class="visually-hidden">@T["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (editor, i) in List.Select((e, i) => (e, i)))
                        {
                            var self = IsSelf(editor.Email);
                            <tr>
                                <th scope="row" class="email">@editor.Email</th>
                                <td>
                                    <form class="row-form" method="post" action="/admin/editors">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="email" value="@editor.Email" />
                                        <label for="role-@i" class="visually-hidden">@T["RoleOf", editor.Email]</label>
                                        <select id="role-@i" name="role" disabled="@self">
                                            <option value="Author" selected="@(editor.Role == EditorRole.Author)">@T["RoleAuthor"]</option>
                                            <option value="Admin" selected="@(editor.Role == EditorRole.Admin)">@T["RoleAdmin"]</option>
                                        </select>
                                        <button class="btn small" type="submit" disabled="@self">@T["Save"]</button>
                                    </form>
                                </td>
                                <td class="muted">@editor.AddedBy</td>
                                <td>
                                    <form class="row-form" method="post" action="/admin/editors/remove">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="email" value="@editor.Email" />
                                        <button class="btn small" type="submit" disabled="@self" aria-label="@T["RemoveEditor", editor.Email]">@T["Remove"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <ConnectedApps Grants="Apps" ShowEditor="true" Status="@AppsStatus" />

    <section class="section" aria-labelledby="add-editor">
        <h2 id="add-editor">@T["AddEditor"]</h2>
        <form class="add-editor" method="post" action="/admin/editors">
            <AntiforgeryToken />
            <div class="field">
                <label for="new-email">@T["Email"]</label>
                <input id="new-email" type="email" name="email" required maxlength="@EditorChanges.MaxEmailLength" autocomplete="off" />
            </div>
            <div class="field">
                <label for="new-role">@T["Role"]</label>
                <select id="new-role" name="role">
                    <option value="Author">@T["RoleAuthor"]</option>
                    <option value="Admin">@T["RoleAdmin"]</option>
                </select>
            </div>
            <button class="btn primary" type="submit">@T["AddEditorButton"]</button>
        </form>
    </section>
</div>

@code {
    /// <summary>Gets or sets the outcome of the last change.</summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IReadOnlyList<Editor> List { get; set; } = [];

    /// <summary>Gets or sets the outcome of revoking a connected app.</summary>
    [SupplyParameterFromQuery(Name = "apps")]
    public string? AppsStatus { get; set; }

    // Every editor's connected apps (ADR 0007).
    private IReadOnlyList<ConnectedApps.App> Apps { get; set; } = [];

    private string? Message => Status switch
    {
        "saved" => T["EditorSaved"].Value,
        "removed" => T["EditorRemoved"].Value,
        "missing" => T["EditorMissing"].Value,
        "invalid" => T["EditorInvalid"].Value,
        "self" => T["EditorSelf"].Value,
        "configured" => T["EditorConfigured"].Value,
        _ => null,
    };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var cancel = HttpContext?.RequestAborted ?? CancellationToken.None;
        List = await Store.ListAsync(cancel);
        Apps = await Tokens.ListGrantsAsync(null, cancel);
    }

    private bool IsSelf(string email) =>
        HttpContext?.User.FindFirst(ClaimTypes.Email)?.Value is { } me
        && string.Equals(ConfiguredAdmins.Normalize(me), ConfiguredAdmins.Normalize(email), StringComparison.Ordinal);
}
