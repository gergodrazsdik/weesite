@page "/admin/audit"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject IAuditLog Log
@inject IStringLocalizer<AdminResource> T
@inject ContentCatalogProvider Content

<PageTitle>@T["AuditTitle"]</PageTitle>

@* The latest changes, newest first (ADR 0006 layout, T-0093). *@
<div class="admin-head">
    <AdminTitle Text="@T["AuditTitle"]">@T["AuditIntro"]</AdminTitle>
    @* Filter by who, what or the target (T-0131); a link form, so it works without scripts. *@
    <form class="search-box" role="search" method="get" aria-label="@T["FilterAudit"]">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <label for="audit-filter" class="visually-hidden">@T["FilterAudit"]</label>
        <input id="audit-filter" type="search" name="q" value="@Q" placeholder="@T["FilterAuditPlaceholder"]" />
        @if (Month is not null)
        {
            <input type="hidden" name="month" value="@MonthValue" />
        }
        @* A button to see as well as Enter, so nobody has to know to press it (U-38). *@
        <button type="submit">@T["Filter"]</button>
    </form>
</div>
@if (MonthMissing)
{
    @* "Show the month" with no month chosen, or one that can't be read (U-53). *@
    <p class="notice error" role="alert">@T["AuditChooseMonth"]</p>
}
@* A whole month rather than the latest actions, and the same as CSV (T-0122): links and a form, so it works without scripts. *@
<form class="audit-pick" method="get" action="/admin/audit">
    @if (!string.IsNullOrWhiteSpace(Q))
    {
        <input type="hidden" name="q" value="@Q.Trim()" />
    }
    <div class="field">
        <label for="audit-month">@T["AuditMonth"]</label>
        <input id="audit-month" type="month" name="month" value="@MonthValue" min="2000-01" />
    </div>
    <button type="submit" class="btn">@T["AuditShowMonth"]</button>
    @if (Month is not null)
    {
        <a class="btn" href="@Query("/admin/audit", null)">@T["AuditShowLatest"]</a>
    }
    <a class="btn" href="@Query("/admin/audit/export.csv", MonthValue)" download>@T[Month is null ? "AuditExportYear" : "AuditExportMonth"]</a>
</form>
@if (Month is null && Capped)
{
    <p class="help">@T["AuditCapped", MaxEntries]</p>
}

@if (Entries.Count == 0)
{
    <p class="empty">@(!string.IsNullOrWhiteSpace(Q) ? T["NoneMatch"] : Month is null ? T["NoAuditEntries"] : T["NoAuditEntriesMonth"])</p>
}
else
{
    <div class="table-scroll audit" tabindex="0" role="region" aria-labelledby="audit-caption">
        <table class="data">
            <caption id="audit-caption" class="visually-hidden">@Caption</caption>
            <thead>
                <tr>
                    <th scope="col">@T["When"]</th>
                    <th scope="col">@T["Who"]</th>
                    <th scope="col">@T["What"]</th>
                    <th scope="col">@T["Target"]</th>
                </tr>
            </thead>
            <tbody>
                @* In words (U-53): the editor's name with their address under it, the action as a
                phrase, a post or page by its title with its file under it. The CSV keeps the codes. *@
                @foreach (var entry in Entries)
                {
                    var name = AuditText.NameOf(Content.Current.Site, entry.Actor);
                    var target = AuditText.Read(Content.Current, entry.Target);
                    <tr>
                        <td class="date"><time datetime="@entry.At.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@Content.Current.Site.FormatTime(seconds: true, at: entry.At)</time></td>
                        <td class="who">
                            @if (name is not null)
                            {
                                <span>@name</span>
                                <span class="muted">@entry.Actor</span>
                            }
                            else
                            {
                                <span>@entry.Actor</span>
                            }
                        </td>
                        <td>@AuditText.Action(entry.Action)</td>
                        <td class="target">
                            @if (target is not null)
                            {
                                if (target.Edit is { } edit)
                                {
                                    <a href="@edit">@target.Text</a>
                                }
                                else
                                {
                                    <span>@target.Text</span>
                                }
                                if (target.Path is { } path)
                                {
                                    <span class="muted">@path</span>
                                }
                                if (target.App is { } app)
                                {
                                    <span class="muted">@T["AuditThroughApp", app]</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <AdminPager Total="MatchCount" PageSize="PageSize" Current="CurrentPage" Href="@(page => Paging.With(ListUrl, page))" />
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IReadOnlyList<AuditEntry> Entries { get; set; } = [];

    private const int PageSize = 50;

    // How far back the log reads: plenty for an admin looking for a change, cheap to read.
    private const int MaxEntries = 1000;

    /// <summary>Gets or sets the filter: text in who, what or the target.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    /// <summary>Gets or sets the page, from 1.</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageParameter { get; set; }

    private int CurrentPage { get; set; } = 1;

    private int MatchCount { get; set; }

    /// <summary>Gets or sets the month to show (<c>yyyy-MM</c>), instead of the latest actions.</summary>
    [SupplyParameterFromQuery(Name = "month")]
    public string? MonthParameter { get; set; }

    // The month shown, from its first moment (UTC), or null for the latest actions.
    private DateTimeOffset? Month { get; set; }

    private string? MonthValue => Month?.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);

    // Whether the latest actions reached MaxEntries, so older ones are left out.
    private bool Capped { get; set; }

    // Whether "Show the month" came without a month it can read (U-53).
    private bool MonthMissing => Month is null && HttpContext?.Request.Query.ContainsKey("month") == true;

    // The table's name: how many, and of which month as people write it (U-53).
    private string Caption => Month is { } month
        ? (MatchCount == 1 ? T["AuditMonthCaptionOne", MonthName(month)] : T["AuditMonthCaption", MatchCount, MonthName(month)])
        : (MatchCount == 1 ? T["AuditCaptionOne"] : T["AuditCaption", MatchCount]);

    private static string MonthName(DateTimeOffset month) => month.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    // The filter finds the words the page shows too: an editor's name, an action as a phrase, an
    // item's title (U-53).
    private bool Matches(AuditEntry entry)
    {
        if (AuditExport.Matches(entry, Q))
        {
            return true;
        }

        var q = Q!.Trim();
        return (AuditText.NameOf(Content.Current.Site, entry.Actor)?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || AuditText.Action(entry.Action).Contains(q, StringComparison.OrdinalIgnoreCase)
            || (AuditText.Read(Content.Current, entry.Target)?.Text.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private string ListUrl => Query("/admin/audit", MonthValue);

    // An address with the filter and, when given, the month.
    private string Query(string path, string? month)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(Q))
        {
            parts.Add("q=" + Uri.EscapeDataString(Q.Trim()));
        }

        if (month is not null)
        {
            parts.Add("month=" + month);
        }

        return parts.Count == 0 ? path : path + "?" + string.Join('&', parts);
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        // The latest MaxEntries, or a whole month, filtered, then a page of them (T-0131, T-0122).
        var cancel = HttpContext?.RequestAborted ?? CancellationToken.None;
        List<AuditEntry> matching;
        if (AuditExport.TryMonth(MonthParameter, out var month))
        {
            Month = month;
            matching = [];
            var read = 0;
            await foreach (var entry in Log.ReadAsync(month, month.AddMonths(1), cancel))
            {
                if (++read > AuditExport.MaxRows)
                {
                    break;
                }

                if (Matches(entry))
                {
                    matching.Add(entry);
                }
            }
        }
        else
        {
            var latest = await Log.LatestAsync(MaxEntries, cancel);
            Capped = latest.Count >= MaxEntries;
            matching = [.. latest.Where(Matches)];
        }

        MatchCount = matching.Count;
        CurrentPage = Paging.Current(PageParameter, MatchCount, PageSize);
        Entries = Paging.Page(matching, CurrentPage, PageSize);
    }
}
