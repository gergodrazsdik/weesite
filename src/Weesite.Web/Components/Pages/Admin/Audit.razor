@page "/admin/audit"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject IAuditLog Log
@inject IStringLocalizer<AdminResource> T

<PageTitle>@T["AuditTitle"]</PageTitle>

@* The latest changes, newest first (ADR 0006 layout, T-0093). *@
<div class="admin-head">
    <h1>@T["AuditTitle"]</h1>
</div>
<p class="admin-intro">@T["AuditIntro"]</p>

@if (Entries.Count == 0)
{
    <p class="notice">@T["NoAuditEntries"]</p>
}
else
{
    <div class="table-scroll audit" tabindex="0" role="region" aria-labelledby="audit-caption">
        <table class="data">
            <caption id="audit-caption" class="visually-hidden">@T["AuditCaption", Entries.Count]</caption>
            <thead>
                <tr>
                    <th scope="col">@T["When"]</th>
                    <th scope="col">@T["Who"]</th>
                    <th scope="col">@T["What"]</th>
                    <th scope="col">@T["Target"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Entries)
                {
                    <tr>
                        <td class="date"><time datetime="@entry.At.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@entry.At.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</time></td>
                        <td>@entry.Actor</td>
                        <td><span class="pill">@entry.Action</span></td>
                        <td class="target">@entry.Target</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IReadOnlyList<AuditEntry> Entries { get; set; } = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() =>
        Entries = await Log.LatestAsync(100, HttpContext?.RequestAborted ?? CancellationToken.None);
}
