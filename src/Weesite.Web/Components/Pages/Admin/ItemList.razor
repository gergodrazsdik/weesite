@page "/admin"
@page "/admin/posts"
@page "/admin/pages"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.EditorPolicy)]
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IStringLocalizer<AdminResource> T

@* Posts or pages (ADR 0006): a filter, status tabs with counts, and a table (rows on phones) whose
headings sort it, as the posts report's do (U-37): links, so it works without scripts. *@
<PageTitle>@Heading</PageTitle>

<div class="admin-head">
    <h1>@Heading</h1>
    <form class="search-box" role="search" method="get" aria-label="@T["FilterItems", Heading]">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
        <label for="filter" class="visually-hidden">@T["FilterItems", Heading]</label>
        <input id="filter" type="search" name="q" value="@Q" placeholder="@(Kind == ContentKind.Post ? T["FilterPostsPlaceholder"] : T["FilterPagesPlaceholder"])" />
        @if (Status is not null)
        {
            <input type="hidden" name="status" value="@Status" />
        }
        @if (!IsDefaultOrder(Column, Descending))
        {
            <input type="hidden" name="sort" value="@Column" />
            <input type="hidden" name="dir" value="@(Descending ? "desc" : "asc")" />
        }
        @* A button that shows how the filter applies, as the public search box has (U-38); Enter in the field works too. *@
        <button type="submit">@T["Filter"]</button>
    </form>
    <RefreshLink Href="@Paging.With(TabUrl(Status), CurrentPage)" />
    <a class="btn primary" href="/admin/new/@(Kind == ContentKind.Page ? "page" : "post")">+ @(Kind == ContentKind.Page ? T["NewPage"] : T["NewPost"])</a>
</div>

@if (AdminNotices.Open(HttpContext, Deleted) is { Length: > 0 } deleted)
{
    <p class="notice" role="status">@T["DeletedItem", deleted]</p>
}

<nav class="tabs" aria-label="@T["StatusFilter"]">
    @foreach (var (status, label) in Tabs)
    {
        <a href="@TabUrl(status)" aria-current="@(status == Status ? "page" : null)">@label <span><span class="visually-hidden">, </span>@Matching.Count(i => InTab(i, status))</span></a>
    }
</nav>

@if (Items.Count == 0)
{
    <p class="empty">@(Matching.Count == 0 && string.IsNullOrEmpty(Q) ? T["NothingYet"] : T["NoneMatch"])</p>
}
else
{
    @* On a phone the rows stack and the headings are gone: the same sort links, in a line of their own. *@
    <nav class="sort-links" aria-label="@T["SortBy"]">
        <span aria-hidden="true">@T["SortBy"]</span>
        @foreach (var (column, label) in Headings)
        {
            <a href="@ListUrl(Status, column, column == Column ? !Descending : DescendingFirst(column))" aria-current="@(column == Column ? "true" : null)">@label@if (column == Column)
                {
                    <span class="sort-mark" aria-hidden="true">@(Descending ? "↓" : "↑")</span>
                    <span class="visually-hidden">, @(Descending ? T["SortedDescending"] : T["SortedAscending"])</span>
                }</a>
        }
    </nav>
    <div class="table-scroll" tabindex="0" role="region" aria-labelledby="items-caption">
        <table class="data stack sortable">
            <caption id="items-caption" class="visually-hidden">@Heading</caption>
            <thead>
                <tr>
                    @foreach (var (column, label) in Headings)
                    {
                        <th scope="col" aria-sort="@AriaSort(column)">
                            <a href="@ListUrl(Status, column, column == Column ? !Descending : DescendingFirst(column))">@label@if (column == Column)
                                {
                                    <span class="sort-mark" aria-hidden="true">@(Descending ? "↓" : "↑")</span>
                                }</a>
                        </th>
                    }
                    @if (Kind == ContentKind.Post)
                    {
                        <th scope="col">@T["Tags"]</th>
                    }
                    <th scope="col"><span class="visually-hidden">@T["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    var edit = "/admin/edit?path=" + Uri.EscapeDataString(item.SourcePath);
                    <tr>
                        <th scope="row">
                            <a href="@edit">@item.Title</a>
                            <span class="slug">@(item.IsSpecial ? (Weesite.Web.Seo.ContentUrls.PathOf(item) is { Length: > 0 } address ? address : T["SpecialPageNoAddress"]) : (item.Kind == ContentKind.Post ? "/blog/" : "/") + item.Slug)</span>
                        </th>
                        <td><span class="pill @StatusKey(item)">@StatusLabel(item)</span></td>
                        @if (Kind == ContentKind.Post)
                        {
                            @* The post's own date, which it shows; a scheduled one also says, labelled, when it goes public (U-36). *@
                            <td class="date">@(item.Date is { } date ? ContentDates.Iso(date) : "")@if (StatusKey(item) == "scheduled" && item.PublishAt is { } goesPublic)
                                {
                                    <span class="date-note">@T["GoesPublicAt", Content.Current.Site.FormatTime(goesPublic)]</span>
                                }</td>
                            @* A hidden comma between the tags: the cell lays them out apart, and a screen reader read "#web#notes" (T-0123). *@
                            <td class="tag-cell">
                                @foreach (var (tag, index) in item.Tags.Select((t, i) => (t, i)))
                                {
                                    <span class="@($"tag {TagColours.ClassOf(Content.Current.Site, tag)}".TrimEnd())">@if (index > 0)
                                    {<span class="visually-hidden">, </span>}#@tag</span>
                                }
                            </td>
                        }
                        <td class="actions"><a href="@edit" aria-label="@T["EditItem", item.Title]">@T["Edit"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <AdminPager Total="InTabCount" PageSize="PageSize" Current="CurrentPage" Href="@(page => Paging.With(TabUrl(Status), page))" />
}

@code {
    private const int PageSize = 25;

    /// <summary>Gets or sets the page of the list, from 1 (T-0131).</summary>
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageParameter { get; set; }

    private int CurrentPage { get; set; } = 1;

    private int InTabCount { get; set; }

    /// <summary>Gets or sets the filter text (title, slug or tag).</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    /// <summary>Gets or sets the title of the item just deleted (T-0110).</summary>
    [SupplyParameterFromQuery(Name = "deleted")]
    public string? Deleted { get; set; }

    /// <summary>Gets or sets the status tab: <c>published</c>, <c>draft</c>, <c>scheduled</c>, or none for all.</summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? StatusParameter { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Status => StatusParameter is "published" or "draft" or "scheduled" or "archived" ? StatusParameter : null;

    private ContentKind Kind => new Uri(Navigation.Uri).AbsolutePath.EndsWith("/pages", StringComparison.Ordinal) ? ContentKind.Page : ContentKind.Post;

    private string Heading => Kind == ContentKind.Page ? T["PagesTitle"] : T["PostsTitle"];

    // The items the editor may edit that match the filter text; the tabs count these.
    private IReadOnlyList<ContentItem> Matching { get; set; } = [];

    private IReadOnlyList<ContentItem> Items { get; set; } = [];

    private IEnumerable<(string? Status, string Label)> Tabs =>
        [(null, T["FilterAll"]), ("published", T["TabPublished"]), ("draft", T["TabDrafts"]), ("scheduled", T["TabScheduled"]), ("archived", T["TabArchived"])];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var user = HttpContext!.User;
        if (Kind == ContentKind.Page && !user.IsInRole(nameof(EditorRole.Admin)))
        {
            Navigation.NavigateTo("/admin/forbidden");
            return;
        }

        var catalog = Content.Current;
        var all = catalog.AllItems
            .Where(i => i.Kind == Kind && EditorRights.CanEdit(user, i.Kind, i.AuthorId, isNew: false));
        if (Q?.Trim() is { Length: > 0 } q)
        {
            var text = q.TrimStart('#');
            all = all.Where(i => i.Title.Contains(text, StringComparison.CurrentCultureIgnoreCase)
                || i.Slug.Contains(text, StringComparison.OrdinalIgnoreCase)
                || i.Tags.Any(t => t.Contains(text, StringComparison.OrdinalIgnoreCase)));
        }

        Matching = Sort(all, Column, Descending);
        // 25 a page (T-0131); the tabs count every match.
        var inTab = Matching.Where(i => InTab(i, Status)).ToList();
        InTabCount = inTab.Count;
        CurrentPage = Paging.Current(PageParameter, InTabCount, PageSize);
        Items = Paging.Page(inTab, CurrentPage, PageSize);
    }

    /// <summary>Gets or sets the column to sort by: <c>title</c>, <c>status</c> or, for posts, <c>date</c> (U-37).</summary>
    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortParameter { get; set; }

    /// <summary>Gets or sets the sort direction: <c>asc</c> or <c>desc</c>; the column's own default otherwise.</summary>
    [SupplyParameterFromQuery(Name = "dir")]
    public string? DirParameter { get; set; }

    private static readonly string[] StatusOrder = ["published", "scheduled", "draft", "archived"];

    private IEnumerable<(string Column, string Label)> Headings => Kind == ContentKind.Post
        ? [("title", T["Title"]), ("status", T["Status"]), ("date", T["Date"])]
        : [("title", T["Title"]), ("status", T["Status"])];

    // Posts newest first, pages by title, as before the headings sorted.
    private string DefaultColumn => Kind == ContentKind.Post ? "date" : "title";

    private string Column => SortParameter is { } sort && Headings.Any(h => h.Column == sort) ? sort : DefaultColumn;

    private bool Descending => DirParameter switch
    {
        "asc" => false,
        "desc" => true,
        _ => DescendingFirst(Column),
    };

    // Dates start with the newest; titles and statuses from the top.
    private static bool DescendingFirst(string column) => column == "date";

    private bool IsDefaultOrder(string column, bool descending) => column == DefaultColumn && descending == DescendingFirst(column);

    // The active column's direction; none on the others (WAI-ARIA: aria-sort on one header at a time).
    private string? AriaSort(string column) => column == Column ? (Descending ? "descending" : "ascending") : null;

    // Ties keep the default order: newest first, then by title.
    private List<ContentItem> Sort(IEnumerable<ContentItem> items, string column, bool descending)
    {
        var titles = StringComparer.CurrentCulture;
        IOrderedEnumerable<ContentItem> By<TKey>(Func<ContentItem, TKey> key, IComparer<TKey>? comparer = null) =>
            descending ? items.OrderByDescending(key, comparer) : items.OrderBy(key, comparer);
        var sorted = column switch
        {
            "title" => By(i => i.Title, titles),
            "status" => By(i => Array.IndexOf(StatusOrder, StatusKey(i))),
            _ => By(i => i.Date),
        };
        return [.. sorted.ThenByDescending(i => i.Date).ThenBy(i => i.Title, titles)];
    }

    // All leaves the archived ones out; they have their own tab (T-0111).
    private bool InTab(ContentItem item, string? status) =>
        status is null ? StatusKey(item) != "archived" : StatusKey(item) == status;

    // A scheduled item whose time has come is published.
    private string StatusKey(ContentItem item) => ItemStatus.Key(item, Time.GetUtcNow());

    // A scheduled post's time is in the Date column (U-36); a page has none, so its label keeps it.
    private string StatusLabel(ContentItem item) => StatusKey(item) switch
    {
        "draft" => T["StatusDraft"],
        "archived" => T["StatusArchived"],
        "scheduled" when Kind == ContentKind.Page && item.PublishAt is { } at =>
            T["StatusScheduledFor", Content.Current.Site.FormatTime(at)],
        "scheduled" => T["StatusScheduled"],
        _ => T["StatusPublished"],
    };

    // A tab keeps the filter and the sort.
    private string TabUrl(string? status) => ListUrl(status, Column, Descending);

    // The list's address: the filter, the tab, then the sort unless it's the default one.
    private string ListUrl(string? status, string column, bool descending)
    {
        var path = Kind == ContentKind.Page ? "/admin/pages" : "/admin/posts";
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(Q))
        {
            query.Add("q=" + Uri.EscapeDataString(Q));
        }

        if (status is not null)
        {
            query.Add("status=" + status);
        }

        if (!IsDefaultOrder(column, descending))
        {
            query.Add($"sort={column}&dir={(descending ? "desc" : "asc")}");
        }

        return query.Count == 0 ? path : path + "?" + string.Join("&", query);
    }
}
