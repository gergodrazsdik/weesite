@page "/admin/comments"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@using Weesite.Web.Visitors
@attribute [Authorize(Policy = EditorClaims.EditorPolicy)]
@inject CommentDesk Desk
@inject ContentCatalogProvider Content
@inject IStringLocalizer<AdminResource> T

<PageTitle>@T["CommentsTitle"]</PageTitle>

@* Comments on posts (ADR 0011): new ones and edits wait here until an editor approves or rejects
them. Admins see every post's, authors their own posts'. An edit of a published comment shows the
published text beside the edit; the published text stays until the edit is approved. Approve and
Reject send the version shown, so a comment its writer changed since is left alone (F-0209); Reject
here rejects what waits, never a published text: admins remove those on the post (F-0210). *@
<div class="admin-head">
    <AdminTitle Text="@T["CommentsTitle"]">@T["CommentsIntro", CommentCleanUp.RejectedDays]</AdminTitle>
    <RefreshLink Href="@($"/admin/comments?tab={Tab}")" />
</div>
@if (!Content.Current.Site.Comments)
{
    <p class="help">@T["CommentsOff"] <a href="/admin/settings">@T["SettingsTitle"]</a>.</p>
}

@if (Done is { } done && Notice(done) is { } notice)
{
    <p class="notice" role="@(done is "gone" or "unchanged" or "changed" ? "alert" : "status")">@notice</p>
}

<nav class="tabs" aria-label="@T["CommentsTabs"]">
    @foreach (var tab in CommentModeration.Tabs)
    {
        <a href="/admin/comments?tab=@tab" aria-current="@(tab == Tab ? "page" : null)">@TabLabel(tab) <span><span class="visually-hidden">, </span>@Count(tab)</span></a>
    }
</nav>

@if (Shown.Count == 0)
{
    <p class="notice">@T[Tab == "waiting" ? "NoCommentsWaiting" : "NoComments"]</p>
}
else
{
    <ul class="comment-queue" role="list">
        @foreach (var comment in Shown)
        {
            var post = Posts.GetValueOrDefault(comment.Post);
            var isEdit = comment.Status == CommentStatus.Approved && comment.PendingText is not null;
            <li class="comment-card" id="comment-@comment.Id">
                <p class="meta">
                    <strong>@comment.Name</strong>
                    <span class="muted">@T["CommentOn"]</span>
                    @if (post is { } item && item.IsPublicAt(DateTimeOffset.UtcNow))
                    {
                        <a href="@Weesite.Web.Seo.ContentUrls.PathOf(item)#comments">@item.Title</a>
                    }
                    else
                    {
                        <span>@(post?.Title ?? comment.Post)</span>
                    }
                    <span class="muted">· <time datetime="@comment.Written.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@Content.Current.Site.FormatTime(seconds: true, at: comment.Written)</time></span>
                    @if (isEdit)
                    {
                        <span class="pill new">@T["CommentEditPill"]</span>
                    }
                    else if (comment.Status == CommentStatus.Pending)
                    {
                        <span class="pill new">@T["CommentNewPill"]</span>
                    }
                </p>
                @if (isEdit)
                {
                    <div class="comment-texts">
                        <div>
                            <p class="label">@T["CommentPublishedText"]</p>
                            <p class="comment-text">@comment.Text</p>
                        </div>
                        <div>
                            <p class="label">@T["CommentEditText"]</p>
                            <p class="comment-text">@comment.PendingText</p>
                        </div>
                    </div>
                }
                else
                {
                    <p class="comment-text">@comment.Text</p>
                }
                <div class="form-actions">
                    @if (comment.Waiting)
                    {
                        <form method="post" action="/admin/comments/approve">
                            <AntiforgeryToken />
                            <input type="hidden" name="post" value="@comment.Post" />
                            <input type="hidden" name="id" value="@comment.Id" />
                            <input type="hidden" name="version" value="@comment.Stamp" />
                            <input type="hidden" name="tab" value="@Tab" />
                            <button class="btn primary small" type="submit">@T[isEdit ? "CommentApproveEdit" : "CommentApprove"]<span class="visually-hidden"> (@comment.Name)</span></button>
                        </form>
                        <form method="post" action="/admin/comments/reject">
                            <AntiforgeryToken />
                            <input type="hidden" name="post" value="@comment.Post" />
                            <input type="hidden" name="id" value="@comment.Id" />
                            <input type="hidden" name="version" value="@comment.Stamp" />
                            <input type="hidden" name="tab" value="@Tab" />
                            <button class="btn small" type="submit">@T[isEdit ? "CommentRejectEdit" : "CommentReject"]<span class="visually-hidden"> (@comment.Name)</span></button>
                        </form>
                    }
                    @* Delete apart, on the right (T-0161). *@
                    <form class="push-end" method="post" action="/admin/comments/delete" data-confirm="@T["CommentDeleteConfirm", comment.Name]" data-confirm-button="@T["CommentDelete"]">
                        <AntiforgeryToken />
                        <input type="hidden" name="post" value="@comment.Post" />
                        <input type="hidden" name="id" value="@comment.Id" />
                        <input type="hidden" name="tab" value="@Tab" />
                        <button class="btn danger small" type="submit">@T["CommentDelete"]<span class="visually-hidden"> (@comment.Name)</span></button>
                    </form>
                </div>
            </li>
        }
    </ul>
}

@code {
    /// <summary>Gets or sets the tab: <c>waiting</c>, <c>approved</c> or <c>rejected</c>.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabParameter { get; set; }

    /// <summary>Gets or sets what was just done.</summary>
    [SupplyParameterFromQuery(Name = "done")]
    public string? Done { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string Tab => CommentModeration.Tabs.Contains(TabParameter) ? TabParameter! : "waiting";

    private IReadOnlyList<Comment> All { get; set; } = [];

    // The posts by source path, looked up once for the whole list (F-0225).
    private IReadOnlyDictionary<string, ContentItem> Posts { get; set; } = new Dictionary<string, ContentItem>();

    // Waiting ones oldest first, so the longest waiting is on top; the others newest first.
    private IReadOnlyList<Comment> Shown => Tab switch
    {
        "rejected" => [.. All.Where(c => c.Status is CommentStatus.Rejected or CommentStatus.Removed).OrderByDescending(c => c.Id, StringComparer.Ordinal)],
        _ => [.. All.Where(c => c.Waiting).OrderBy(c => c.Written)],
    };

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.User is { } user)
        {
            All = await Desk.ListAsync(user, HttpContext.RequestAborted);
            Posts = Desk.Posts();
        }
    }

    private int Count(string tab) => tab switch
    {
        "rejected" => All.Count(c => c.Status is CommentStatus.Rejected or CommentStatus.Removed),
        _ => All.Count(c => c.Waiting),
    };

    private string TabLabel(string tab) => tab switch
    {
        "rejected" => T["CommentsTabRejected"],
        _ => T["CommentsTabWaiting"],
    };

    private string? Notice(string done) => done switch
    {
        "approved" => T["CommentApproved"].Value,
        "rejected" => T["CommentRejected"].Value,
        "deleted" => T["CommentDeleted"].Value,
        "gone" => T["CommentGone"].Value,
        "unchanged" => T["CommentUnchanged"].Value,
        "changed" => T["CommentChanged"].Value,
        _ => null,
    };
}
