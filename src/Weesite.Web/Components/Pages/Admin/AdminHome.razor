@page "/admin"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.EditorPolicy)]
@inject IStringLocalizer<SharedResource> T

@* The editor's start page. *@
<PageTitle>@T["AdminTitle"]</PageTitle>

<h1>@T["AdminTitle"]</h1>
<p>@T["SignedInAs", User?.Identity?.Name ?? "", Email, Role]</p>

<ul>
    <li><a href="/admin/posts">@T["PostsTitle"]</a></li>
    <li><a href="/admin/media">@T["MediaTitle"]</a></li>
    <li><a href="/admin/profile">@T["ProfileTitle"]</a></li>
    @if (User?.IsInRole(nameof(EditorRole.Admin)) == true)
    {
        <li><a href="/admin/pages">@T["PagesTitle"]</a></li>
        <li><a href="/admin/settings">@T["SettingsTitle"]</a></li>
        <li><a href="/admin/menu">@T["MenuTitle"]</a></li>
        <li><a href="/admin/tags">@T["TagsAdminTitle"]</a></li>
        <li><a href="/admin/theme">@T["ThemeTitle"]</a></li>
        <li><a href="/admin/editors">@T["EditorsTitle"]</a></li>
        <li><a href="/admin/audit">@T["AuditTitle"]</a></li>
    }
</ul>

<form method="post" action="/admin/sign-out">
    <AntiforgeryToken />
    <button type="submit">@T["SignOut"]</button>
</form>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ClaimsPrincipal? User => HttpContext?.User;

    private string Email => User?.FindFirst(ClaimTypes.Email)?.Value ?? "";

    private string Role => User?.IsInRole(nameof(EditorRole.Admin)) == true ? T["RoleAdmin"] : T["RoleAuthor"];
}
