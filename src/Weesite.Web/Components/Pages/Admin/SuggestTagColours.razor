@page "/admin/tags/suggest"
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inherits AdminFormPage
@inject SiteSettingsEditor Editor
@inject ContentCatalogProvider Content
@inject Weesite.Search.SearchIndexProvider Search
@inject IStringLocalizer<AdminResource> T

@* Suggested tag colours (T-0142): tags grouped by what their posts are about, one colour a group.
Nothing changes until the admin applies the ticked rows. *@
<PageTitle>@T["SuggestColoursTitle"]</PageTitle>

<div class="admin-head">
    <AdminTitle Text="@T["SuggestColoursTitle"]">@T["SuggestColoursIntro"]</AdminTitle>
</div>

@if (Message is { } message)
{
    <FormNotice Message="@message" IsError="IsError" />
}

@if (Groups.Count == 0 || Form is null)
{
    <p class="empty">@T["SuggestColoursNone"]</p>
    <p><a href="/admin/tags">@T["BackToTags"]</a></p>
}
else
{
    @* The texts the script fills in when a group's colour changes, from the same resources. *@
    <EditForm Model="Form" FormName="tag-colours" OnSubmit="ApplyAsync" method="post" class="form wide tag-suggestions-form"
        data-already="@T["SuggestColoursAlready", "{0}"]" data-from-to="@T["SuggestColoursFromTo", "{0}", "{1}"]" data-apply-to="@T["SuggestColoursApplyTo", "{0}", "{1}"]">
        <input type="hidden" name="Form.ETag" value="@Form.ETag" />
        @{ var row = 0; }
        @foreach (var (group, index) in Groups.Select((g, i) => (g, i)))
        {
            var number = index + 1;
            var heading = $"tag-group-{number}";
            var select = $"group-colour-{number}";
            <section class="tag-group tags-table" aria-labelledby="@heading">
                <div class="tag-group-head">
                    <h2 id="@heading">@T["SuggestColoursGroupHeading", number, group.Tags.Count == 1 ? T["SuggestColoursGroupOne"] : T["SuggestColoursGroup", group.Tags.Count]]</h2>
                    <span class="group-colour">
                        <label for="@select">@T["SuggestColoursGroupColour", number]</label>
                        <select id="@select" class="@($"colour-select {group.Colour}")" name="@($"Form.Groups[{index}].Colour")" data-group="@index">
                            @foreach (var colour in TagDetails.Colours)
                            {
                                <option class="@colour" value="@colour" selected="@(colour == group.Colour)">@T["Colour_" + colour]</option>
                            }
                        </select>
                    </span>
                </div>
                <div class="table-scroll">
                    <table class="data stack tag-suggestions">
                        <caption class="visually-hidden">@T["SuggestColoursCaption", number]</caption>
                        <thead>
                            <tr><th scope="col">@T["TagColumn"]</th><th scope="col">@T["SuggestColoursChange"]</th><th scope="col">@T["SuggestColoursApply"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var tag in group.Tags)
                            {
                                var rowIndex = row++;
                                var id = $"apply-{rowIndex}";
                                var currentName = tag.Current is { } current ? T["Colour_" + current].Value : T["NoColour"].Value;
                                <tr data-tag="@tag.Tag" data-current="@(tag.Current ?? "")" data-current-name="@currentName">
                                    <th scope="row"><span class="@($"tag {tag.Current}".TrimEnd())">#@tag.Tag</span> <span class="count">@Count(tag.Tag)</span></th>
                                    <td class="change">@(tag.Current == tag.Suggested ? T["SuggestColoursAlready", T["Colour_" + tag.Suggested]] : T["SuggestColoursFromTo", currentName, T["Colour_" + tag.Suggested]])</td>
                                    <td class="actions">
                                        <input type="hidden" name="@($"Form.Rows[{rowIndex}].Tag")" value="@tag.Tag" />
                                        <input type="hidden" name="@($"Form.Rows[{rowIndex}].Group")" value="@index" />
                                        <input type="checkbox" id="@id" name="@($"Form.Rows[{rowIndex}].Apply")" value="true" checked="@(tag.Current != tag.Suggested)" disabled="@(tag.Current == tag.Suggested)" />
                                        <label for="@id" class="visually-hidden">@T["SuggestColoursApplyTo", T["Colour_" + tag.Suggested], tag.Tag]</label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        <div class="form-actions">
            <a class="btn" href="/admin/tags">@T["Cancel"]</a>
            @* Without the script: shows what the chosen colours would change, saving nothing. *@
            <button class="btn" type="submit" name="Action" value="update" data-update>@T["SuggestColoursUpdate"]</button>
            <button class="btn primary" type="submit" name="Action" value="apply">@T["SuggestColoursApplyButton"]</button>
        </div>
    </EditForm>
    <script type="module" src="/@Assets["admin/tag-suggestions.js"]"></script>
}

@code {
    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "tag-colours")]
    public TagColoursForm? Form { get; set; }

    /// <summary>Gets or sets the button pressed: <c>update</c> shows the chosen colours, <c>apply</c> saves the ticked rows.</summary>
    [SupplyParameterFromForm(FormName = "tag-colours")]
    public string? Action { get; set; }

    private IReadOnlyList<SuggestedGroup> Groups { get; set; } = [];

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var cancel = HttpContext!.RequestAborted;
        var opened = await Editor.OpenAsync(cancel);
        var catalog = Content.Current;
        Groups = TagColourSuggestions.Suggest(Search.Current.GroupTags(catalog.Tags, TagDetails.Colours.Count), opened.Settings);
        if (!HttpMethods.IsPost(HttpContext.Request.Method) || Form is null)
        {
            Form = new TagColoursForm { ETag = opened.ETag };
        }
        else
        {
            // The colours chosen for the groups (T-0144), shown as applying them would change things.
            Groups = TagColourSuggestions.WithColours(Groups, [.. Form.Groups.Select(g => g.Colour)]);
        }
    }

    // The form's submit handler (F-0046): the ticked rows' colours, at the version suggested from.
    private async Task ApplyAsync()
    {
        var cancel = HttpContext!.RequestAborted;
        if (Form is null || Action != "apply")
        {
            return;
        }

        var opened = await Editor.OpenAsync(cancel);
        if (Form.ToChange(opened.Settings, Content.Current.Tags.Keys, out var error) is not { } change)
        {
            (Message, IsError) = (error, true);
            return;
        }

        var result = await Editor.SaveAsync(Form.ETag, change, cancel);
        if (result == SettingsSaveResult.Conflict)
        {
            (Message, IsError) = (T["SettingsConflict"].Value, true);
            return;
        }

        await SavedAsync("tags-changed", "site.json (suggested colours)", "/admin/tags", result);
    }

    private string Count(string tag) =>
        Content.Current.Tags.TryGetValue(tag, out var posts) ? (posts.Count == 1 ? T["PostCountOne"] : T["PostCount", posts.Count]) : "";
}
