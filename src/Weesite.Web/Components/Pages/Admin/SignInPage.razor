@page "/admin/sign-in"
@layout MainLayout
@using Weesite.Web.Admin
@inject IConfiguration Configuration
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["SignInTitle"]</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@* Sign-in for editors (T-0093: the 404 page's layout): one button per configured provider. *@
<section class="status-page" aria-labelledby="sign-in-title">
    <h1 id="sign-in-title" class="page-title">@T["SignInTitle"]</h1>
    @if (Error == "failed")
    {
        <p class="notice" role="alert">@T["SignInFailed"]</p>
    }

    @if (Providers.Count == 0)
    {
        <p class="lede">@T["SignInNoProviders"]</p>
    }
    else
    {
        <p class="lede">@T["SignInIntro"]</p>
        <form class="sign-in status-actions" method="post" action="/admin/sign-in">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@AdminEndpoints.LocalUrl(ReturnUrl)" />
            @foreach (var provider in Providers)
            {
                <button class="btn primary" type="submit" name="provider" value="@provider">@T["SignInWith", provider]</button>
            }
        </form>
    }
</section>

@code {
    /// <summary>Gets or sets where to go after signing in.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    /// <summary>Gets or sets the error, if the last attempt failed.</summary>
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private IReadOnlyList<string> Providers => SignIn.ConfiguredProviders(Configuration);
}
