@page "/admin/menu"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject SiteSettingsEditor Editor
@inject ContentCatalogProvider Content
@inject IAuditLog Audit
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResource> T

@* The site menu (T-0049): admins only. ws-menu-editor adds move buttons; without it, positions order the items. *@
<PageTitle>@T["MenuTitle"]</PageTitle>

<div class="admin-head">
    <h1>@T["MenuTitle"]</h1>
</div>
<p class="admin-intro">@T["MenuIntro", MenuForm.MaxItems]</p>

@if (Message is { } message)
{
    <FormNotice Message="@message" IsError="IsError" FieldId="@Form?.ErrorField?.Id" />
}

@if (Form is not null)
{
    <EditForm Model="Form" FormName="menu" OnSubmit="SaveAsync" method="post" class="form wide menu-form">
        <input type="hidden" name="Form.ETag" value="@Form.ETag" />
        <ws-menu-editor>
            <div class="menu-table">
                <div class="menu-head" aria-hidden="true">
                    <span>#</span><span>@T["MenuLabel"]</span><span>@T["MenuTarget"]</span><span>@T["MenuHref"]</span><span class="order">@T["MenuOrder"]</span>
                </div>
                <ol class="menu-rows" role="list">
                    @for (var i = 0; i < Form.Rows.Count; i++)
                    {
                        var row = i;
                        <li class="menu-row">
                            <fieldset>
                                <legend class="visually-hidden">@T["MenuItem", row + 1]</legend>
                                <span class="num" aria-hidden="true">@(row + 1)</span>
                                <span class="cell">
                                    <label for="menu-label-@row" class="visually-hidden">@T["MenuLabel"]</label>
                                    <input id="menu-label-@row" aria-invalid="@Invalid($"menu-label-{row}")" name="@($"Form.Rows[{row}].Label")" value="@(Form.Rows[row].Label ?? "")" maxlength="40" />
                                </span>
                                <span class="cell">
                                    <label for="menu-target-@row" class="visually-hidden">@T["MenuTarget"]</label>
                                    <select id="menu-target-@row" aria-invalid="@Invalid($"menu-target-{row}")" name="@($"Form.Rows[{row}].Target")">
                                        <option value="" selected="@(string.IsNullOrEmpty(Form.Rows[row].Target))">@T["MenuAddressBelow"]</option>
                                        <option value="@MenuForm.BlogTarget" selected="@(Form.Rows[row].Target == MenuForm.BlogTarget)">@T["Blog"]</option>
                                        @foreach (var item in Content.Current.Pages)
                                        {
                                            <option value="@(MenuForm.PagePrefix + item.Slug)" selected="@(Form.Rows[row].Target == MenuForm.PagePrefix + item.Slug)">@item.Title</option>
                                        }
                                        @if (MissingPage(Form.Rows[row].Target) is { } missing)
                                        {
                                            @* A page that's no longer published keeps its row's target, so saving says which item to fix (F-0076). *@
                                            <option value="@(MenuForm.PagePrefix + missing)" selected>@T["MenuPageNotPublished", missing]</option>
                                        }
                                    </select>
                                </span>
                                <span class="cell">
                                    <label for="menu-href-@row" class="visually-hidden">@T["MenuHref"]</label>
                                    <input id="menu-href-@row" aria-invalid="@Invalid($"menu-href-{row}")" class="mono-input" name="@($"Form.Rows[{row}].Href")" value="@(Form.Rows[row].Href ?? "")" maxlength="300" placeholder="/tags" />
                                </span>
                                <span class="cell menu-position">
                                    <label for="menu-position-@row">@T["MenuPosition"]</label>
                                    <input id="menu-position-@row" name="@($"Form.Rows[{row}].Position")" value="@(Form.Rows[row].Position ?? "")" inputmode="numeric" pattern="[0-9]*" size="3" />
                                </span>
                            </fieldset>
                        </li>
                    }
                </ol>
            </div>
            <section class="menu-preview" aria-labelledby="menu-preview-heading">
                <h2 id="menu-preview-heading" class="side-label">@T["MenuPreview"]</h2>
                <ul role="list">
                    @foreach (var row in Form.Rows.Where(r => !string.IsNullOrWhiteSpace(r.Label)))
                    {
                        <li>@row.Label</li>
                    }
                </ul>
            </section>
        </ws-menu-editor>
        <div class="form-actions">
            <button class="btn primary" type="submit">@T["Save"]</button>
        </div>
    </EditForm>
    <script type="module" src="/@Assets["admin/ws-menu-editor.js"]"></script>
}

@code {
    /// <summary>Gets or sets whether the last action saved.</summary>
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "menu")]
    public MenuForm? Form { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Message { get; set; }

    private bool IsError { get; set; }

    private string? Invalid(string id) => IsError ? FieldError.Invalid(Form?.ErrorField, id) : null;

    // The slug of a row's page when that page isn't published.
    private string? MissingPage(string? target) =>
        target is not null && target.StartsWith(MenuForm.PagePrefix, StringComparison.Ordinal)
        && Content.Current.FindPage(target[MenuForm.PagePrefix.Length..]) is null
            ? target[MenuForm.PagePrefix.Length..]
            : null;

    // Whether the form came from the store rather than a post.
    private bool Loaded { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext!;
        var cancel = context.RequestAborted;
        if (!HttpMethods.IsPost(context.Request.Method) || Form is null)
        {
            Form = MenuForm.From(await Editor.OpenAsync(cancel));
            Message = Saved == "1" ? T["SavedMessage"].Value : null;
            Loaded = true;
        }
    }

    // The form's submit handler. Saving here rather than in OnInitializedAsync means the form has
    // rendered before the redirect, so the redirect stands (F-0046).
    private async Task SaveAsync()
    {
        if (Loaded || Form is null)
        {
            return;
        }

        var context = HttpContext!;
        var cancel = context.RequestAborted;
        var change = Form.ToChange([.. Content.Current.Pages.Select(p => p.Slug)], out var error);
        if (change is null)
        {
            Form.Pad();
            (Message, IsError) = (error, true);
            return;
        }

        if (!await Editor.SaveAsync(Form.ETag, change, cancel))
        {
            Form.Pad();
            (Message, IsError) = (T["SettingsConflict"].Value, true);
            return;
        }

        var actor = context.User.FindFirst(ClaimTypes.Email)?.Value ?? "(unknown)";
        await Audit.WriteAsync(new AuditEntry(Time.GetUtcNow(), actor, "menu-changed", "site.json"), cancel);
        Navigation.NavigateTo("/admin/menu?saved=1");
    }
}
