@page "/admin/settings"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inject SiteSettingsEditor Editor
@inject ContentCatalogProvider Content
@inject IAuditLog Audit
@inject TimeProvider Time
@inject Weesite.Search.SearchIndexProvider Search
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

@* Site settings (T-0049): admins only. Only these keys of site.json change; the rest stays. *@
<PageTitle>@T["SettingsTitle"]</PageTitle>

<div class="admin-head">
    <h1>@T["SettingsTitle"]</h1>
</div>
<p class="admin-intro">@T["SettingsIntro"]</p>

@if (Message is { } message)
{
    <p class="notice" role="@(IsError ? "alert" : "status")">@message</p>
}

@if (Form is not null)
{
    <EditForm Model="Form" FormName="settings" OnSubmit="SaveAsync" method="post" class="form">
        <input type="hidden" name="Form.ETag" value="@Form.ETag" />
        <section class="section" aria-labelledby="identity-heading">
            <h2 id="identity-heading">@T["IdentityHeading"]</h2>
            <div class="grid2">
                <div class="field">
                    <label for="site-name">@T["SiteName"]</label>
                    <InputText id="site-name" @bind-Value="Form.Name" required maxlength="80" />
                </div>
                <div class="field">
                    <label for="tagline">@T["Tagline"]</label>
                    <InputText id="tagline" @bind-Value="Form.Tagline" maxlength="160" />
                </div>
            </div>
            <div class="grid2">
                <div class="field">
                    <label for="language">@T["Language"]</label>
                    <InputText id="language" class="mono-input" @bind-Value="Form.Language" required maxlength="35" aria-describedby="language-help" />
                    <p id="language-help" class="help">@T["LanguageHelp"]</p>
                </div>
                <div class="field">
                    <label for="contact">@T["ContactEmail"]</label>
                    <InputText id="contact" type="email" @bind-Value="Form.ContactEmail" maxlength="254" aria-describedby="contact-help" />
                    <p id="contact-help" class="help">@T["ContactEmailHelp"]</p>
                </div>
            </div>
            <div class="field">
                <label for="date-format">@T["DateFormatLabel"]</label>
                <InputText id="date-format" class="mono-input" @bind-Value="Form.DateFormat" required maxlength="40" aria-describedby="date-format-help" />
                <p id="date-format-help" class="help">@T["DateFormatHelp", Content.Current.Site.FormatDate(DateOnly.FromDateTime(Time.GetUtcNow().UtcDateTime), CultureInfo.CurrentCulture)]</p>
            </div>
            <div class="field">
                <label for="banner">@T["BannerLabel"]</label>
                <InputText id="banner" class="mono-input" @bind-Value="Form.Banner" maxlength="200" aria-describedby="banner-help" />
                <p id="banner-help" class="help">@T["BannerHelp"]</p>
            </div>
            @* The logo (T-0116), and once set, the sizes the sign-in screens take. *@
            <div class="field">
                <label for="logo">@T["LogoLabel"]</label>
                <InputText id="logo" class="mono-input" @bind-Value="Form.Logo" maxlength="200" aria-describedby="logo-help" />
                <p id="logo-help" class="help">@T["LogoHelp"]</p>
                @if (SiteLogo.Name(Content.Current.Site) is { } logo)
                {
                    <p class="help logo-sizes">
                        <img src="@SiteLogo.Icon(logo, 120)" alt="" width="40" height="40" />
                        @T["LogoSignIn"] <a href="@SiteLogo.Icon(logo, 120)" download="logo-120.png">@T["LogoForGoogle"]</a> · <a href="@SiteLogo.Icon(logo, 215)" download="logo-215.png">@T["LogoForMicrosoft"]</a>
                    </p>
                }
            </div>
        </section>
        <fieldset class="section home-settings">
            <legend>@T["HomePageHeading"]</legend>
            <p class="help">@T["HomeShows"]</p>
            <InputRadioGroup @bind-Value="Form.HomeShow">
                <div class="radio-cards">
                    <label><InputRadio Value="@("latest-posts")" /> @T["HomeLatestPosts"]</label>
                    <label><InputRadio Value="@("page")" /> @T["HomePageOnly"]</label>
                    <label><InputRadio Value="@("page-and-posts")" /> @T["HomePageAndPosts"]</label>
                </div>
            </InputRadioGroup>
            @* Shown only for a home page with a page (admin.css, F-0053). *@
            <div class="field home-page-field">
                <label for="home-page">@T["HomePageLabel"]</label>
                <InputSelect id="home-page" @bind-Value="Form.HomePage">
                    <option value="">@T["NoPage"]</option>
                    @foreach (var item in Content.Current.Pages)
                    {
                        <option value="@item.Slug">@item.Title</option>
                    }
                </InputSelect>
            </div>
        </fieldset>
        <fieldset class="section">
            <legend>@T["LegalPagesHeading"]</legend>
            <p class="help">@T["LegalPagesHelp"]</p>
            <div class="grid2">
                <div class="field">
                    <label for="privacy-page">@T["PrivacyPageLabel"]</label>
                    <InputSelect id="privacy-page" @bind-Value="Form.PrivacyPage">
                        <option value="">@T["NoPage"]</option>
                        @foreach (var item in Content.Current.Pages)
                        {
                            <option value="@item.Slug">@item.Title</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="terms-page">@T["TermsPageLabel"]</label>
                    <InputSelect id="terms-page" @bind-Value="Form.TermsPage">
                        <option value="">@T["NoPage"]</option>
                        @foreach (var item in Content.Current.Pages)
                        {
                            <option value="@item.Slug">@item.Title</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </fieldset>
        <fieldset class="section">
            <legend>@T["FooterHeading"]</legend>
            <div class="field">
                <label for="copyright">@T["CopyrightLabel"]</label>
                <InputText id="copyright" @bind-Value="Form.Copyright" maxlength="160" placeholder="@($"© {DateTime.UtcNow.Year} {Content.Current.Site.Name}")" aria-describedby="copyright-help" />
                <p id="copyright-help" class="help">@T["CopyrightHelp"]</p>
            </div>
            <label class="check"><InputCheckbox @bind-Value="Form.ShowBuiltWith" /> @T["ShowBuiltWith"]</label>
        </fieldset>
        <fieldset class="section">
            <legend>@T["SiteLinks"]</legend>
            <p class="help">@T["SiteLinksHelp"]</p>
            <LinkRows Rows="Form.Links" />
        </fieldset>
        <div class="form-actions">
            <button class="btn primary" type="submit">@T["Save"]</button>
        </div>
    </EditForm>
}

@* Re-embed all (T-0069): a request for the re-index job, its own form outside the settings. *@
<section class="section form search-index" aria-labelledby="search-index-heading">
    <h2 id="search-index-heading">@T["SearchIndexHeading"]</h2>
    @if (Reindex == "1")
    {
        <p class="notice" role="status">@T["ReindexRequested"]</p>
    }
    <p>@SearchSummary</p>
    <p class="help">@T["ReindexHelp"]</p>
    <form method="post" action="/admin/search/reindex">
        <AntiforgeryToken />
        <div class="form-actions">
            <button class="btn" type="submit">@T["ReembedAll"]</button>
        </div>
    </form>
</section>

@* The factory reset (T-0100): its own form, typed confirmation, last on the page. *@
<section id="danger-zone" class="section form danger-zone" aria-labelledby="danger-zone-heading">
    <h2 id="danger-zone-heading">@T["DangerZoneHeading"]</h2>
    @if (Reset == "1")
    {
        <p class="notice" role="status">@T["ResetDone"]</p>
    }
    else if (ResetError == "1")
    {
        <p class="notice" role="alert">@T["ResetNotConfirmed"]</p>
    }
    <h3>@T["ResetHeading"]</h3>
    <p>@T["ResetWhat"]</p>
    <p class="help">@T["ResetBefore"] <a href="/admin/backup">@T["BackupTitle"]</a>. @T["ResetRecovery"]</p>
    <form method="post" action="/admin/settings/reset">
        <AntiforgeryToken />
        <div class="field">
            <label for="reset-confirm">@T["ResetConfirmLabel", Content.Current.Site.Name]</label>
            <input id="reset-confirm" name="confirm" type="text" autocomplete="off" spellcheck="false" required aria-describedby="reset-confirm-help" />
            <p id="reset-confirm-help" class="help">@T["ResetConfirmHelp"]</p>
        </div>
        <div class="form-actions">
            <button class="btn danger" type="submit">@T["ResetButton"]</button>
        </div>
    </form>
</section>


@code {
    /// <summary>Gets or sets whether the last action saved.</summary>
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    /// <summary>Gets or sets whether the site was just reset.</summary>
    [SupplyParameterFromQuery(Name = "reset")]
    public string? Reset { get; set; }

    /// <summary>Gets or sets whether a reset wasn't confirmed.</summary>
    [SupplyParameterFromQuery(Name = "resetError")]
    public string? ResetError { get; set; }

    /// <summary>Gets or sets whether a re-index was just requested.</summary>
    [SupplyParameterFromQuery(Name = "reindex")]
    public string? Reindex { get; set; }

    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "settings")]
    public SettingsForm? Form { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? Message { get; set; }

    private bool IsError { get; set; }

    // The index as it is now: chunks, the model, and chunks still waiting for a vector.
    private string SearchSummary
    {
        get
        {
            var index = Search.Current;
            return !index.HasVectors && index.MissingCount == 0
                ? T["SearchIndexKeywordsOnly", index.ChunkCount]
                : index.MissingCount > 0
                    ? T["SearchIndexMissing", index.ChunkCount, Search.ModelId, index.MissingCount]
                    : T["SearchIndexReady", index.ChunkCount, Search.ModelId];
        }
    }

    // Whether the form came from the store rather than a post.
    private bool Loaded { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext!;
        var cancel = context.RequestAborted;
        if (!HttpMethods.IsPost(context.Request.Method) || Form is null)
        {
            Form = SettingsForm.From(await Editor.OpenAsync(cancel));
            Message = Saved == "1" ? T["SavedMessage"].Value : null;
            Loaded = true;
        }
    }

    // The form's submit handler. Saving here rather than in OnInitializedAsync means the form has
    // rendered before the redirect, so the redirect stands (F-0046).
    private async Task SaveAsync()
    {
        if (Loaded || Form is null)
        {
            return;
        }

        var context = HttpContext!;
        var cancel = context.RequestAborted;
        Form.Pad();
        var change = Form.ToChange([.. Content.Current.Pages.Select(p => p.Slug)], Content.Current.Media, out var error);
        if (change is null)
        {
            (Message, IsError) = (error, true);
            return;
        }

        if (!await Editor.SaveAsync(Form.ETag, change, cancel))
        {
            (Message, IsError) = (T["SettingsConflict"].Value, true);
            return;
        }

        var actor = context.User.FindFirst(ClaimTypes.Email)?.Value ?? "(unknown)";
        await Audit.WriteAsync(new AuditEntry(Time.GetUtcNow(), actor, "settings-changed", "site.json"), cancel);
        Navigation.NavigateTo("/admin/settings?saved=1");
    }
}
