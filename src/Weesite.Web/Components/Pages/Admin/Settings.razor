@page "/admin/settings"
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Weesite.Web.Admin
@attribute [Authorize(Policy = EditorClaims.AdminPolicy)]
@inherits AdminFormPage
@inject SiteSettingsEditor Editor
@inject ContentCatalogProvider Content
@inject Weesite.Search.SearchIndexProvider Search
@inject IStringLocalizer<AdminResource> T

@* Site settings (T-0049): admins only. Only these keys of site.json change; the rest stays. *@
<PageTitle>@T["SettingsTitle"]</PageTitle>

<div class="admin-head">
    <h1>@T["SettingsTitle"]</h1>
</div>
<p class="admin-intro">@T["SettingsIntro"]</p>

@if (Message is { } message)
{
    <FormNotice Message="@message" IsError="IsError" FieldId="@Form?.ErrorField?.Id" />
}

@if (Form is not null)
{
    <EditForm Model="Form" FormName="settings" OnSubmit="SaveAsync" method="post" class="form" Context="editContext">
        @{ FieldError.Mark(editContext, Form, IsError ? Form.ErrorField : null, Message); }
        <input type="hidden" name="Form.ETag" value="@Form.ETag" />
        <section class="section" aria-labelledby="identity-heading">
            <h2 id="identity-heading">@T["IdentityHeading"]</h2>
            <div class="grid2">
                <div class="field">
                    <label for="site-name">@T["SiteName"]</label>
                    <InputText id="site-name" @bind-Value="Form.Name" required maxlength="80" />
                </div>
                <div class="field">
                    <label for="tagline">@T["Tagline"]</label>
                    <InputText id="tagline" @bind-Value="Form.Tagline" maxlength="160" />
                </div>
            </div>
            <div class="grid2">
                <div class="field">
                    <label for="language">@T["Language"]</label>
                    <InputText id="language" class="mono-input" @bind-Value="Form.Language" required maxlength="35" aria-describedby="language-help" />
                    <p id="language-help" class="help">@T["LanguageHelp"]</p>
                </div>
                <div class="field">
                    <label for="contact">@T["ContactEmail"]</label>
                    <InputText id="contact" type="email" @bind-Value="Form.ContactEmail" maxlength="254" aria-describedby="contact-help" />
                    <p id="contact-help" class="help">@T["ContactEmailHelp"]</p>
                </div>
            </div>
            <div class="field">
                <label for="date-format">@T["DateFormatLabel"]</label>
                <InputText id="date-format" class="mono-input" @bind-Value="Form.DateFormat" required maxlength="40" aria-describedby="date-format-help" />
                <p id="date-format-help" class="help">@T["DateFormatHelp", Content.Current.Site.FormatDate(Content.Current.Site.DayOf(Time.GetUtcNow()), CultureInfo.CurrentCulture)]</p>
            </div>
            @* Times in the admin, the digests and the analytics (T-0157); stored times stay UTC. *@
            <div class="grid2">
                <div class="field">
                    <label for="time-zone">@T["TimeZoneLabel"]</label>
                    <InputSelect id="time-zone" @bind-Value="Form.TimeZone" aria-describedby="time-zone-help">
                        @foreach (var zone in SiteTime.Names())
                        {
                            <option value="@zone">@ZoneLabel(zone)</option>
                        }
                    </InputSelect>
                    <p id="time-zone-help" class="help">@T["TimeZoneHelp", Content.Current.Site.FormatTime(Time.GetUtcNow())]</p>
                </div>
                <div class="field">
                    <label for="clock">@T["ClockLabel"]</label>
                    <InputSelect id="clock" @bind-Value="Form.Clock" aria-describedby="clock-help">
                        <option value="@SiteTime.Clock24">@T["Clock24"]</option>
                        <option value="@SiteTime.Clock12">@T["Clock12"]</option>
                    </InputSelect>
                    <p id="clock-help" class="help">@T["ClockHelp"]</p>
                </div>
            </div>
            <div class="field">
                <label for="banner">@T["BannerLabel"]</label>
                <InputText id="banner" class="mono-input" @bind-Value="Form.Banner" maxlength="200" aria-describedby="banner-help" />
                <p id="banner-help" class="help">@T["BannerHelp"]</p>
            </div>
            @* The logo (T-0116), and once set, the sizes the sign-in screens take. *@
            <div class="field">
                <label for="logo">@T["LogoLabel"]</label>
                <InputText id="logo" class="mono-input" @bind-Value="Form.Logo" maxlength="200" aria-describedby="logo-help" />
                <p id="logo-help" class="help">@T["LogoHelp"]</p>
                @if (SiteLogo.Name(Content.Current.Site) is { } logo)
                {
                    <p class="help logo-sizes">
                        <img src="@SiteLogo.Icon(logo, 120)" alt="" width="40" height="40" />
                        @T["LogoSignIn"] <a href="@SiteLogo.Icon(logo, 120)" download="logo-120.png">@T["LogoForGoogle"]</a> · <a href="@SiteLogo.Icon(logo, 215)" download="logo-215.png">@T["LogoForMicrosoft"]</a>
                    </p>
                }
            </div>
            @* The tab and home-screen icon (T-0118), for a logo that doesn't work small. *@
            <div class="field">
                <label for="favicon">@T["FaviconLabel"]</label>
                <InputText id="favicon" class="mono-input" @bind-Value="Form.Favicon" maxlength="200" aria-describedby="favicon-help" />
                <p id="favicon-help" class="help">@T["FaviconHelp"]</p>
            </div>
        </section>
        <fieldset class="section home-settings" id="home-shows">
            <legend>@T["HomePageHeading"]</legend>
            <p class="help">@T["HomeShows"]</p>
            <InputRadioGroup @bind-Value="Form.HomeShow">
                <div class="radio-cards">
                    <label><InputRadio Value="@("latest-posts")" /> @T["HomeLatestPosts"]</label>
                    <label><InputRadio Value="@("page")" /> @T["HomePageOnly"]</label>
                    <label><InputRadio Value="@("page-and-posts")" /> @T["HomePageAndPosts"]</label>
                </div>
            </InputRadioGroup>
            @* Shown only for a home page with a page (admin.css, F-0053). *@
            <div class="field home-page-field">
                <label for="home-page">@T["HomePageLabel"]</label>
                <InputSelect id="home-page" @bind-Value="Form.HomePage">
                    <option value="">@T["NoPage"]</option>
                    @foreach (var item in Content.Current.Pages)
                    {
                        <option value="@item.Slug">@item.Title</option>
                    }
                </InputSelect>
            </div>
            <div class="field">
                <label for="home-title">@T["HomeTitleLabel"]</label>
                <InputText id="home-title" @bind-Value="Form.HomeTitle" maxlength="80" aria-describedby="home-title-help" />
                <p id="home-title-help" class="help">@T["HomeTitleHelp", Content.Current.Site.Name]</p>
            </div>
            @* The round frame's photo (T-0117), whatever the home page shows. *@
            <div class="field">
                <label for="home-photo">@T["HomePhotoLabel"]</label>
                <InputText id="home-photo" class="mono-input" @bind-Value="Form.HomePhoto" maxlength="200" aria-describedby="home-photo-help" />
                <p id="home-photo-help" class="help">@T["HomePhotoHelp"]</p>
            </div>
        </fieldset>
        <fieldset class="section">
            <legend>@T["LegalPagesHeading"]</legend>
            <p class="help">@T["LegalPagesHelp"]</p>
            <div class="grid2">
                <div class="field">
                    <label for="privacy-page">@T["PrivacyPageLabel"]</label>
                    <InputSelect id="privacy-page" @bind-Value="Form.PrivacyPage">
                        <option value="">@T["NoPage"]</option>
                        @foreach (var item in Content.Current.Pages)
                        {
                            <option value="@item.Slug">@item.Title</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="terms-page">@T["TermsPageLabel"]</label>
                    <InputSelect id="terms-page" @bind-Value="Form.TermsPage">
                        <option value="">@T["NoPage"]</option>
                        @foreach (var item in Content.Current.Pages)
                        {
                            <option value="@item.Slug">@item.Title</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </fieldset>
        <fieldset class="section">
            <legend>@T["FooterHeading"]</legend>
            <div class="field">
                <label for="copyright">@T["CopyrightLabel"]</label>
                <InputText id="copyright" @bind-Value="Form.Copyright" maxlength="160" placeholder="@($"© {DateTime.UtcNow.Year} {Content.Current.Site.Name}")" aria-describedby="copyright-help" />
                <p id="copyright-help" class="help">@T["CopyrightHelp"]</p>
            </div>
            <label class="check"><InputCheckbox @bind-Value="Form.ShowBuiltWith" /> @T["ShowBuiltWith"]</label>
        </fieldset>
        @* Visitor countries in the analytics (T-0143), on unless turned off here. *@
        <fieldset class="section">
            <legend>@T["AnalyticsTitle"]</legend>
            <label class="check"><InputCheckbox id="visitor-countries" @bind-Value="Form.VisitorCountries" aria-describedby="visitor-countries-help" /> @T["VisitorCountriesLabel"]</label>
            <p id="visitor-countries-help" class="help">@T["VisitorCountriesHelp"]</p>
        </fieldset>
        @* Reactions to posts (ADR 0011), off unless turned on here. *@
        <fieldset class="section">
            <legend>@T["ReactionsTitle"]</legend>
            <label class="check"><InputCheckbox id="reactions" @bind-Value="Form.Reactions" aria-describedby="reactions-help" /> @T["ReactionsLabel"]</label>
            <p id="reactions-help" class="help">@T["ReactionsHelp"]</p>
        </fieldset>
        @* Comments on posts (ADR 0011), off unless turned on here; moderated under Comments. *@
        <fieldset class="section">
            <legend>@T["CommentsTitle"]</legend>
            <label class="check"><InputCheckbox id="comments" @bind-Value="Form.Comments" aria-describedby="comments-help" /> @T["CommentsLabel"]</label>
            <p id="comments-help" class="help">@T["CommentsHelp"]</p>
        </fieldset>
        <fieldset class="section">
            <legend>@T["SearchEnginesTitle"]</legend>
            <label class="check"><InputCheckbox id="index-now" @bind-Value="Form.IndexNow" aria-describedby="index-now-help" /> @T["IndexNowLabel"]</label>
            <p id="index-now-help" class="help">@T["IndexNowHelp"]</p>
            @if (Content.Current.Site.IndexNowKey is { } indexNowKey)
            {
                <p class="help">@T["IndexNowKey"] <a href="/@(indexNowKey).txt"><code>@indexNowKey</code></a></p>
            }
        </fieldset>
        @* The contact form (ADR 0011): /contact, the page above it, and where messages go (never shown on the site). *@
        <fieldset class="section">
            <legend>@T["ContactFormHeading"]</legend>
            <label class="check"><InputCheckbox id="contact-form" @bind-Value="Form.ContactFormEnabled" aria-describedby="contact-form-help" /> @T["ContactFormLabel"]</label>
            <p id="contact-form-help" class="help">@T["ContactFormHelp"]</p>
            <div class="grid2">
                <div class="field">
                    <label for="contact-page">@T["ContactFormPageLabel"]</label>
                    <InputSelect id="contact-page" @bind-Value="Form.ContactFormPage" aria-describedby="contact-page-help">
                        <option value="">@T["NoPage"]</option>
                        @foreach (var item in Content.Current.Pages)
                        {
                            <option value="@item.Slug">@item.Title</option>
                        }
                    </InputSelect>
                    <p id="contact-page-help" class="help">@T["ContactFormPageHelp"]</p>
                </div>
                <div class="field">
                    <label for="contact-recipient">@T["ContactFormRecipientLabel"]</label>
                    <InputText id="contact-recipient" type="email" @bind-Value="Form.ContactFormRecipient" maxlength="254" autocomplete="email" aria-describedby="contact-recipient-help" />
                    <p id="contact-recipient-help" class="help">@T["ContactFormRecipientHelp"]</p>
                </div>
            </div>
        </fieldset>
        <fieldset class="section">
            <legend>@T["SiteLinks"]</legend>
            <p class="help">@T["SiteLinksHelp"]</p>
            <LinkRows Rows="Form.Links" Invalid="@(IsError ? Form.ErrorField : null)" />
        </fieldset>
        <div class="form-actions">
            <button class="btn primary" type="submit">@T["Save"]</button>
        </div>
    </EditForm>
}

@* Re-embed all (T-0069): a request for the re-index job, its own form outside the settings. *@
<section class="section form search-index" aria-labelledby="search-index-heading">
    <h2 id="search-index-heading">@T["SearchIndexHeading"]</h2>
    @if (Reindex == "1")
    {
        <p class="notice" role="status">@T["ReindexRequested"]</p>
    }
    else if (Reindex == "waiting")
    {
        <p class="notice" role="status">@T["ReindexAlreadyWaiting"]</p>
    }
    <p>@SearchSummary</p>
    @* When it was last asked for, from the audit log (F-0091 L30); the summary above counts what's still waiting. *@
    @if (LastReindex is { } last)
    {
        <p class="help">@T["ReindexLast", Content.Current.Site.FormatTime(seconds: true, at: last.At), last.Actor]</p>
    }
    <p class="help">@T["ReindexHelp"]</p>
    <form method="post" action="/admin/search/reindex">
        <AntiforgeryToken />
        <div class="form-actions">
            <button class="btn" type="submit">@T["ReembedAll"]</button>
        </div>
    </form>
</section>

@* The factory reset (T-0100): its own form, typed confirmation, last on the page. *@
<section id="danger-zone" class="section form danger-zone" aria-labelledby="danger-zone-heading">
    <h2 id="danger-zone-heading">@T["DangerZoneHeading"]</h2>
    @if (Reset == "1")
    {
        <p class="notice" role="status">@T["ResetDone"]</p>
    }
    else if (ResetError == "1")
    {
        <p class="notice" role="alert">@T["ResetNotConfirmed"]</p>
    }
    <h3>@T["ResetHeading"]</h3>
    <p>@T["ResetWhat"]</p>
    <p class="help">@T["ResetBefore"] <a href="/admin/backup">@T["BackupTitle"]</a>. @T["ResetRecovery"]</p>
    <form method="post" action="/admin/settings/reset">
        <AntiforgeryToken />
        <div class="field typed-confirm">
            <label for="reset-confirm">@T["ResetConfirmLabel", Content.Current.Site.Name]</label>
            <div class="copy-row">
                <input id="reset-confirm" name="confirm" type="text" autocomplete="off" spellcheck="false" required aria-describedby="reset-confirm-help" />
                <button class="btn small" type="button" data-copy="reset-confirm-text" aria-label="@T["CopyConfirmText", Content.Current.Site.Name]" hidden>@T["Copy"]</button>
            </div>
            <span id="reset-confirm-text" hidden>@(Content.Current.Site.Name)</span>
            <p id="reset-confirm-help" class="help">@T["ResetConfirmHelp"]</p>
            <p class="copy-status" role="status"></p>
        </div>
        <div class="form-actions">
            <button class="btn danger" type="submit">@T["ResetButton"]</button>
        </div>
    </form>
</section>

<script type="module" src="/@Assets["admin/typed-confirm.js"]"></script>

@code {
    // A zone as the list shows it: its name and its offset now, such as Europe/Budapest (UTC+01:00).
    private string ZoneLabel(string zone)
    {
        if (zone == "UTC")
        {
            return T["TimeZoneUtc"];
        }

        var offset = SiteTime.Zone(zone).GetUtcOffset(Time.GetUtcNow());
        var sign = offset < TimeSpan.Zero ? "-" : "+";
        return $"{zone.Replace('_', ' ')} (UTC{sign}{offset.Duration():hh\\:mm})";
    }

    /// <summary>Gets or sets whether the last action saved.</summary>
    /// <summary>Gets or sets whether the site was just reset.</summary>
    [SupplyParameterFromQuery(Name = "reset")]
    public string? Reset { get; set; }

    /// <summary>Gets or sets whether a reset wasn't confirmed.</summary>
    [SupplyParameterFromQuery(Name = "resetError")]
    public string? ResetError { get; set; }

    /// <summary>Gets or sets whether a re-index was just requested.</summary>
    [SupplyParameterFromQuery(Name = "reindex")]
    public string? Reindex { get; set; }

    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "settings")]
    public SettingsForm? Form { get; set; }

    // The last "Re-embed all" among the recent audit entries, if any.
    private AuditEntry? LastReindex { get; set; }

    // The index as it is now: chunks, the model, and chunks still waiting for a vector.
    private string SearchSummary
    {
        get
        {
            var index = Search.Current;

            // An empty index has no vectors either; that isn't a missing model (F-0091 L24).
            return index.ChunkCount == 0
                ? T["SearchIndexEmpty"]
                : !index.HasVectors && index.MissingCount == 0
                ? T["SearchIndexKeywordsOnly", index.ChunkCount]
                : index.MissingCount > 0
                    ? T["SearchIndexMissing", index.ChunkCount, Search.ModelId, index.MissingCount]
                    : T["SearchIndexReady", index.ChunkCount, Search.ModelId];
        }
    }

    // Whether the form came from the store rather than a post.
    private bool Loaded { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        var context = HttpContext!;
        var cancel = context.RequestAborted;
        LastReindex = (await Audit.LatestAsync(200, cancel)).FirstOrDefault(e => e.Action == "reindex-requested");
        if (!HttpMethods.IsPost(context.Request.Method) || Form is null)
        {
            Form = SettingsForm.From(await Editor.OpenAsync(cancel));
            TakeSaved(T["SavedMessage"].Value, T["SavedUnchanged"].Value);
            Loaded = true;
        }
    }

    // The form's submit handler. Saving here rather than in OnInitializedAsync means the form has
    // rendered before the redirect, so the redirect stands (F-0046).
    private async Task SaveAsync()
    {
        if (Loaded || Form is null)
        {
            return;
        }

        var context = HttpContext!;
        var cancel = context.RequestAborted;
        Form.Pad();
        var change = Form.ToChange([.. Content.Current.Pages.Select(p => p.Slug)], Content.Current.Media, out var error);
        if (change is null)
        {
            (Message, IsError) = (error, true);
            return;
        }

        var result = await Editor.SaveAsync(Form.ETag, change, cancel);
        if (result == SettingsSaveResult.Conflict)
        {
            (Message, IsError) = (T["SettingsConflict"].Value, true);
            return;
        }

        await SavedAsync("settings-changed", "site.json", "/admin/settings", result);
    }
}
