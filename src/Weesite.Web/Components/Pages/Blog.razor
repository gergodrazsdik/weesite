@page "/blog"
@inject ContentCatalogProvider Content
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Blog"] · @Content.Current.Site.Name</PageTitle>
<PageMeta Title="@T["Blog"]" />

<p class="crumbs">@T["BlogKicker"]</p>
<h1 class="page-title">@T["Blog"]</h1>
<div class="columns">
    <section class="main" aria-label="@T["PostsLabel"]">
        <PostRows Posts="Content.Current.Posts" />
        <div class="list-foot">
            <span>
                @if (Content.Current.Tags.Count > 0)
                {
                    <a href="/blog/tags">@T["AllTags"]</a><span> · </span>
                }
                @T["Subscribe"] <a href="/feed.xml">Atom</a>, <a href="/feed.json">JSON Feed</a>
            </span>
            <span>@(Content.Current.Posts.Count == 1 ? T["PostCountOne"] : T["PostCount", Content.Current.Posts.Count])</span>
        </div>
    </section>
    <aside aria-label="@T["Sidebar"]">
        <TagSidebar Heading="@T["Tags"]" />
        <SubscribeBox Text="@T["SubscribeSite"]" />
    </aside>
</div>
