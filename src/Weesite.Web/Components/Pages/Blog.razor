@page "/blog"
@inject ContentCatalogProvider Content
@inject IStringLocalizer<SharedResource> T

<PageTitle>@T["Blog"] · @Content.Current.Site.Name</PageTitle>
<PageMeta Title="@T["Blog"]" />

<h1>@T["Blog"]</h1>
<PostList Posts="Content.Current.Posts" HeadingLevel="2" />
<p>
    @if (Content.Current.Tags.Count > 0)
    {
        <a href="/blog/tags">@T["AllTags"]</a><span> · </span>
    }
    @T["Subscribe"] <a href="/feed.xml">Atom</a>, <a href="/feed.json">JSON Feed</a>
</p>
