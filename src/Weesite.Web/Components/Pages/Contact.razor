@page "/contact"
@using Weesite.Web.Admin
@using Weesite.Web.Visitors
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject ContactInbox Inbox
@inject Weesite.Web.Seo.SiteUrls Urls
@inject IStringLocalizer<PublicResource> T

@* The contact form (ADR 0011): the page chosen in Site settings, then the form, which works
without JavaScript; contact-form.js adds the invisible proof of work. With the form off, /contact
is the content page at that address, if there is one. The form's antiforgery token makes the
response no-store, so the cache never keeps it. *@
@if (Form is not null && Settings is { IsOn: true })
{
    <PageTitle>@Title · @Content.Current.Site.Name</PageTitle>
    <PageMeta Title="@Title" Item="Intro" />

    <div class="contact-page">
        @if (Intro is { } intro)
        {
            <PageArticle Item="intro" />
        }
        else
        {
            <h1 id="page-title" class="page-title">@Title</h1>
        }

        <section class="contact-form-section" aria-labelledby="contact-form-heading">
            <h2 id="contact-form-heading">@T["ContactFormHeading"]</h2>
            @if (Error is { } error)
            {
                <p class="notice error" role="alert">@error@if (ErrorField is { } field)
                    {
                        @(" ")<a href="#@field.Id">@T["ContactGoToField"]</a>
                    }</p>
            }
            else if (Sent == "1")
            {
                <p class="notice" role="status">@T["ContactSent"]</p>
            }

            <EditForm Model="Form" FormName="contact" OnSubmit="SendAsync" method="post" class="contact-form" Context="editContext" data-contact-form>
                @{ FieldError.Mark(editContext, Form, ErrorField, Error); }
                <input type="hidden" name="@ContactInbox.TokenField" value="@Inbox.Token()" />
                @* Always empty: an answer works once, so each page gets a new one (contact-form.js). *@
                <input type="hidden" name="@ContactInbox.ProofField" value="" />
                <div class="field">
                    <label for="contact-name">@T["ContactName"]</label>
                    <InputText id="contact-name" @bind-Value="Form.Name" required maxlength="@ContactInbox.NameMax" autocomplete="name" />
                </div>
                <div class="field">
                    <label for="contact-email">@T["ContactEmail"]</label>
                    <InputText id="contact-email" type="email" @bind-Value="Form.Email" required maxlength="@ContactInbox.EmailMax" autocomplete="email" aria-describedby="contact-email-help" />
                    <p id="contact-email-help" class="help">@T["ContactEmailHelp"]</p>
                </div>
                <div class="field">
                    <label for="contact-message">@T["ContactMessage"]</label>
                    <InputTextArea id="contact-message" @bind-Value="Form.Message" required rows="8" maxlength="@ContactInbox.MessageMax" aria-describedby="contact-message-help" />
                    <p id="contact-message-help" class="help">@T["ContactMessageHelp", ContactInbox.MessageMax]</p>
                </div>
                @* The honeypot (ADR 0011): hidden with display: none (site.css), so neither the tab
                order nor screen readers reach it; a bot that fills every field fills it too. *@
                <div class="field contact-extra">
                    <label for="contact-website">@T["ContactLeaveEmpty"]</label>
                    <input id="contact-website" name="@FormGuard.HoneypotField" type="text" value="" tabindex="-1" autocomplete="off" />
                </div>
                <p class="help">
                    @T["ContactPrivacy"]
                    @if (PrivacyPage is { } privacy)
                    {
                        @(" ")<a href="@Weesite.Web.Seo.ContentUrls.PathOf(privacy)">@T["ContactPrivacyLink"]</a>
                    }
                </p>
                <div class="form-actions">
                    <button class="btn primary" type="submit">@T["ContactSend"]</button>
                    <span class="proof-status" role="status" data-proof-status data-waiting="@T["ContactWaiting"]"></span>
                </div>
            </EditForm>
        </section>
    </div>
    <script type="module" src="/@Assets["contact-form.js"]"></script>
}
else if (Gone)
{
    <GonePage />
}
else if (Page is { } contentPage)
{
    <PageTitle>@contentPage.Title · @Content.Current.Site.Name</PageTitle>
    <PageMeta Title="@contentPage.Title" Item="contentPage" />

    <PageArticle Item="contentPage" Url="@(HttpContext is { } context ? Urls.Origin(context.Request) + Weesite.Web.Seo.ContentUrls.PathOf(contentPage) : null)" />
    <script type="module" src="/@Assets["copy-code.js"]"></script>
    <script type="module" src="/@Assets["article.js"]"></script>
}

@code {
    /// <summary>Gets or sets whether a message was just sent.</summary>
    [SupplyParameterFromQuery(Name = "sent")]
    public string? Sent { get; set; }

    /// <summary>Gets or sets the posted form.</summary>
    [SupplyParameterFromForm(FormName = "contact")]
    public ContactFormModel? Form { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ContactFormSettings? Settings => Content.Current.Site.ContactForm;

    // The page above the form, if Site settings chose one and it's published.
    private ContentItem? Intro => Settings?.Page is { } slug ? Content.Current.FindPage(slug) : null;

    private string Title => Intro?.Title ?? T["ContactTitle"];

    private ContentItem? PrivacyPage => Content.Current.Site.PrivacyPage is { } slug ? Content.Current.FindPage(slug) : null;

    // With the form off: the content page at /contact, if there is one.
    private ContentItem? Page { get; set; }

    private bool Gone { get; set; }

    private string? Error { get; set; }

    // The field the error is about, if any: Blazor's inputs mark it invalid (FieldError.Mark).
    private FieldError? ErrorField { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Settings is { IsOn: true })
        {
            Form ??= new ContactFormModel();
            return;
        }

        Page = Content.Current.FindPage(SettingsForm.ContactPageSlug);
        if (Page is null && Content.Current.IsArchived(ContentKind.Page, SettingsForm.ContactPageSlug) && HttpContext is { } gone)
        {
            gone.Response.StatusCode = StatusCodes.Status410Gone;
            Gone = true;
        }
        else if (Page is null)
        {
            Navigation.NotFound();
        }
    }

    // The form's submit handler: the redirect stands because the form has rendered (F-0046).
    private async Task SendAsync()
    {
        if (Form is null || HttpContext is not { } context || Settings is not { IsOn: true })
        {
            return;
        }

        var result = await Inbox.ReceiveAsync(context, Form, context.RequestAborted);
        (Error, ErrorField) = result.Outcome switch
        {
            ContactOutcome.Sent or ContactOutcome.Pretended => (null, null),
            ContactOutcome.TooFast => (T["ContactTooFast"].Value, null),
            ContactOutcome.Expired => (T["ContactExpired"].Value, null),
            ContactOutcome.Invalid => (T["ContactInvalid"].Value, null),
            ContactOutcome.TooMany => (T["ContactTooMany"].Value, null),
            ContactOutcome.BadName => (result.Problem switch
            {
                TextProblem.Empty => T["ContactNameMissing"].Value,
                TextProblem.TooLong => T["ContactNameTooLong", ContactInbox.NameMax].Value,
                _ => T["ContactNamePlain"].Value,
            }, new FieldError("contact-name", nameof(ContactFormModel.Name))),
            ContactOutcome.BadEmail => (T["ContactEmailInvalid"].Value, new FieldError("contact-email", nameof(ContactFormModel.Email))),
            _ => (result.Problem switch
            {
                TextProblem.Empty => T["ContactMessageMissing"].Value,
                TextProblem.TooLong => T["ContactMessageTooLong", ContactInbox.MessageMax].Value,
                TextProblem.Markup => T["ContactMessageMarkup"].Value,
                _ => T["ContactMessageLinks", VisitorText.MaxLinks].Value,
            }, new FieldError("contact-message", nameof(ContactFormModel.Message))),
        };

        if (Error is null)
        {
            Navigation.NavigateTo("/contact?sent=1");
        }
    }
}
