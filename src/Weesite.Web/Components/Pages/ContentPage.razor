@page "/{Slug}"
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation

@if (Item is { } item)
{
    <PageTitle>@item.Title · @Content.Current.Site.Name</PageTitle>
    <PageMeta Title="@item.Title" Item="item" />

    @* A content page (ADR 0006): the title, the summary as a lede, the text. *@
    <article class="page" aria-labelledby="page-title">
        <h1 id="page-title" class="page-title">@item.Title</h1>
        @if (item.Summary is { } summary)
        {
            <p class="lede">@summary</p>
        }
        <div class="content">
            @((MarkupString)item.Html)
        </div>
    </article>
    <script type="module" src="@Assets["copy-code.js"]"></script>
}

@code {
    /// <summary>Gets or sets the page's slug.</summary>
    [Parameter]
    public string Slug { get; set; } = "";

    private ContentItem? Item { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Item = Content.Current.FindPage(Slug);
        if (Item is null)
        {
            Navigation.NotFound();
        }
    }
}
