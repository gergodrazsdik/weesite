@using Weesite.Web.Theming
@inject IStringLocalizer<SharedResource> T

@* The page buttons and count for reading mode as pages (T-0114), right after the article they
turn. Rendered hidden, with the words in the site's language; reading-pages.js shows it where the
pages are side by side and there's more than one. Without scripts the pages scroll sideways. *@
@if (ReadingPreference.IsOn(HttpContext))
{
    <nav class="reading-pages" aria-label="@T["PagesLabel"]" hidden data-status="@T["PageOf"]">
        <button type="button" data-turn="-1"><span aria-hidden="true">←</span> @T["PreviousPage"]</button>
        <span role="status" aria-live="polite"></span>
        <button type="button" data-turn="1">@T["NextPage"] <span aria-hidden="true">→</span></button>
    </nav>
    <script type="module" src="/@Assets["reading-pages.js"]"></script>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
