@inject IStringLocalizer<PublicResource> T
@inject ContentCatalogProvider Content

@* A content page's body (ADR 0006): the title, the summary as a lede, the text. The public page and
the editors' preview of an unpublished page both render it. *@
<article class="page" aria-labelledby="page-title" lang="@SiteCulture.LangOf(Item, Content.Current.Site)">
    <h1 id="page-title" class="page-title">@Item.Title</h1>
    @if (Item.Summary is { } summary)
    {
        <p class="lede">@summary</p>
    }
    <div class="content" data-copy="@T["CodeCopy"]" data-copied="@T["CodeCopied"]" data-copied-status="@T["CodeCopiedStatus"]" data-copy-failed="@T["CodeCopyFailed"]" data-copy-failed-status="@T["CodeCopyFailedStatus"]" data-heading-link="@T["HeadingLink"]" data-enlarge="@T["ImageEnlarge"]" data-close="@T["Close"]">
        @((MarkupString)Item.Html)
    </div>
    @if (Url is { } url)
    {
        @* On paper, where the page came from (F-0144); hidden on screen. *@
        <p class="print-address">@T["PrintAddress"] <a href="@url">@url</a></p>
    }
</article>

@code {
    /// <summary>Gets or sets the page.</summary>
    [Parameter, EditorRequired]
    public ContentItem Item { get; set; } = default!;

    /// <summary>Gets or sets the page's absolute address, printed under it; null for none (a preview).</summary>
    [Parameter]
    public string? Url { get; set; }
}
