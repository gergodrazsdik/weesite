@preservewhitespace true
@inject ContentCatalogProvider Content
@inject IStringLocalizer<PublicResource> T

@* A post's page body (ADR 0006): breadcrumbs, title and meta, the text, tags, the author, older and
newer posts; beside it the contents and related posts (under it on phones). The public post page
and the editors' preview of an unpublished post both render it. *@
<div class="article-layout">
    <article class="post" aria-labelledby="post-title">
        <div class="crumbs-bar">
            <nav class="crumbs" aria-label="@T["Breadcrumbs"]">
                <a href="/blog">blog</a> /
                @if (Item.Date is { } year)
                {
                    <a href="/blog#y@(year.Year)">@year.Year</a> <span>/</span>
                }
                <span aria-current="page">@Item.Slug</span>
            </nav>
            @if (ShareUrl is not null)
            {
                @* A second Share at the top (F-0122): it opens the same dialog as the one under the
                tags; share.js shows it. *@
                <button type="button" class="btn small share-top" data-share-open aria-haspopup="dialog" hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path></svg>@T["Share"]</button>
            }
        </div>
        <h1 id="post-title" class="page-title" lang="@SiteCulture.LangOf(Item, Content.Current.Site)">@Item.Title</h1>
        <div class="meta-bar">
        <p class="post-meta">
            @if (Item.Date is { } date)
            {
                <time datetime="@ContentDates.Iso(date)">@ContentDates.Display(date, Content.Current.Site)</time>
            }
            @if (Author is { } author)
            {
                <span>@T["By"] @author.Name</span>
            }
            <span>@T["ReadingTime", Item.ReadingMinutes]</span>
            @if (Item.Updated is { } updated)
            {
                <span>@T["Updated"] <time datetime="@ContentDates.Iso(updated)">@ContentDates.Display(updated, Content.Current.Site)</time></span>
            }
        </p>
        @if (Contents.Count >= 2)
        {
            @* The contents at the top too (F-0133): a closed list to open on wider screens, a plain
            list on phones, where the side column comes after the text. Not a landmark: the side
            column's list is "On this page". *@
            <details class="toc-top wide">
                <summary>@T["OnThisPage"]</summary>
                @ContentsList
            </details>
        }
        </div>
        @if (Contents.Count >= 2)
        {
            <div class="toc-top narrow">
                <p class="side-label">@T["OnThisPage"]</p>
                @ContentsList
            </div>
        }
        <div class="content lead" lang="@SiteCulture.LangOf(Item, Content.Current.Site)" data-copy="@T["CodeCopy"]" data-copied="@T["CodeCopied"]" data-copied-status="@T["CodeCopiedStatus"]" data-copy-failed="@T["CodeCopyFailed"]" data-copy-failed-status="@T["CodeCopyFailedStatus"]" data-heading-link="@T["HeadingLink"]" data-enlarge="@T["ImageEnlarge"]" data-close="@T["Close"]">
            @((MarkupString)Item.Html)
        </div>
        @if (Item.Tags.Count > 0)
        {
            <h2 class="visually-hidden">@T["Tags"]</h2>
            <ul class="post-tags" role="list">
                @foreach (var tag in Item.Tags)
                {
                    <li><TagLabel Tag="@tag" /></li>
                }
            </ul>
        }
        @if (ShareUrl is { } shareUrl)
        {
            <ShareButton Title="@Item.Title" Url="@shareUrl" />
        }
        @if (Author is { } writer && (writer.Bio is not null || writer.Links.Count > 0))
        {
            <section class="author-card" aria-labelledby="about-author">
                <span class="initials" aria-hidden="true">@Initials(writer.Name)</span>
                <div>
                    <h2 id="about-author">@T["AboutAuthor", writer.Name]</h2>
                    @if (writer.Bio is { } bio)
                    {
                        <p>@bio</p>
                    }
                    @if (writer.Links.Count > 0)
                    {
                        <ul class="author-links" role="list">
                            @foreach (var link in writer.Links)
                            {
                                <li><a href="@link.Address" rel="me noopener" target="_blank">@link.Label <span aria-hidden="true">↗</span><span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a></li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }
        @if (Older is not null || Newer is not null)
        {
            <nav class="pager" aria-label="@T["OlderAndNewer"]">
                @if (Older is { } older)
                {
                    <a href="@ContentUrls.PathOf(older)" rel="prev"><span><span aria-hidden="true">← </span>@T["OlderPost"]</span><span lang="@SiteCulture.LangOf(older, Content.Current.Site)">@older.Title</span></a>
                }
                @if (Newer is { } newer)
                {
                    <a class="newer" href="@ContentUrls.PathOf(newer)" rel="next"><span>@T["NewerPost"]<span aria-hidden="true"> →</span></span><span lang="@SiteCulture.LangOf(newer, Content.Current.Site)">@newer.Title</span></a>
                }
            </nav>
        }
        @if (Item.ReadingMinutes >= 3)
        {
            @* A long post's way back up, on phones above all (F-0134). *@
            <p class="back-to-top"><a href="#main">@T["BackToTop"]<span aria-hidden="true"> ↑</span></a></p>
        }
    </article>
    <aside aria-label="@T["AboutThisPost"]">
        @if (Contents.Count >= 2)
        {
            <nav class="toc-side" aria-labelledby="contents-heading">
                <h2 id="contents-heading" class="side-label">@T["OnThisPage"]</h2>
                <ol class="toc" role="list">
                    @foreach (var (id, text) in Contents)
                    {
                        <li><a href="#@id">@text</a></li>
                    }
                </ol>
            </nav>
        }
        @if (Related.Count > 0)
        {
            <section class="related" aria-labelledby="related-posts">
                <h2 id="related-posts" class="side-label">@T["RelatedPosts"]</h2>
                <ul class="mini-list" role="list">
                    @foreach (var item in Related)
                    {
                        <li>
                            <a href="@ContentUrls.PathOf(item)" lang="@SiteCulture.LangOf(item, Content.Current.Site)">@item.Title</a>
                            @if (item.Date is { } relatedDate)
                            {
                                <time datetime="@ContentDates.Iso(relatedDate)">@ContentDates.Display(relatedDate, Content.Current.Site)</time>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </aside>
</div>

@code {
    /// <summary>Gets or sets the post.</summary>
    [Parameter, EditorRequired]
    public ContentItem Item { get; set; } = default!;

    /// <summary>Gets or sets the headings for "On this page".</summary>
    [Parameter]
    public IReadOnlyList<(string Id, string Text)> Contents { get; set; } = [];

    /// <summary>Gets or sets the related posts.</summary>
    [Parameter]
    public IReadOnlyList<ContentItem> Related { get; set; } = [];

    /// <summary>Gets or sets the next older post, if any.</summary>
    [Parameter]
    public ContentItem? Older { get; set; }

    /// <summary>Gets or sets the next newer post, if any.</summary>
    [Parameter]
    public ContentItem? Newer { get; set; }

    /// <summary>Gets or sets the post's absolute address for the Share button; null for none (a preview).</summary>
    [Parameter]
    public string? ShareUrl { get; set; }

    private RenderFragment ContentsList => @<ol class="toc" role="list">
        @foreach (var (id, text) in Contents)
        {
            <li><a href="#@id">@text</a></li>
        }
    </ol>;

    private Author? Author => Content.Current.Site.FindAuthor(Item.AuthorId);

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
