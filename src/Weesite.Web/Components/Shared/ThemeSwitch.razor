@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> T

@* System/Light/Dark: a form post that sets a cookie, so it works without JavaScript. *@
<form class="theme-switch" method="post" action="/theme" aria-label="@T["ThemeLabel"]">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <button type="submit" name="mode" value="system" aria-pressed="@Pressed(null)">@T["ThemeSystem"]</button>
    <button type="submit" name="mode" value="light" aria-pressed="@Pressed("light")">@T["ThemeLight"]</button>
    <button type="submit" name="mode" value="dark" aria-pressed="@Pressed("dark")">@T["ThemeDark"]</button>
</form>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    private string Pressed(string? mode) => ThemePreference.Read(HttpContext) == mode ? "true" : "false";
}
