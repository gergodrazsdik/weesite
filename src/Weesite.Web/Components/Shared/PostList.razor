@inject IStringLocalizer<PublicResource> T
@inject ContentCatalogProvider Content

@* Posts as a list: title (a heading at the given level), date, reading time and summary. *@
@if (Posts.Count == 0)
{
    <p>@T["NoPostsYet"]</p>
}
else
{
    <ul class="post-list" role="list">
        @foreach (var post in Posts)
        {
            <li>
                <article>
                    <DynamicHeading Level="HeadingLevel"><a href="/blog/@post.Slug" lang="@SiteCulture.LangOf(post, Content.Current.Site)">@post.Title</a></DynamicHeading>
                    <p class="meta">
                        @if (post.Date is { } date)
                        {
                            <time datetime="@ContentDates.Iso(date)">@ContentDates.Display(date, Content.Current.Site)</time>
                            <span> · </span>
                        }
                        <span>@T["ReadingTime", post.ReadingMinutes]</span>
                    </p>
                    @if (post.Summary is { } summary)
                    {
                        <p lang="@SiteCulture.LangOf(post, Content.Current.Site)">@summary</p>
                    }
                </article>
            </li>
        }
    </ul>
}

@code {
    /// <summary>Gets or sets the posts to list.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ContentItem> Posts { get; set; } = [];

    /// <summary>Gets or sets the heading level of the post titles (one below the list's own heading).</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;
}
