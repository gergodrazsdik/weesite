@using Weesite.Web.Visitors
@inject CommentCatalog Catalog
@inject CommentDesk Desk
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject IStringLocalizer<PublicResource> T

@* A post's comments (ADR 0011, T-0161). The approved ones are part of the page, oldest first, so
they read without JavaScript, in search engines and in screen readers; their text is plain, with
addresses as links marked rel="ugc nofollow", and lines starting with > or | as quotes. The first
ten show; the rest wait behind Show more, which comments.js opens ten at a time, and which without
JavaScript opens the page with all of them. A coloured bar on each comment's left marks the post's
author, editors, and (from comments.js) this browser's own and waiting ones, each said in words too.
The form exists only with JavaScript (comments.js): it's rendered hidden, a noscript line says so, and the script shows it,
asks for a fresh form token, solves the proof of work, and keeps the writer's own comments with their
tokens in this browser; it adds Reply, the moderators' Approve and Reject, and admins' Remove. *@
@if (Comments.Count > 0 || Open)
{
    <section class="comments" id="comments" aria-labelledby="comments-heading">
        <h2 id="comments-heading">@T["CommentsHeading"]</h2>
        @if (Rows.Count > 0)
        {
            <ol class="comment-list" role="list" data-comment-list>
                @for (var index = 0; index < Rows.Count; index++)
                {
                    var (comment, run) = Rows[index];
                    <li hidden="@(Ranks[index] > PageSize && !ShowAll)">
                        @if (comment.Deleted)
                        {
                            @* Its writer deleted it, or a moderator removed it: its place stays, so the replies around it read (T-0172, T-0180).
                            Several in a row of the same kind take one line, without a time (U-23). *@
                            <article class="comment deleted" id="comment-@comment.Id" data-comment-id="@comment.Id" data-deleted="@(comment.Removed ? "moderator" : "writer")" data-count="@run">
                                <p class="comment-meta">
                                    @if (run > 1)
                                    {
                                        <span class="comment-deleted">@T[comment.Removed ? "CommentsRemovedByModerator" : "CommentsDeletedByWriters", run]</span>
                                    }
                                    else
                                    {
                                        <span class="comment-deleted">@T[comment.Removed ? "CommentRemovedByModerator" : "CommentDeletedByWriter"]</span>
                                        <time class="comment-time" datetime="@comment.Created.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" title="@Content.Current.Site.FormatTime(comment.Created)">@ContentDates.Display(Content.Current.Site.DayOf(comment.Created), Content.Current.Site)</time>
                                    }
                                </p>
                            </article>
                        }
                        else
                        {
                            <article class="@ArticleClass(comment)" id="comment-@comment.Id" data-comment-id="@comment.Id" data-text="@comment.Text">
                                <div class="comment-head">
                                    <p class="comment-meta">
                                        <span class="comment-name">@comment.Name</span>
                                        @if (comment.By is "author")
                                        {
                                            <span class="comment-mark">@T["CommentMarkAuthor"]</span>
                                        }
                                        else if (comment.By is "editor")
                                        {
                                            <span class="comment-mark">@T["CommentMarkEditor"]</span>
                                        }
                                        @if (comment.Revised is { } revised)
                                        {
                                            @* Its text changed after it was published (T-0173). *@
                                            <span class="comment-mark edited" title="@T["CommentEditedAt", Content.Current.Site.FormatTime(revised)]">@T["CommentEdited"]</span>
                                        }
                                        @* The marks first, the time last; comments.js puts "your comment" before it too. *@
                                        <time class="comment-time" datetime="@comment.Created.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" title="@Content.Current.Site.FormatTime(comment.Created)">@ContentDates.Display(Content.Current.Site.DayOf(comment.Created), Content.Current.Site)</time>
                                    </p>
                                    <div class="comment-actions" data-actions></div>
                                </div>
                                <div class="comment-text">@Quoted(comment.Text)</div>
                            </article>
                        }
                    </li>
                }
            </ol>
            @if (LiveCount > PageSize && !ShowAll)
            {
                <p class="comments-more"><a href="?comments=all#comments" data-show-more data-step="@PageSize" data-more="@T["CommentsShowMore"]">@T["CommentsShowMore", LiveCount - PageSize]</a></p>
            }
        }
        else
        {
            <p class="comments-none">@T["CommentsNone"]</p>
        }
        @if (Open)
        {
            @* Without JavaScript there's no form and no React (U-65): say so where the form would be,
            so the comments don't just end. *@
            <noscript><p class="comments-no-script">@T[Content.Current.Site.Reactions ? "CommentsAndReactionsNeedScript" : "CommentsNeedScript"]</p></noscript>
            <ws-comments hidden data-post="@Item.Slug" data-key="@Item.SourcePath" data-text-max="@CommentDesk.TextMax"
                data-sending="@T["CommentSending"]" data-sent="@T["CommentSent"]" data-sent-public="@T["CommentSentPublic"]" data-failed="@T["CommentErrorFailed"]"
                data-yours="@T["CommentYours"]" data-waiting="@T["CommentWaitingNote"]" data-edit-waiting="@T["CommentEditWaitingNote"]"
                data-rejected="@T["CommentRejectedNote"]" data-edit="@T["CommentEdit"]" data-edit-label="@T["CommentEditLabel"]"
                data-save="@T["CommentSave"]" data-cancel="@T["CommentCancel"]" data-saved="@T["CommentSaved"]"
                data-delete="@T["CommentDelete"]" data-delete-confirm="@T["CommentDeleteConfirm"]" data-deleted="@T["CommentDeleted"]"
                data-reply="@T["CommentReply"]" data-reply-to="@T["CommentReplyTo"]" data-quote-header="@CommentQuote.Header(QuoteCulture)" data-quote-lang="@QuoteCulture.Name" data-commenting-as="@T["CommentCommentingAs"]"
                data-mark-author="@T["CommentMarkAuthor"]" data-mark-editor="@T["CommentMarkEditor"]" data-deleted-by-writer="@T["CommentDeletedByWriter"]" data-removed-by-moderator="@T["CommentRemovedByModerator"]" data-removed="@T["CommentRemovedNote"]" data-published-soon="@T["CommentPublishedSoonNote"]"
                data-deleted-by-writers="@T["CommentsDeletedByWriters"]" data-removed-by-moderator-many="@T["CommentsRemovedByModerator"]" data-edited="@T["CommentEdited"]" data-edited-at="@T["CommentEditedAt"]" data-saved-public="@T["CommentSavedPublic"]"
                data-go-to-field="@T["ContactGoToField"]" data-name-missing="@T["CommentErrorNameMissing"]" data-text-missing="@T["CommentErrorTextMissing"]"
                data-waiting-mod="@T["CommentWaitingModeration"]" data-approve="@T["CommentApprove"]" data-reject="@T["CommentReject"]"
                data-approved="@T["CommentApproved"]" data-rejected-mod="@T["CommentRejectedByYou"]" data-edit-of="@T["CommentEditOf"]"
                data-approve-edit="@T["CommentApproveEdit"]" data-reject-edit="@T["CommentRejectEdit"]" data-edit-rejected-mod="@T["CommentEditRejectedByYou"]"
                data-remove="@T["CommentRemove"]" data-removed-mod="@T["CommentRemovedByYou"]">
                <div class="own-comments" data-own></div>
                @* What waits for a moderator: apart from this browser's own, which redraw on their own (F-0211). *@
                <div class="own-comments" data-moderation></div>
                <p class="comment-status" role="status" data-status></p>
                <h3 id="comment-form-heading">@T["CommentFormHeading"]</h3>
                @* The site's own messages, not the browser's (novalidate, U-04): what's wrong is said
                above the form with a link to each field, and beside the field, which points at it (U-15). *@
                <form class="contact-form comment-form" aria-labelledby="comment-form-heading" novalidate data-comment-form>
                    <div class="notice error" role="alert" data-error hidden></div>
                    <div class="field">
                        <label for="comment-name">@T["CommentName"]</label>
                        <input id="comment-name" name="name" type="text" required maxlength="@CommentDesk.NameMax" autocomplete="name" />
                        <p id="comment-name-error" class="field-error" hidden></p>
                    </div>
                    <div class="field">
                        <label for="comment-text">@T["CommentText"]</label>
                        <textarea id="comment-text" name="text" required rows="6" maxlength="@CommentDesk.TextMax" aria-describedby="comment-text-help"></textarea>
                        @* An editor who publishes at once isn't told about approval (U-20): comments.js removes that part. *@
                        <p id="comment-text-help" class="help">@T["CommentTextHelp", CommentDesk.TextMax] <span data-approval-note>@T["CommentTextHelpApproval"]</span></p>
                        <p id="comment-text-error" class="field-error" hidden></p>
                    </div>
                    @* The honeypot (ADR 0011): hidden with display: none, out of the tab order and the accessibility tree. *@
                    <div class="field contact-extra">
                        <label for="comment-website">@T["ContactLeaveEmpty"]</label>
                        <input id="comment-website" name="@FormGuard.HoneypotField" type="text" value="" tabindex="-1" autocomplete="off" />
                    </div>
                    <div class="form-actions">
                        <button class="btn primary" type="submit">@T["CommentSend"]</button>
                    </div>
                </form>
            </ws-comments>
        }
    </section>
}

@code {
    /// <summary>Gets or sets the post.</summary>
    [Parameter, EditorRequired]
    public ContentItem Item { get; set; } = default!;

    /// <summary>Gets or sets the request, for <see cref="CommentCatalog.Guard"/>.</summary>
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    // Approved comments show while the site takes comments, even on a post that closed its own.
    // Taken once per render, so the list, its ranks and its count agree even when a reload lands
    // in between (F-0213).
    private IReadOnlyList<PublicComment> Comments { get; set; } = [];

    private bool Open => Desk.IsOpen(Item);

    // Ten at a time (T-0161); ?comments=all shows them all, the way without JavaScript. The
    // markers of deleted ones don't count: each goes with the comment after it (F-0206).
    private const int PageSize = 10;

    // The list's rows: a comment, or the markers of deleted ones, several of the same kind in a row
    // as one (U-23), with how many it stands for.
    private List<(PublicComment Comment, int Run)> Rows { get; set; } = [];

    // Each row's place among the comments, from 1; a marker shares the place of the comment after
    // it, which always follows (CommentCatalog keeps no marker last).
    private int[] Ranks { get; set; } = [];

    private int LiveCount { get; set; }

    // Reply's quote header, its words and its date in one language (U-16).
    private System.Globalization.CultureInfo QuoteCulture => CommentQuote.Culture(Item.Language, Content.Current.Site.Language);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Before reading them: a reload while this renders keeps the page out of the cache (F-0245).
        Catalog.Guard(HttpContext);
        Comments = Content.Current.Site.Comments ? Catalog.For(Item.SourcePath) : [];
        Rows = RowsOf(Comments);
        Ranks = RanksOf(Rows);
        LiveCount = Comments.Count(c => !c.Deleted);
    }

    private static List<(PublicComment Comment, int Run)> RowsOf(IReadOnlyList<PublicComment> comments)
    {
        var rows = new List<(PublicComment Comment, int Run)>(comments.Count);
        foreach (var comment in comments)
        {
            if (comment.Deleted && rows.Count > 0 && rows[^1].Comment is { Deleted: true } last && last.Removed == comment.Removed)
            {
                rows[^1] = (last, rows[^1].Run + 1);
                continue;
            }

            rows.Add((comment, 1));
        }

        return rows;
    }

    private static int[] RanksOf(List<(PublicComment Comment, int Run)> rows)
    {
        var ranks = new int[rows.Count];
        var next = rows.Count(r => !r.Comment.Deleted) + 1;
        for (var i = rows.Count - 1; i >= 0; i--)
        {
            if (!rows[i].Comment.Deleted)
            {
                next--;
            }

            ranks[i] = next;
        }

        return ranks;
    }

    private bool ShowAll => new Uri(Navigation.Uri).Query.Contains("comments=all", StringComparison.Ordinal);

    // The bar on the left (site.css): the post's author and editors by their mark.
    private static string ArticleClass(PublicComment comment) => comment.By switch
    {
        "author" => "comment by-author",
        "editor" => "comment by-editor",
        _ => "comment",
    };

    // Quotes nest this deep; a deeper > or | stays in the text, so a long thread keeps its width.
    private const int QuoteDepth = 4;

    // The text as paragraphs, and runs of lines starting with > or | as quotes, as in mail (T-0155).
    // A quote's own lines are read the same way, so a quote of a quote nests.
    private static RenderFragment Quoted(string text) => Rendered(text.Split('\n'), 1);

    private static RenderFragment Rendered(IReadOnlyList<string> text, int depth) => builder =>
    {
        var sequence = 0;
        foreach (var (quote, lines) in Blocks(text, depth))
        {
            if (quote)
            {
                builder.OpenElement(sequence++, "blockquote");
                builder.AddContent(sequence++, Rendered(lines, depth + 1));
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(sequence++, "p");
                builder.AddContent(sequence++, Linked(string.Join('\n', lines)));
                builder.CloseElement();
            }
        }
    };

    // Runs of quoted lines (without their mark), and paragraphs between empty lines.
    private static IEnumerable<(bool Quote, List<string> Lines)> Blocks(IReadOnlyList<string> text, int depth)
    {
        List<string>? lines = null;
        var quoting = false;
        foreach (var line in text)
        {
            var quote = depth <= QuoteDepth && (line.StartsWith('>') || line.StartsWith('|'));
            var content = quote ? line[1..].TrimStart(' ') : line;
            if (lines is not null && (quote != quoting || (!quote && line.Length == 0)))
            {
                if (lines.Any(l => l.Length > 0))
                {
                    yield return (quoting, lines);
                }

                lines = null;
            }

            if (!quote && line.Length == 0)
            {
                continue;
            }

            lines ??= [];
            quoting = quote;
            lines.Add(content);
        }

        if (lines is not null && lines.Any(l => l.Length > 0))
        {
            yield return (quoting, lines);
        }
    }

    // Plain text, with the addresses in it as links a visitor wrote: rel="ugc nofollow noopener".
    private static RenderFragment Linked(string text) => builder =>
    {
        var at = 0;
        var sequence = 0;
        foreach (var link in VisitorText.Links(text))
        {
            if (!Uri.TryCreate(link.Url, UriKind.Absolute, out var url) || url.Scheme is not ("http" or "https"))
            {
                continue;
            }

            builder.AddContent(sequence++, text[at..link.Index]);
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", url.AbsoluteUri);
            builder.AddAttribute(sequence++, "rel", "ugc nofollow noopener");
            builder.AddContent(sequence++, text.Substring(link.Index, link.Length));
            builder.CloseElement();
            at = link.Index + link.Length;
        }

        builder.AddContent(sequence, text[at..]);
    };
}
