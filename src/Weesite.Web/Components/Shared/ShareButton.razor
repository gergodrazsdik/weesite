@inject IStringLocalizer<SharedResource> T

@* Share (T-0075): a Share button that opens a dialog with LinkedIn, copy the link and email, and
the device's own share sheet where there is one. share.js shows the button; without JavaScript it
stays hidden and the dialog closed, so the page shows nothing to share with. *@
<ws-share class="share" data-title="@Title" data-url="@Url" data-copied="@T["LinkCopied"]" data-copy-failed="@T["LinkCopyFailed"]">
    <button type="button" class="btn share-open" aria-haspopup="dialog" hidden><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path></svg>@T["Share"]</button>
    <dialog class="share-dialog" aria-labelledby="share-heading">
        <div class="share-body">
            <div class="share-head">
                <h2 id="share-heading">@T["SharePost"]</h2>
                <button type="button" class="btn small share-close"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6L6 18M6 6l12 12"></path></svg>@T["Close"]</button>
            </div>
            <ul class="share-options" role="list">
                <li><a class="btn" href="@LinkedIn" target="_blank" rel="noopener noreferrer"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75V21h-4z"></path></svg>LinkedIn<span class="visually-hidden"> @T["OpensInNewTab"]</span></a></li>
                <li><button type="button" class="btn share-copy"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1 1"></path><path d="M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1-1"></path></svg>@T["CopyLink"]</button></li>
                <li><a class="btn" href="@Mail"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>@T["ShareByEmail"]</a></li>
                <li hidden><button type="button" class="btn share-native"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 6l-4-4-4 4M12 2v13"></path></svg>@T["ShareMore"]</button></li>
            </ul>
            <p class="share-status" role="status"></p>
        </div>
    </dialog>
</ws-share>

@code {
    /// <summary>The post's title, the email's subject.</summary>
    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The post's absolute address.</summary>
    [Parameter]
    [EditorRequired]
    public string Url { get; set; } = "";

    // LinkedIn's share endpoint takes the address only; it reads the title and image from the
    // page's Open Graph tags.
    private string LinkedIn => "https://www.linkedin.com/sharing/share-offsite/?url=" + Uri.EscapeDataString(Url);

    // mailto (RFC 6068): percent-encoded, spaces as %20, not "+".
    private string Mail => "mailto:?subject=" + Uri.EscapeDataString(Title) + "&body=" + Uri.EscapeDataString(Title + "\n" + Url);
}
