@using Weesite.Web.OpenGraph
@inject ContentCatalogProvider Content
@inject NavigationManager Navigation
@inject OpenGraphImages Images

@* The page's description and its Open Graph and Twitter card tags, for link previews. Pass the
post or page; leave Item out on site-wide pages (home, blog, tags), which get the site card. *@
<HeadContent>
    @if (Description is { } description)
    {
        <meta name="description" content="@description" />
        <meta property="og:description" content="@description" />
    }
    <meta property="og:type" content="@(Item?.Kind == ContentKind.Post ? "article" : "website")" />
    <meta property="og:title" content="@Title" />
    <meta property="og:site_name" content="@Site.Name" />
    <meta property="og:url" content="@PageUrl" />
    <meta property="og:image" content="@Absolute(Image.Path)" />
    @if (Image.Width is { } width && Image.Height is { } height)
    {
        <meta property="og:image:width" content="@width" />
        <meta property="og:image:height" content="@height" />
    }
    <meta property="og:image:alt" content="@Image.Alt" />
    @if (Item?.Date is { } date)
    {
        <meta property="article:published_time" content="@ContentDates.Iso(date)" />
    }
    @if (Item?.Updated is { } updated)
    {
        <meta property="article:modified_time" content="@ContentDates.Iso(updated)" />
    }
    @if (Item is not null)
    {
        @foreach (var tag in Item.Tags)
        {
            <meta property="article:tag" content="@tag" />
        }
    }
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

@code {
    /// <summary>Gets or sets the title for previews (without the site name).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Gets or sets the post or page, or null for site-wide pages.</summary>
    [Parameter]
    public ContentItem? Item { get; set; }

    /// <summary>Gets or sets the description; defaults to the item's summary or the site's tagline.</summary>
    [Parameter]
    public string? Summary { get; set; }

    private SiteSettings Site => Content.Current.Site;

    private string? Description => Summary ?? (Item is null ? Site.Tagline : Item.Summary);

    private OpenGraphImage Image => Images.For(Item);

    private string PageUrl
    {
        get
        {
            var uri = Navigation.Uri;
            var query = uri.IndexOfAny(['?', '#']);
            return query < 0 ? uri : uri[..query];
        }
    }

    private string Absolute(string path) => Navigation.BaseUri.TrimEnd('/') + path;
}
