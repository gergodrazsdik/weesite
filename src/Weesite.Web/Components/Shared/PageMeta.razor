@using Weesite.Web.Agents
@using Weesite.Web.OpenGraph
@using System.Net
@using Weesite.Web.Seo
@inject ContentCatalogProvider Content
@inject OpenGraphImages Images
@inject SiteUrls Urls

@* The page's head metadata: canonical link, description, feed links, Open Graph and Twitter card
tags, and JSON-LD. Pass the post or page; leave Item out on site-wide pages (home, blog, tags),
which get the site card. *@
<HeadContent>
    <link rel="canonical" href="@PageUrl" />
    @foreach (var (href, media) in ImagePreloads)
    {
        <link rel="preload" as="image" href="@href" media="@media" />
    }
    @if (Description is { } description)
    {
        <meta name="description" content="@description" />
        <meta property="og:description" content="@description" />
    }
    @if (Item is { } markdownItem)
    {
        <link rel="alternate" type="text/markdown" title="Markdown" href="@Absolute(AgentText.MarkdownPath(markdownItem))" />
    }
    @FeedLinks(null)
    @if (Tag is { } tag)
    {
        @FeedLinks(tag)
    }
    <meta property="og:type" content="@(Item?.Kind == ContentKind.Post ? "article" : "website")" />
    <meta property="og:title" content="@Title" />
    <meta property="og:site_name" content="@Site.Name" />
    <meta property="og:url" content="@PageUrl" />
    <meta property="og:image" content="@ImageUrl" />
    @if (Image.Width is { } width && Image.Height is { } height)
    {
        <meta property="og:image:width" content="@width" />
        <meta property="og:image:height" content="@height" />
    }
    <meta property="og:image:alt" content="@Image.Alt" />
    @if (Item?.Date is { } date)
    {
        <meta property="article:published_time" content="@ContentDates.Iso(date)" />
    }
    @if (Item?.Updated is { } updated)
    {
        <meta property="article:modified_time" content="@ContentDates.Iso(updated)" />
    }
    @if (Item is not null)
    {
        @foreach (var itemTag in Item.Tags)
        {
            <meta property="article:tag" content="@itemTag" />
        }
    }
    <meta name="twitter:card" content="summary_large_image" />
    @if (JsonLd.For(Site, Item, IsHome, PageUrl, Origin, ImageUrl) is { } jsonLd)
    {
        @((MarkupString)$"<script type=\"application/ld+json\">{jsonLd}</script>")
    }
</HeadContent>

@code {
    /// <summary>Gets or sets the title for previews (without the site name).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Gets or sets the post or page, or null for site-wide pages.</summary>
    [Parameter]
    public ContentItem? Item { get; set; }

    /// <summary>Gets or sets the description; defaults to the item's summary or the site's tagline.</summary>
    [Parameter]
    public string? Summary { get; set; }

    /// <summary>Gets or sets the tag of a tag page, which links its own feeds too.</summary>
    [Parameter]
    public string? Tag { get; set; }

    /// <summary>Gets or sets a value indicating whether this is the home page (WebSite JSON-LD).</summary>
    [Parameter]
    public bool IsHome { get; set; }

    /// <summary>
    /// Gets or sets images to start loading with the HTML, each with its media query: a page's
    /// largest paint (the home banner). Blazor keeps only one HeadContent per page, so they're here.
    /// </summary>
    [Parameter]
    public IEnumerable<(string Href, string Media)> ImagePreloads { get; set; } = [];

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private SiteSettings Site => Content.Current.Site;

    private string? Description => Summary ?? (Item is null ? Site.Tagline : Item.Summary);

    private OpenGraphImage Image => Images.For(Item);

    private string ImageUrl => Absolute(Image.Path);

    private string Origin => HttpContext is { } context ? Urls.Origin(context.Request) : "";

    // The home page is "/", even when it shows a content page; items use their own path (the
    // canonical one, whatever redirect led there); other pages the request's path.
    private string PageUrl => Absolute(IsHome ? "/" : Item is { } item ? ContentUrls.PathOf(item) : HttpContext?.Request.Path.Value ?? "/");

    private string Absolute(string path) => Origin + path;

    // Written as markup: Razor would encode the "+" in the media types as &#x2B;, which is valid
    // HTML but trips simple feed finders.
    private MarkupString FeedLinks(string? tag)
    {
        var title = WebUtility.HtmlEncode(FeedEndpoints.Title(Site, tag));
        var atom = WebUtility.HtmlEncode(Absolute(FeedEndpoints.PathOf(tag, "xml")));
        var json = WebUtility.HtmlEncode(Absolute(FeedEndpoints.PathOf(tag, "json")));
        return new MarkupString(
            $"<link rel=\"alternate\" type=\"application/atom+xml\" title=\"{title}\" href=\"{atom}\" />\n" +
            $"<link rel=\"alternate\" type=\"application/feed+json\" title=\"{title}\" href=\"{json}\" />");
    }
}
