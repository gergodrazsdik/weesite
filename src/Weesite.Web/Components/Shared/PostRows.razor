@inject ContentCatalogProvider Content
@inject IStringLocalizer<PublicResource> T

@*
    Posts grouped by year (ADR 0006): each row has the month and day and the reading time, the
    title and summary, and the tags. The year is in the group's heading, so the rows leave it out.
*@
@if (Posts.Count == 0)
{
    <p>@T["NoPostsYet"]</p>
}
else
{
    @foreach (var group in Posts.GroupBy(p => p.Date?.Year))
    {
        <div class="year-head">
            <h2 class="year" id="@(group.Key is { } y ? $"y{y}" : "undated")">@(group.Key?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? T["Undated"])</h2>
        </div>
        <ul class="@(SiteCulture.LongestMonthDay(System.Globalization.CultureInfo.CurrentCulture) > 6 ? "post-list dated long-dates" : "post-list dated")" role="list">
            @foreach (var post in group)
            {
                <li>
                    <div class="when">
                        @if (post.Date is { } date)
                        {
                            <time datetime="@ContentDates.Iso(date)">@ContentDates.MonthDay(date)</time>
                        }
                        <span>@T["MinutesShort", post.ReadingMinutes]</span>
                    </div>
                    <div>
                        <h3 lang="@SiteCulture.LangOf(post, Content.Current.Site)"><a href="@ContentUrls.PathOf(post)">@post.Title</a></h3>
                        @if (post.Summary is { } summary)
                        {
                            <p lang="@SiteCulture.LangOf(post, Content.Current.Site)">@summary</p>
                        }
                    </div>
                    @if (post.Tags.Count > 0)
                    {
                        <div class="tags">
                            @foreach (var tag in post.Tags)
                            {
                                <TagLabel Tag="@tag" />
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    /// <summary>Gets or sets the posts, newest first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ContentItem> Posts { get; set; } = [];
}
