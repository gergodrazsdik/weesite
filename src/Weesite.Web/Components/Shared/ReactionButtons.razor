@using Weesite.Web.Visitors
@inject IStringLocalizer<PublicResource> T

@* Reactions to a post (ADR 0011, T-0158, T-0162), in the post's action row: React shows the
visitor's reaction (or a smiley) and the total, and opens the four to choose from; one reaction
per visitor, choosing another changes it, choosing it again takes it back. On the right, the
reactions given, stacked, open the count of each. Rendered hidden: reactions.js fetches the counts,
shows them and sends each choice with a proof of work, so without JavaScript there's nothing here. *@
<ws-reactions class="reactions" hidden data-post="@Item.Slug" data-key="@Item.SourcePath" data-failed="@T["ReactionFailed"]" data-limited="@T["ReactionLimited"]" data-chosen="@T["ReactionChosen"]" data-removed="@T["ReactionRemoved"]"
    data-total-none="@T["ReactionTotalNone"]" data-total-one="@T["ReactionTotalOne"]" data-total-many="@T["ReactionTotalMany"]">
    <div class="reaction-chooser">
        <button type="button" class="btn reaction-toggle" aria-expanded="false" aria-controls="reaction-options-@Item.Slug" data-react="@T["ReactionReact"]" data-yours="@T["ReactionYours"]">
            <svg class="reaction-toggle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.5 12a9.5 9.5 0 1 1-6.5-9"></path><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><path d="M9 9h.01"></path><path d="M15 9h.01"></path><path d="M19 2v6"></path><path d="M16 5h6"></path></svg>
            <span class="reaction-toggle-emoji" aria-hidden="true" hidden></span>
            <span class="reaction-toggle-count" aria-hidden="true" hidden></span>
            <span class="reaction-toggle-text">@T["ReactionReact"]</span>
        </button>
        <div id="reaction-options-@Item.Slug" class="reaction-options" role="group" aria-label="@T["ReactionChoose"]" hidden>
            @foreach (var kind in Reactions.All)
            {
                <button type="button" class="reaction-option" data-kind="@Reactions.Name(kind)" data-label="@T[Reactions.LabelKey(kind)]" data-emoji="@Reactions.Emoji(kind)" aria-pressed="false" title="@T[Reactions.LabelKey(kind)]"><span aria-hidden="true">@Reactions.Emoji(kind)</span><span class="visually-hidden">@T[Reactions.LabelKey(kind)]</span></button>
            }
        </div>
    </div>
    @* The reactions given, in a rounded box: stacked emoji that open the count of each in the same
    box, and close it again (T-0162, T-0165). *@
    <div class="reaction-summary-box" hidden>
        <button type="button" class="reaction-summary" aria-expanded="false" aria-controls="reaction-counts-@Item.Slug" title="@T["ReactionsCountsShow"]" data-show="@T["ReactionsCountsShow"]" data-hide="@T["ReactionsCountsHide"]">
            <span class="reaction-stack" aria-hidden="true"></span>
            <svg class="reaction-summary-close" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" hidden><path d="M18 6L6 18M6 6l12 12"></path></svg>
            <span class="visually-hidden reaction-summary-text">@T["ReactionsCountsShow"]</span>
        </button>
        <ul id="reaction-counts-@Item.Slug" class="reaction-tallies" role="list" aria-label="@T["ReactionsCounts"]" hidden>
            @foreach (var kind in Reactions.All)
            {
                <li data-kind="@Reactions.Name(kind)" data-emoji="@Reactions.Emoji(kind)" title="@T[Reactions.LabelKey(kind)]" hidden><span class="reaction-emoji" aria-hidden="true">@Reactions.Emoji(kind)</span><span class="visually-hidden">@(T[Reactions.LabelKey(kind)] + ": ")</span><span class="reaction-count">0</span></li>
            }
        </ul>
    </div>
    @* Errors for everyone; what was chosen or removed for screen readers, which don't see the button change. *@
    <p class="reactions-status" role="status"></p>
    <p class="reactions-announce visually-hidden" role="status"></p>
</ws-reactions>

@code {
    /// <summary>Gets or sets the post.</summary>
    [Parameter, EditorRequired]
    public ContentItem Item { get; set; } = default!;
}
