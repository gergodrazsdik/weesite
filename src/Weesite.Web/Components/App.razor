@using Weesite.Web.Theming
@inject ContentCatalogProvider Content

@* The document shell. Static server rendering only: no blazor.web.js, so every page is plain HTML
and works without JavaScript (scripts may only enhance). No inline scripts or styles (strict CSP).
The visitor's theme choice is rendered from the first byte (data-theme), so there's no flash, and
so is reading mode (data-reading, T-0081). *@
<!DOCTYPE html>
<html lang="@Content.Current.Site.Language" data-theme="@ThemePreference.Read(HttpContext)" data-reading="@(ReadingPreference.IsOn(HttpContext) ? "on" : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/@Assets["icons/logo.svg"]" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/@Assets["icons/apple-touch-icon.png"]" />
    @* The body and heading faces start loading with the stylesheet rather than after it (T-0098).
    The same addresses as site.css's @font-face rules, not fingerprinted ones, or they'd load twice. *@
    <link rel="preload" href="/fonts/plex-sans-1.1.0/IBMPlexSans-Regular-Latin1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-1.1.0/IBMPlexSans-SemiBold-Latin1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/@Assets["site.css"]" />
    @if (IsAdmin)
    {
        <link rel="stylesheet" href="/@Assets["admin.css"]" />
    }
    @if (ThemeStylesheet.Build(Content.Current.Site) is { } theme)
    {
        <link rel="stylesheet" href="@theme.Url" />
    }
    <HeadOutlet />
</head>
<body>
    <Routes />
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // The admin's stylesheet loads only under /admin (ADR 0006), but not for the preview of an
    // unpublished item, which looks like the public page.
    private bool IsAdmin => HttpContext?.Request.Path is { } path
        && path.StartsWithSegments("/admin", StringComparison.OrdinalIgnoreCase)
        && !path.StartsWithSegments("/admin/preview", StringComparison.OrdinalIgnoreCase);
}
