@inherits LayoutComponentBase
@inject ContentCatalogProvider Content
@inject IStringLocalizer<PublicResource> T
@inject NavigationManager Navigation

<a class="skip-link" href="#main">@T["SkipToContent"]</a>
<header class="site-header">
    <div class="wrap">
        <a class="site-name" href="/"><img src="@SiteLogo.Mark(Site, "/" + Assets["icons/logo.svg"])" alt="" width="28" height="28" />@Site.Name</a>
        <MainMenu />
        <div class="header-tools">
            <SearchBox Query="@HeaderQuery" />
            <ThemeSwitch />
            @* Shown by editor-link.js in a browser an editor signed in with: the page stays the same for everyone. *@
            <a class="editor-link" href="/admin" hidden title="@T["EditSite"]"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg><span class="visually-hidden">@T["EditSite"]</span></a>
            <script type="module" src="/@Assets["editor-link.js"]"></script>
        </div>
    </div>
</header>
<main id="main">
    <div class="wrap">
        @Body
    </div>
</main>
<footer class="site-footer" aria-label="@T["Footer"]">
    <div class="wrap">
        <p>@Site.CopyrightLine(DateTime.UtcNow.Year)</p>
        <ul class="site-links" role="list">
            @if (Site.ContactEmail is { } email)
            {
                <li><a href="mailto:@email" aria-label="@T["ContactAddress", email]">@email</a></li>
            }
            @foreach (var link in Links)
            {
                <li><a href="@link.Address" rel="me noopener" target="_blank">@link.Label<span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a></li>
            }
            @if (PrivacyPage is { } privacy)
            {
                <li><a href="@ContentUrls.PathOf(privacy)">@T["PrivacyLink"]</a></li>
            }
            @if (TermsPage is { } terms)
            {
                <li><a href="@ContentUrls.PathOf(terms)">@T["TermsLink"]</a></li>
            }
            <li><a href="/feed.xml" type="application/atom+xml" target="_blank" rel="noopener">Atom<span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a></li>
            <li><a href="/feed.json" type="application/feed+json" target="_blank" rel="noopener">JSON Feed<span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a></li>
        </ul>
        @if (!Site.HideBuiltWith)
        {
            <p class="built-with">@T["BuiltWith"] <a href="@ProjectUrl" target="_blank" rel="noopener">Weesite<span class="visually-hidden">@(" " + T["OpensInNewTab"])</span></a></p>
        }
    </div>
</footer>

@code {
    // Where Weesite is developed (NOTICE).
    private const string ProjectUrl = "https://github.com/gergodrazsdik/weesite";

    private SiteSettings Site => Content.Current.Site;

    // On the results page the header's field keeps the query, as the page's own field does.
    private string? HeaderQuery
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            return uri.AbsolutePath == "/search"
                ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var q) ? q.ToString() : null
                : null;
        }
    }

    // The privacy policy and terms (T-0096, T-0097): linked only when set and published.
    private ContentItem? PrivacyPage => Site.PrivacyPage is { } slug ? Content.Current.FindPage(slug) : null;

    private ContentItem? TermsPage => Site.TermsPage is { } slug ? Content.Current.FindPage(slug) : null;

    // The site's own links: those of its first author, until site settings get their own (T-0049).
    private IReadOnlyList<SiteLink> Links =>
        (Site.Links.Count > 0 ? Site.Links : Site.Authors.FirstOrDefault()?.Links ?? []).Where(l => l.Address is not null).ToList();
}
