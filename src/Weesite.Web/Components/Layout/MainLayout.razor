@inherits LayoutComponentBase
@inject ContentCatalogProvider Content
@inject IStringLocalizer<SharedResource> T
@inject NavigationManager Navigation

<a class="skip-link" href="#main">@T["SkipToContent"]</a>
<header class="site-header">
    <div class="wrap">
        <a class="site-name" href="/"><img src="/@Assets["icons/logo.svg"]" alt="" width="28" height="28" />@Site.Name</a>
        <MainMenu />
        <div class="header-tools">
            <SearchBox Query="@HeaderQuery" />
            <ThemeSwitch />
        </div>
    </div>
</header>
<main id="main">
    <div class="wrap">
        @Body
    </div>
</main>
<footer class="site-footer" aria-label="@T["Footer"]">
    <div class="wrap">
        <p>© @DateTime.UtcNow.Year @Site.Name</p>
        <ul class="site-links" role="list">
            @if (Site.ContactEmail is { } email)
            {
                <li><a href="mailto:@email" aria-label="@T["ContactAddress", email]">@email</a></li>
            }
            @foreach (var link in Links)
            {
                <li><a href="@link.Address" rel="me">@link.Label</a></li>
            }
            @if (PrivacyPage is { } privacy)
            {
                <li><a href="/@privacy.Slug">@T["PrivacyLink"]</a></li>
            }
            @if (TermsPage is { } terms)
            {
                <li><a href="/@terms.Slug">@T["TermsLink"]</a></li>
            }
            <li><a href="/feed.xml" type="application/atom+xml">Atom</a></li>
            <li><a href="/feed.json" type="application/feed+json">JSON Feed</a></li>
        </ul>
        <p>@T["BuiltWith"]</p>
    </div>
</footer>

@code {
    private SiteSettings Site => Content.Current.Site;

    // On the results page the header's field keeps the query, as the page's own field does.
    private string? HeaderQuery
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            return uri.AbsolutePath == "/search"
                ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("q", out var q) ? q.ToString() : null
                : null;
        }
    }

    // The privacy policy and terms (T-0096, T-0097): linked only when set and published.
    private ContentItem? PrivacyPage => Site.PrivacyPage is { } slug ? Content.Current.FindPage(slug) : null;

    private ContentItem? TermsPage => Site.TermsPage is { } slug ? Content.Current.FindPage(slug) : null;

    // The site's own links: those of its first author, until site settings get their own (T-0049).
    private IReadOnlyList<SiteLink> Links =>
        (Site.Links.Count > 0 ? Site.Links : Site.Authors.FirstOrDefault()?.Links ?? []).Where(l => l.Address is not null).ToList();
}
