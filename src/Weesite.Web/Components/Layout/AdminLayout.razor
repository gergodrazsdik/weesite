@inherits LayoutComponentBase
@using System.Security.Claims
@using Weesite.Content.Media
@using Weesite.Web.Admin
@inject ContentCatalogProvider Content
@inject Weesite.Web.Admin.MediaCount MediaFiles
@inject Weesite.Web.Visitors.IMessageStore Messages
@inject Weesite.Web.Visitors.CommentDesk Comments
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResource> T

@*
    The admin's shell (ADR 0006): a sidebar in place of the public header, with the navigation in
    two groups (site settings for admins only) and counts, the theme switch, the signed-in editor
    and Sign out. On phones it becomes a top bar whose Menu button opens the rest (U-35).
*@
<a class="skip-link" href="#main">@T["SkipToContent"]</a>
<div class="admin">
    <aside class="admin-nav">
        <div class="admin-brand">
            <img src="@SiteLogo.Mark(Content.Current.Site, "/" + Assets["icons/logo.svg"])" alt="" width="26" height="26" />
            <span>@T["EditorBrand"]</span>
            <a href="/">@T["ViewSite"] <span aria-hidden="true">↗</span></a>
            @* Only on a phone: the menu folds away behind it, and admin/nav-menu.js opens it. *@
            <button class="btn small menu-toggle" type="button" aria-expanded="false" aria-controls="admin-menu"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>@T["MenuButton"]</button>
        </div>
        <div class="admin-menu" id="admin-menu">
            <nav aria-label="@T["EditorNavigation"]">
                <p class="group">@T["NavContent"]</p>
                @* Totals as plain numbers; what waits for the editor as a badge, only when something
                does (U-33). Screen readers hear the same either way, such as "Comments, 2 waiting". *@
                <a href="/admin/posts" aria-current="@Current(NavSection.Posts)">@T["PostsTitle"]<span><span class="visually-hidden">, </span>@PostCount</span></a>
                @if (IsAdmin)
                {
                    <a href="/admin/pages" aria-current="@Current(NavSection.Pages)">@T["PagesTitle"]<span><span class="visually-hidden">, </span>@PageCount</span></a>
                }
                <a href="/admin/media" aria-current="@Current(NavSection.Media)">@T["MediaTitle"]<span><span class="visually-hidden">, </span>@MediaCount</span></a>
                @if (Content.Current.Site.Comments || WaitingComments > 0)
                {
                    @* Comments to moderate (ADR 0011), with how many wait: authors see their own posts'. *@
                    <a href="/admin/comments" aria-current="@Current(NavSection.Comments)">@T["CommentsTitle"]<span class="@CountClass(WaitingComments)"><span class="visually-hidden">, </span>@WaitingComments<span class="visually-hidden">@(" " + T["CommentsWaiting"])</span></span></a>
                }
                <a href="/admin/profile" aria-current="@Current(NavSection.Profile)">@T["ProfileTitle"]</a>
                @if (IsAdmin)
                {
                    <p class="group">@T["NavSite"]</p>
                    @* The contact form's messages (ADR 0011), with how many are unread. *@
                    <a href="/admin/messages" aria-current="@Current(NavSection.Messages)">@T["MessagesTitle"]<span class="@CountClass(UnreadMessages)"><span class="visually-hidden">, </span>@UnreadMessages<span class="visually-hidden">@(" " + T["MessagesUnread"])</span></span></a>
                    <a href="/admin/settings" aria-current="@Current(NavSection.Settings)">@T["SettingsTitle"]</a>
                    <a href="/admin/menu" aria-current="@Current(NavSection.Menu)">@T["MenuTitle"]</a>
                    <a href="/admin/tags" aria-current="@Current(NavSection.Tags)">@T["TagsAdminTitle"]</a>
                    <a href="/admin/theme" aria-current="@Current(NavSection.Theme)">@T["ThemeTitle"]</a>
                    <a href="/admin/editors" aria-current="@Current(NavSection.Editors)">@T["EditorsTitle"]</a>
                    <a href="/admin/analytics" aria-current="@Current(NavSection.Analytics)">@T["AnalyticsTitle"]</a>
                    <a href="/admin/backup" aria-current="@Current(NavSection.Backup)">@T["BackupTitle"]</a>
                    <a href="/admin/audit" aria-current="@Current(NavSection.Audit)">@T["AuditTitle"]</a>
                }
            </nav>
            <div class="admin-user">
                @* In the admin's language, not the site's (U-59). *@
                <ThemeSwitch Admin="true" />
                <div class="who">
                    <p class="name">@User?.Identity?.Name</p>
                    <p class="role">@Role<span class="visually-hidden">, @Email</span></p>
                    <form method="post" action="/admin/sign-out">
                        <AntiforgeryToken />
                        <button class="btn small" type="submit">@T["SignOut"]</button>
                    </form>
                </div>
            </div>
        </div>
    </aside>
    <main class="admin-main" id="main">
        <div class="admin-body">
            @Body
        </div>
    </main>
</div>
<script type="module" src="/@Assets["admin/nav-menu.js"]"></script>
<script type="module" src="/@Assets["admin/notice-focus.js"]"></script>
<script type="module" src="/@Assets["admin/sign-out.js"]"></script>
<script type="module" src="/@Assets["admin/confirm-forms.js"]"></script>
<script type="module" src="/@Assets["admin/search-box.js"]"></script>
<script type="module" src="/@Assets["admin/page-intro.js"]"></script>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ClaimsPrincipal? User => HttpContext?.User;

    private bool IsAdmin => User?.IsInRole(nameof(EditorRole.Admin)) == true;

    private string Email => User?.FindFirst(ClaimTypes.Email)?.Value ?? "";

    private string Role => IsAdmin ? T["RoleAdmin"] : T["RoleAuthor"];

    private int PostCount { get; set; }

    private int PageCount { get; set; }

    private int MediaCount { get; set; }

    private int UnreadMessages { get; set; }

    private int WaitingComments { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (User is not { } user)
        {
            return;
        }

        var catalog = Content.Current;
        var items = catalog.AllItems
            .Where(i => EditorRights.CanEdit(user, i.Kind, i.AuthorId, isNew: false))
            .ToList();
        // As the lists' All tab counts them: archived items have a tab of their own (F-0091 L9).
        PostCount = items.Count(i => i.Kind == ContentKind.Post && i.Status != ContentStatus.Archived);
        PageCount = items.Count(i => i.Kind == ContentKind.Page && i.Status != ContentStatus.Archived);
        // As the media page's All tab counts them, archived files left out (F-0120).
        // Kept briefly, not a listing of the whole media container on every admin page (F-0248).
        MediaCount = await MediaFiles.GetAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        // From the comments in memory, not a read of the whole table on every admin page (F-0225).
        WaitingComments = Comments.WaitingCount(user);
        if (IsAdmin)
        {
            UnreadMessages = await Messages.CountUnreadAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        }
    }

    // The section a page belongs to, marked in the sidebar on its sub-pages too (U-32): an item's
    // editor, versions, diff, export and delete pages belong to Posts or Pages by the item's path;
    // replacing, archiving and deleting a file to Media; a message to Messages; the factory reset
    // to Site settings. "/admin" is the posts list.
    private NavSection? Section
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (segments.Length == 0 || !segments[0].Equals("admin", StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            return (segments.Length > 1 ? segments[1].ToLowerInvariant() : "") switch
            {
                "" or "posts" => NavSection.Posts,
                "pages" => NavSection.Pages,
                "new" => segments.Length > 2 && segments[2].Equals("page", StringComparison.OrdinalIgnoreCase) ? NavSection.Pages : NavSection.Posts,
                "edit" or "versions" or "diff" or "export" or "delete" => ItemIsPage ? NavSection.Pages : NavSection.Posts,
                "media" => NavSection.Media,
                "comments" => NavSection.Comments,
                "profile" => NavSection.Profile,
                "messages" => NavSection.Messages,
                "settings" or "reset" => NavSection.Settings,
                "menu" => NavSection.Menu,
                "tags" => NavSection.Tags,
                "theme" => NavSection.Theme,
                "editors" => NavSection.Editors,
                "analytics" => NavSection.Analytics,
                "backup" => NavSection.Backup,
                "audit" => NavSection.Audit,
                _ => null,
            };
        }
    }

    private bool ItemIsPage =>
        System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)["path"] is { } item
        && item.StartsWith("pages/", StringComparison.Ordinal);

    private string? Current(NavSection section) => Section == section ? "page" : null;

    // A badge for a number that asks for something; none at zero, which is still read out.
    private static string CountClass(int count) => count > 0 ? "badge" : "visually-hidden";

    private enum NavSection
    {
        Posts,
        Pages,
        Media,
        Comments,
        Profile,
        Messages,
        Settings,
        Menu,
        Tags,
        Theme,
        Editors,
        Analytics,
        Backup,
        Audit,
    }
}
