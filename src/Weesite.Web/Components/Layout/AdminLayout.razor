@inherits LayoutComponentBase
@using System.Security.Claims
@using Weesite.Content.Media
@using Weesite.Web.Admin
@inject ContentCatalogProvider Content
@inject MediaLibrary Media
@inject Weesite.Web.Visitors.IMessageStore Messages
@inject Weesite.Web.Visitors.CommentDesk Comments
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminResource> T

@*
    The admin's shell (ADR 0006): a sidebar in place of the public header, with the navigation in
    two groups (site settings for admins only) and counts, the theme switch, the signed-in editor
    and Sign out. On phones it becomes a top bar with a scrolling navigation.
*@
<a class="skip-link" href="#main">@T["SkipToContent"]</a>
<div class="admin">
    <aside class="admin-nav">
        <div class="admin-brand">
            <img src="@SiteLogo.Mark(Content.Current.Site, "/" + Assets["icons/logo.svg"])" alt="" width="26" height="26" />
            <span>@T["EditorBrand"]</span>
            <a href="/">@T["ViewSite"] <span aria-hidden="true">↗</span></a>
        </div>
        <nav aria-label="@T["EditorNavigation"]">
            <p class="group">@T["NavContent"]</p>
            <a href="/admin/posts" aria-current="@(EditingPage ? null : Current("/admin/posts", "/admin", "/admin/edit", "/admin/new/post"))">@T["PostsTitle"]<span><span class="visually-hidden">, </span>@PostCount</span></a>
            @if (IsAdmin)
            {
                <a href="/admin/pages" aria-current="@(EditingPage ? "page" : Current("/admin/pages", "/admin/new/page"))">@T["PagesTitle"]<span><span class="visually-hidden">, </span>@PageCount</span></a>
            }
            <a href="/admin/media" aria-current="@Current("/admin/media")">@T["MediaTitle"]<span><span class="visually-hidden">, </span>@MediaCount</span></a>
            @if (Content.Current.Site.Comments || WaitingComments > 0)
            {
                @* Comments to moderate (ADR 0011), with how many wait: authors see their own posts'. *@
                <a href="/admin/comments" aria-current="@Current("/admin/comments")">@T["CommentsTitle"]<span><span class="visually-hidden">, </span>@WaitingComments<span class="visually-hidden">@(" " + T["CommentsWaiting"])</span></span></a>
            }
            <a href="/admin/profile" aria-current="@Current("/admin/profile")">@T["ProfileTitle"]</a>
            @if (IsAdmin)
            {
                <p class="group">@T["NavSite"]</p>
                @* The contact form's messages (ADR 0011), with how many are unread. *@
                <a href="/admin/messages" aria-current="@Current("/admin/messages", "/admin/messages/view")">@T["MessagesTitle"]<span><span class="visually-hidden">, </span>@UnreadMessages<span class="visually-hidden">@(" " + T["MessagesUnread"])</span></span></a>
                <a href="/admin/settings" aria-current="@Current("/admin/settings", "/admin/reset")">@T["SettingsTitle"]</a>
                <a href="/admin/menu" aria-current="@Current("/admin/menu")">@T["MenuTitle"]</a>
                <a href="/admin/tags" aria-current="@Current("/admin/tags")">@T["TagsAdminTitle"]</a>
                <a href="/admin/theme" aria-current="@Current("/admin/theme")">@T["ThemeTitle"]</a>
                <a href="/admin/editors" aria-current="@Current("/admin/editors")">@T["EditorsTitle"]</a>
                <a href="/admin/analytics" aria-current="@Current("/admin/analytics")">@T["AnalyticsTitle"]</a>
                <a href="/admin/backup" aria-current="@Current("/admin/backup")">@T["BackupTitle"]</a>
                <a href="/admin/audit" aria-current="@Current("/admin/audit")">@T["AuditTitle"]</a>
            }
        </nav>
        <div class="admin-user">
            <ThemeSwitch />
            <div class="who">
                <p class="name">@User?.Identity?.Name</p>
                <p class="role">@Role<span class="visually-hidden">, @Email</span></p>
                <form method="post" action="/admin/sign-out">
                    <AntiforgeryToken />
                    <button class="btn small" type="submit">@T["SignOut"]</button>
                </form>
            </div>
        </div>
    </aside>
    <main class="admin-main" id="main">
        <div class="admin-body">
            @Body
        </div>
    </main>
</div>
<script type="module" src="/@Assets["admin/notice-focus.js"]"></script>
<script type="module" src="/@Assets["admin/sign-out.js"]"></script>
<script type="module" src="/@Assets["admin/confirm-forms.js"]"></script>
<script type="module" src="/@Assets["admin/search-box.js"]"></script>
<script type="module" src="/@Assets["admin/page-intro.js"]"></script>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ClaimsPrincipal? User => HttpContext?.User;

    private bool IsAdmin => User?.IsInRole(nameof(EditorRole.Admin)) == true;

    private string Email => User?.FindFirst(ClaimTypes.Email)?.Value ?? "";

    private string Role => IsAdmin ? T["RoleAdmin"] : T["RoleAuthor"];

    private int PostCount { get; set; }

    private int PageCount { get; set; }

    private int MediaCount { get; set; }

    private int UnreadMessages { get; set; }

    private int WaitingComments { get; set; }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (User is not { } user)
        {
            return;
        }

        var catalog = Content.Current;
        var items = catalog.AllItems
            .Where(i => EditorRights.CanEdit(user, i.Kind, i.AuthorId, isNew: false))
            .ToList();
        // As the lists' All tab counts them: archived items have a tab of their own (F-0091 L9).
        PostCount = items.Count(i => i.Kind == ContentKind.Post && i.Status != ContentStatus.Archived);
        PageCount = items.Count(i => i.Kind == ContentKind.Page && i.Status != ContentStatus.Archived);
        // As the media page's All tab counts them, archived files left out (F-0120).
        MediaCount = (await Media.ListAsync(HttpContext?.RequestAborted ?? CancellationToken.None)).Count(f => !f.IsArchived);
        WaitingComments = (await Comments.ListAsync(user, HttpContext?.RequestAborted ?? CancellationToken.None)).Count(c => c.Waiting);
        if (IsAdmin)
        {
            UnreadMessages = await Messages.CountUnreadAsync(HttpContext?.RequestAborted ?? CancellationToken.None);
        }
    }

    // "page" on the item's own page; the posts list also stands for /admin and the editor.
    // The editor open on a page belongs to Pages, not Posts.
    private bool EditingPage =>
        Current("/admin/edit") is not null
        && System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query)["path"] is { } path
        && path.StartsWith("pages/", StringComparison.Ordinal);

    private string? Current(params string[] paths)
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        return paths.Any(p => string.Equals(path, p, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
    }
}
