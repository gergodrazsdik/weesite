<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Local development keeps the sign-in clients in user secrets (docs/dev-setup.md). -->
  <PropertyGroup>
    <UserSecretsId>weesite-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Data.Tables" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Aspire.Azure.Storage.Queues" />
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Weesite.Content\Weesite.Content.csproj" />
    <ProjectReference Include="..\Weesite.Search\Weesite.Search.csproj" />
    <ProjectReference Include="..\Weesite.ServiceDefaults\Weesite.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Weesite.Web.Tests" />
    <InternalsVisibleTo Include="Weesite.Web.EndToEnd" />
  </ItemGroup>

  <!-- A commented reference of every setting (appsettings.example.json): kept out of the build and
  publish output, so the app never loads it. -->
  <ItemGroup>
    <Content Update="appsettings.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
