root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C# and Razor. .NET naming and style rules come with the solution (tracker).
[*.{cs,razor,cshtml}]
indent_size = 4

# Analyzer exceptions to AnalysisMode=All (Directory.Build.props), each with its reason.
# The .NET naming and style rules come with T-0024.
[*.{cs,razor}]
# CA2007 ConfigureAwait: ASP.NET Core and TUnit have no synchronization context, so
# ConfigureAwait(false) changes nothing and only adds noise.
dotnet_diagnostic.CA2007.severity = none

# MSBuild and solution files
[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break; nested list
# indentation follows the list marker width, not a fixed size.
trim_trailing_whitespace = false
indent_size = unset

[{justfile,*.just,*.just.example}]
# Recipe bodies use 4 spaces.
indent_size = unset

[*.sh]
indent_size = 2

[*.rego]
# opa fmt / conftest fmt indent with tabs.
indent_style = tab
indent_size = unset

[LICENSE]
# Upstream Apache-2.0 text, kept verbatim.
indent_style = unset
indent_size = unset
