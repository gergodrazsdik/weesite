<Project>
  <!-- Central package management: versions here, PackageReference without Version in the projects.
  Dependabot (nuget, T-0028) updates them. Microsoft.AspNetCore.* test packages follow the SDK in global.json. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.4" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Content">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <PackageVersion Include="NetVips.Native" Version="8.18.7" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup Label="Service defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
    <!-- Pinned (TUnit.Playwright only sets a minimum): the Chromium build CI and machines install
    follows this version (Playwright 1.64.1: chromium-1248). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
    <PackageVersion Include="TUnit.Playwright" Version="1.76.0" />
  </ItemGroup>
</Project>
