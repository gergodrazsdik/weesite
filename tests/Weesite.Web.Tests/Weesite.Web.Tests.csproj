<Project Sdk="Microsoft.NET.Sdk">

  <!-- TUnit runs on Microsoft.Testing.Platform: the test project is an executable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Weesite.Web\Weesite.Web.csproj" />
  </ItemGroup>

  <!-- Helpers shared by the test projects (F-0118). -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <Compile Include="..\Shared\Containers\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
