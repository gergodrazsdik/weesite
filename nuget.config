<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet settings for the repo, the same for CI and every machine.
  - Only nuget.org, for every package (no inherited sources, source mapping).
  - minPublishAgeHours (NuGet in the .NET 11 SDK): `dotnet package add` and `update` skip versions
    published less than 14 days ago, the repo's rule for new versions; floating versions fail
    restore (NU1020) rather than take one. Exact versions in Directory.Packages.props restore
    regardless, so a pin made on purpose still builds.
  - A cooldown delays a bad release; NuGetAudit (Directory.Build.props) finds known
    vulnerabilities. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" minPublishAgeHours="336" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
